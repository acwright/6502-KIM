000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 0
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $C000 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $C000             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $C003             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   KC Monitor — KIM-1-style keypad/LCD memory monitor
000000r 1               ; =============================================================================
000000r 1               ;   Cartridge ROM for the Keypad Card (KC).  Drives a 16x2 HD44780 LCD and a
000000r 1               ;   24-key keypad through a 65C21 PIA.  The cart overlays $C000-$FFFF; ROM
000000r 1               ;   (AT28C64, 8 KB) lives at $E000-$FFFF and the PIA registers are mirrored
000000r 1               ;   across the I/O window $C000-$DFFF.
000000r 1               ;
000000r 1               ;   This file implements:
000000r 1               ;     - Build scaffolding & KC-local PIA/LCD constants
000000r 1               ;     - LCD driver
000000r 1               ;     - PIA init & keypad input
000000r 1               ;     - Monitor state machine
000000r 1               ;     - Entry point, interrupt handlers & CPU vectors
000000r 1               ;     - ESC = break-to-monitor abort (handled in KeyIrq)
000000r 1               ;     - Wozmon-compatible serial monitor (concurrent with the keypad)
000000r 1               ; =============================================================================
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   KC PIA register map (65C21)
000000r 1               ; =============================================================================
000000r 1               ;   The PIA is mirrored across the I/O window $C000-$DFFF.  A0=RS0, A1=RS1.
000000r 1               ;     $C000  PORTA / DDRA  (selected by CRA bit 2)
000000r 1               ;     $C001  CRA
000000r 1               ;     $C002  PORTB / DDRB  (selected by CRB bit 2)
000000r 1               ;     $C003  CRB
000000r 1               ;
000000r 1               ;   Wiring:
000000r 1               ;     PA0-PA4 = keypad code        (input)
000000r 1               ;     PA5     = LCD RS             (output)
000000r 1               ;     PA6     = LCD R/W            (output)
000000r 1               ;     PA7     = LCD E              (output)
000000r 1               ;     PB0-PB7 = LCD data bus       (output)
000000r 1               ;     CA1     = keypad data-available
000000r 1               ;     CA2     = active-low OE of the 74C922 keypad encoder
000000r 1               
000000r 1               PORTA               := $C000             ; Port A data / DDRA (per CRA bit 2)
000000r 1               CRA                 := $C001             ; Control register A
000000r 1               PORTB               := $C002             ; Port B data / DDRB (per CRB bit 2)
000000r 1               CRB                 := $C003             ; Control register B
000000r 1               
000000r 1               ; Control-register bit 2 selects the data register (1) or the data
000000r 1               ; direction register (0) at the shared port address.
000000r 1               CR_DDR              = %00000000          ; access DDRx
000000r 1               CR_PORT             = %00000100          ; access PORTx data register
000000r 1               
000000r 1               ; Data direction for Port A: PA5/PA6/PA7 outputs (LCD control),
000000r 1               ; PA0-PA4 inputs (keypad code).
000000r 1               LCD_DDRA            = %11100000          ; $E0
000000r 1               
000000r 1               ; LCD control-line masks on Port A
000000r 1               LCD_RS              = %00100000          ; PA5 — register select (1=data, 0=cmd)
000000r 1               LCD_RW              = %01000000          ; PA6 — read/write (1=read, 0=write)
000000r 1               LCD_E               = %10000000          ; PA7 — enable strobe
000000r 1               
000000r 1               ; LCD busy flag (Port B DB7, valid when reading with RS=0/R/W=1)
000000r 1               LCD_BUSY            = %10000000
000000r 1               
000000r 1               ; -----------------------------------------------------------------------------
000000r 1               ;   Keypad (74C922 encoder via PIA Port A + CA1/CA2)
000000r 1               ; -----------------------------------------------------------------------------
000000r 1               ;   The encoder presents a 5-bit keycode on PA0-PA4 and raises CA1 (positive
000000r 1               ;   edge) when a key becomes available.  CA2 is driven low to enable the
000000r 1               ;   encoder's active-low output enable (OE).  Key entry is interrupt driven:
000000r 1               ;   the CA1 rising edge raises the CPU IRQ, and the handler (KeyIrq) reads the
000000r 1               ;   keycode at that instant — when the 74C922 outputs are guaranteed valid —
000000r 1               ;   so a read can never straddle a key transition the way polling at an
000000r 1               ;   arbitrary later time could.
000000r 1               ;
000000r 1               ;   CRA layout for the keypad:
000000r 1               ;     bit 7   CA1 active-edge flag (IRQF1) — set on key-available, read-only
000000r 1               ;     bit 5-3 110 = CA2 manual output low (enables 74C922 OE)
000000r 1               ;     bit 2   1   = access PORTA data register (not DDRA)
000000r 1               ;     bit 1   1   = CA1 active on the positive (rising) edge
000000r 1               ;     bit 0   1   = CA1 interrupt enabled
000000r 1               PIA_CA1_FLAG        = %10000000          ; CRA bit 7 — CA1 active-edge flag
000000r 1               PIA_CRA_KEYPAD      = %00110111          ; $37 — CA2 out low, CA1 +edge, IRQ ON, PORT
000000r 1               KEY_MASK            = %00011111          ; PA0-PA4 carry the keycode (0-23)
000000r 1               KEY_COUNT           = 24                  ; valid keycodes are $00-$17
000000r 1               
000000r 1               ; Named keycodes (used by the monitor dispatch)
000000r 1               KEY_LEFT            = $00
000000r 1               KEY_RIGHT           = $0B
000000r 1               KEY_ESC             = $10
000000r 1               KEY_INS             = $11
000000r 1               KEY_PGUP            = $12
000000r 1               KEY_A               = $13
000000r 1               KEY_UP              = $14
000000r 1               KEY_DEL             = $15
000000r 1               KEY_PGDN            = $16
000000r 1               KEY_B               = $17
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Monitor zero-page state
000000r 1               ; =============================================================================
000000r 1               ;   Lives in the free user zero page ($36-$FF).  CUR_ADDR is the address the
000000r 1               ;   monitor is inspecting/editing; it doubles as the (zp),y pointer for byte
000000r 1               ;   access and as the execute trampoline target.  MODE holds the INS edit
000000r 1               ;   flag; MON_TMP is scratch for the nibble-shift edits.
000000r 1               CUR_ADDR            := $40               ; 2 bytes — current address pointer
000000r 1               MODE                := $42               ; 1 byte  — INS edit-mode flag (0=off)
000000r 1               MON_TMP             := $43               ; 1 byte  — scratch for nibble edits
000000r 1               KEY_CODE            := $44               ; 1 byte  — last keycode latched by KeyIrq
000000r 1               KEY_READY           := $45               ; 1 byte  — nonzero when a key is pending
000000r 1               
000000r 1               MODE_INS            = $01                ; MODE value: insert/edit mode active
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Serial Wozmon zero-page state
000000r 1               ; =============================================================================
000000r 1               ;   A Wozmon-compatible serial monitor runs concurrently with the keypad
000000r 1               ;   monitor, sharing the same memory.  Incoming bytes are pushed into a
000000r 1               ;   256-byte RX ring by the IRQ handler and drained by the cooperative main
000000r 1               ;   loop into a Wozmon line parser.  The parser variables mirror the original
000000r 1               ;   Apple-1 Wozmon (XAML/XAMH, STL/STH, L/H, YSAV, MODE) but live in the free
000000r 1               ;   user zero page since $24-$2B are reserved by the Kernal here.  WMODE is
000000r 1               ;   kept distinct from the keypad MODE byte.
000000r 1               SER_RXHEAD          := $46               ; 1 byte  — RX ring write index (IRQ)
000000r 1               SER_RXTAIL          := $47               ; 1 byte  — RX ring read index (main loop)
000000r 1               XAML                := $48               ; 2 bytes — last "examined" address (lo/hi)
000000r 1               XAMH                := $49
000000r 1               STL                 := $4A               ; 2 bytes — current deposit address (lo/hi)
000000r 1               STH                 := $4B
000000r 1               L                   := $4C               ; 2 bytes — hex accumulator (lo/hi)
000000r 1               H                   := $4D
000000r 1               YSAV                := $4E               ; 1 byte  — saved index (hex-present test)
000000r 1               WMODE               := $4F               ; 1 byte  — Wozmon mode ($00=XAM, $74=STOR, $AE=BLOCK)
000000r 1               SER_IDX             := $50               ; 1 byte  — current line-buffer index
000000r 1               SER_DIRTY           := $51               ; 1 byte  — nonzero when a serial deposit changed memory
000000r 1               
000000r 1               ; The RX ring buffer (256 bytes, byte indices wrap naturally) and the Wozmon
000000r 1               ; line buffer share the low-RAM input region; neither is used by the keypad
000000r 1               ; monitor.
000000r 1               SER_RXBUF           := $0400             ; 256-byte serial RX ring buffer
000000r 1               SER_LINEBUF         := INPUT_BUFFER      ; $0200 — Wozmon line accumulation buffer
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   ROM
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .segment "ROM"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   CartReset — power-on entry point
000000r 1               ; =============================================================================
000000r 1               ;   RESET vectors here.  Resets the stack, runs KernalInit to bring up the
000000r 1               ;   Kernal RAM vectors and probe the base system, overrides the BRK vector so
000000r 1               ;   a BRK from executed user code returns cleanly instead of diving into the
000000r 1               ;   now-overlaid BIOS monitor, brings up the LCD and keypad PIA, seeds the
000000r 1               ;   monitor state, shows the splash screen, and waits for ESC before entering
000000r 1               ;   the monitor loop.
000000r 1               ;
000000r 1               ;   Key entry is interrupt driven, so after init it repoints IRQ_PTR at the
000000r 1               ;   local KeyIrq handler and enables interrupts (CLI) before showing the
000000r 1               ;   splash.  BRK is unaffected by the I flag; the BRK_PTR override below keeps
000000r 1               ;   a BRK in executed user code from entering the overlaid BIOS monitor.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               CartReset:
000000r 1  78             sei
000001r 1  A2 FF          ldx #$ff
000003r 1  9A             txs                           ; Reset the stack pointer (required by KernalInit)
000004r 1               
000004r 1  20 78 A0       jsr KernalInit                ; Init Kernal RAM vectors + probe base system
000007r 1                                               ; (clears decimal mode, leaves interrupts off)
000007r 1               
000007r 1                 ; Override the BRK vector: KernalInit points it at the BIOS monitor, which
000007r 1                 ; the cartridge has overlaid.  Route BRK to a local RTI handler instead.
000007r 1  A9 rr          lda #<BrkHandler
000009r 1  8D 02 03       sta BRK_PTR
00000Cr 1  A9 rr          lda #>BrkHandler
00000Er 1  8D 03 03       sta BRK_PTR + 1
000011r 1               
000011r 1                 ; Route the IRQ through our keypad handler.  KernalInit set IRQ_PTR to the
000011r 1                 ; Kernal's own IRQ service; the cart drives only the keypad, so take it over.
000011r 1  A9 rr          lda #<KeyIrq
000013r 1  8D 00 03       sta IRQ_PTR
000016r 1  A9 rr          lda #>KeyIrq
000018r 1  8D 01 03       sta IRQ_PTR + 1
00001Br 1               
00001Br 1  20 rr rr       jsr LcdInit                   ; Bring up the LCD (must precede PiaInit)
00001Er 1  20 rr rr       jsr PiaInit                   ; Configure keypad + enable CA1 IRQ, clear flag
000021r 1               
000021r 1  20 rr rr       jsr SerInit                   ; Bring up the serial card + Wozmon parser state
000024r 1               
000024r 1  64 45          stz KEY_READY                 ; no key pending yet
000026r 1               
000026r 1                 ; Seed monitor state: start at user RAM ($0800), edit mode off
000026r 1  A9 00          lda #<PROGRAM_START
000028r 1  85 40          sta CUR_ADDR
00002Ar 1  A9 08          lda #>PROGRAM_START
00002Cr 1  85 41          sta CUR_ADDR + 1
00002Er 1  64 42          stz MODE
000030r 1               
000030r 1  58             cli                           ; enable IRQs — keypad CA1 + serial RX drive input
000031r 1               
000031r 1                 ; LCD splash first — it must never depend on the serial terminal being
000031r 1                 ; connected.  (SerialChrout/our serial TX blocks on TDRE, which the R65C51
000031r 1                 ; gates on /CTS; with no terminal connected the serial banner would stall.)
000031r 1  20 rr rr       jsr ShowSplash                ; hold the splash until ESC starts the monitor
000034r 1               
000034r 1                 ; Serial startup banner + first Wozmon prompt.  Emitted through the
000034r 1                 ; non-blocking SerPutc path, so a missing/disconnected terminal just drops
000034r 1                 ; these bytes instead of hanging the keypad monitor.
000034r 1  A9 rr          lda #<SplashL1
000036r 1  85 02          sta STR_PTR
000038r 1  A9 rr          lda #>SplashL1
00003Ar 1  85 03          sta STR_PTR + 1
00003Cr 1  20 rr rr       jsr SerPrintStr               ; "KIM MONITOR v1.0"
00003Fr 1  20 rr rr       jsr SerPrompt                 ; CR/LF + "> "
000042r 1               
000042r 1               @WaitEsc:
000042r 1  20 rr rr       jsr KeyPoll                   ; drain & ignore keys (ESC is intercepted by
000045r 1  20 rr rr       jsr SerService                ; KeyIrq -> WarmStart -> MonitorLoop).  Keep the
000048r 1  64 51          stz SER_DIRTY                 ; serial monitor live, but do not disturb the
00004Ar 1  80 F6          bra @WaitEsc                  ; LCD splash with a RefreshDisplay yet.
00004Cr 1               
00004Cr 1               
00004Cr 1               ; =============================================================================
00004Cr 1               ;   MONITOR STATE MACHINE
00004Cr 1               ; =============================================================================
00004Cr 1               ;   A KIM-1-style memory monitor.  The display shows the current address and
00004Cr 1               ;   the byte stored there; the keypad navigates, edits, and executes.
00004Cr 1               ;
00004Cr 1               ;     LEFT / RIGHT   address -1 / +1
00004Cr 1               ;     PGUP / PGDN    address +$0100 / -$0100
00004Cr 1               ;     0-F            INS off: shift a hex nibble into the address (KIM-1 style)
00004Cr 1               ;                    INS on : shift a hex nibble into the byte at the address
00004Cr 1               ;     INS            toggle edit mode
00004Cr 1               ;     DEL            zero the byte at the address, cancel edit mode
00004Cr 1               ;     UP             execute via JSR (jmp (CUR_ADDR)); RTS returns to monitor
00004Cr 1               ;     ESC            break-to-monitor abort (handled in KeyIrq -> WarmStart)
00004Cr 1               ; =============================================================================
00004Cr 1               
00004Cr 1               ; -----------------------------------------------------------------------------
00004Cr 1               ;   WarmStart — break-to-monitor abort target
00004Cr 1               ; -----------------------------------------------------------------------------
00004Cr 1               ;   Entered by JMP from KeyIrq when an ESC arrives from EITHER source — the
00004Cr 1               ;   keypad ESC key or an ESC byte over serial — from anywhere, including a
00004Cr 1               ;   program launched with keypad UP or with the serial "R" command.  The
00004Cr 1               ;   interrupted stack frame is abandoned: ESC is a panic "return to the
00004Cr 1               ;   monitor" and does not restore the aborted caller.
00004Cr 1               ;
00004Cr 1               ;   Resets the stack pointer (the IRQ and whatever it interrupted are
00004Cr 1               ;   discarded), cancels any in-progress INS edit, flushes buffered serial
00004Cr 1               ;   input, re-enables interrupts (KeyIrq was entered with I set), repaints the
00004Cr 1               ;   keypad monitor (LCD) and re-arms the serial monitor with a fresh prompt,
00004Cr 1               ;   then re-enters the monitor loop.
00004Cr 1               ; -----------------------------------------------------------------------------
00004Cr 1               WarmStart:
00004Cr 1  A2 FF          ldx #$ff
00004Er 1  9A             txs                           ; discard the interrupted stack frame
00004Fr 1  64 42          stz MODE                      ; cancel any in-progress INS edit
000051r 1  A5 46          lda SER_RXHEAD                ; flush any buffered serial input (still inside
000053r 1  85 47          sta SER_RXTAIL                ;   the IRQ-masked window so KeyIrq can't race)
000055r 1  64 51          stz SER_DIRTY
000057r 1  58             cli                           ; KeyIrq left I set — re-enable IRQs
000058r 1  20 rr rr       jsr RefreshDisplay            ; repaint the keypad monitor (LCD)
00005Br 1  20 rr rr       jsr SerPrompt                 ; and re-arm the serial monitor (fresh prompt)
00005Er 1  4C rr rr       jmp MonitorLoop
000061r 1               
000061r 1               ; -----------------------------------------------------------------------------
000061r 1               ;   MonitorLoop — cooperative poll of both inputs
000061r 1               ; -----------------------------------------------------------------------------
000061r 1               ;   The keypad and the Wozmon serial monitor run concurrently from this one
000061r 1               ;   loop; neither input blocks.  A keypad press is dispatched and repaints the
000061r 1               ;   LCD.  Serial bytes are drained one at a time into the Wozmon line parser;
000061r 1               ;   when a serial line deposits into memory the SER_DIRTY flag triggers a
000061r 1               ;   refresh so the change shows on the LCD at the current address.
000061r 1               ; -----------------------------------------------------------------------------
000061r 1               MonitorLoop:
000061r 1  20 rr rr       jsr KeyPoll                   ; C=1 -> A = keycode (0-23)
000064r 1  90 06          bcc @Serial
000066r 1  20 rr rr       jsr Dispatch
000069r 1  20 rr rr       jsr RefreshDisplay
00006Cr 1               @Serial:
00006Cr 1  20 rr rr       jsr SerService                ; process up to one pending serial byte
00006Fr 1  A5 51          lda SER_DIRTY                 ; did a serial deposit change memory?
000071r 1  F0 EE          beq MonitorLoop
000073r 1  64 51          stz SER_DIRTY
000075r 1  20 rr rr       jsr RefreshDisplay            ; reflect the serial deposit on the LCD
000078r 1  80 E7          bra MonitorLoop
00007Ar 1               
00007Ar 1               ; -----------------------------------------------------------------------------
00007Ar 1               ;   Dispatch — act on a keycode
00007Ar 1               ;   In: A = keycode (0-23)
00007Ar 1               ;   Modifies: A, X, Y
00007Ar 1               ; -----------------------------------------------------------------------------
00007Ar 1               Dispatch:
00007Ar 1  C9 00          cmp #KEY_LEFT
00007Cr 1  F0 28          beq DoLeft
00007Er 1  C9 0B          cmp #KEY_RIGHT
000080r 1  F0 2D          beq DoRight
000082r 1  C9 12          cmp #KEY_PGUP
000084r 1  F0 30          beq DoPgUp
000086r 1  C9 16          cmp #KEY_PGDN
000088r 1  F0 2F          beq DoPgDn
00008Ar 1  C9 11          cmp #KEY_INS
00008Cr 1  F0 2E          beq DoIns
00008Er 1  C9 15          cmp #KEY_DEL
000090r 1  F0 31          beq DoDel
000092r 1  C9 14          cmp #KEY_UP
000094r 1  F0 36          beq DoUp
000096r 1  20 rr rr       jsr KeyToHex                  ; hex digit?  C=1 -> A = nibble (0-15)
000099r 1  90 0A          bcc @Done                     ; non-hex key: ignore
00009Br 1  A6 42          ldx MODE
00009Dr 1  D0 03          bne @EditData                 ; INS on: edit the byte at the address
00009Fr 1  4C rr rr       jmp ShiftAddrNibble           ; INS off: shift the nibble into the address
0000A2r 1               @EditData:
0000A2r 1  4C rr rr       jmp ShiftDataNibble
0000A5r 1               @Done:
0000A5r 1  60             rts
0000A6r 1               
0000A6r 1               ; --- Navigation -------------------------------------------------------------
0000A6r 1               DoLeft:
0000A6r 1  A5 40          lda CUR_ADDR
0000A8r 1  D0 02          bne @NoBorrow
0000AAr 1  C6 41          dec CUR_ADDR + 1
0000ACr 1               @NoBorrow:
0000ACr 1  C6 40          dec CUR_ADDR
0000AEr 1  60             rts
0000AFr 1               
0000AFr 1               DoRight:
0000AFr 1  E6 40          inc CUR_ADDR
0000B1r 1  D0 02          bne @Done
0000B3r 1  E6 41          inc CUR_ADDR + 1
0000B5r 1               @Done:
0000B5r 1  60             rts
0000B6r 1               
0000B6r 1               DoPgUp:
0000B6r 1  E6 41          inc CUR_ADDR + 1              ; +$0100
0000B8r 1  60             rts
0000B9r 1               
0000B9r 1               DoPgDn:
0000B9r 1  C6 41          dec CUR_ADDR + 1              ; -$0100
0000BBr 1  60             rts
0000BCr 1               
0000BCr 1               ; --- Mode / edit ------------------------------------------------------------
0000BCr 1               DoIns:
0000BCr 1  A5 42          lda MODE
0000BEr 1  49 01          eor #MODE_INS                 ; toggle the edit-mode flag
0000C0r 1  85 42          sta MODE
0000C2r 1  60             rts
0000C3r 1               
0000C3r 1               DoDel:
0000C3r 1  A9 00          lda #$00
0000C5r 1  A0 00          ldy #$00
0000C7r 1  91 40          sta (CUR_ADDR),y              ; zero the byte at the address
0000C9r 1  64 42          stz MODE                      ; cancel edit mode
0000CBr 1  60             rts
0000CCr 1               
0000CCr 1               ; --- Execute ----------------------------------------------------------------
0000CCr 1               DoUp:
0000CCr 1  20 rr rr       jsr CallUser                  ; jmp (CUR_ADDR); user RTS returns here
0000CFr 1  60             rts
0000D0r 1               
0000D0r 1               CallUser:
0000D0r 1  6C 40 00       jmp (CUR_ADDR)
0000D3r 1               
0000D3r 1               ; -----------------------------------------------------------------------------
0000D3r 1               ;   ShiftAddrNibble — shift one hex nibble into CUR_ADDR (KIM-1 style)
0000D3r 1               ;   In: A = nibble (low 4 bits)
0000D3r 1               ;   Modifies: A, X
0000D3r 1               ; -----------------------------------------------------------------------------
0000D3r 1               ShiftAddrNibble:
0000D3r 1  48             pha
0000D4r 1  A2 04          ldx #$04                      ; CUR_ADDR <<= 4 (16-bit)
0000D6r 1               @Shift:
0000D6r 1  06 40          asl CUR_ADDR
0000D8r 1  26 41          rol CUR_ADDR + 1
0000DAr 1  CA             dex
0000DBr 1  D0 F9          bne @Shift
0000DDr 1  68             pla
0000DEr 1  05 40          ora CUR_ADDR                  ; OR the new nibble into the low byte
0000E0r 1  85 40          sta CUR_ADDR
0000E2r 1  60             rts
0000E3r 1               
0000E3r 1               ; -----------------------------------------------------------------------------
0000E3r 1               ;   ShiftDataNibble — shift one hex nibble into the byte at CUR_ADDR
0000E3r 1               ;   In: A = nibble (low 4 bits)
0000E3r 1               ;   Modifies: A, Y
0000E3r 1               ; -----------------------------------------------------------------------------
0000E3r 1               ShiftDataNibble:
0000E3r 1  85 43          sta MON_TMP
0000E5r 1  A0 00          ldy #$00
0000E7r 1  B1 40          lda (CUR_ADDR),y
0000E9r 1  0A             asl a                         ; old byte <<= 4
0000EAr 1  0A             asl a
0000EBr 1  0A             asl a
0000ECr 1  0A             asl a
0000EDr 1  05 43          ora MON_TMP                   ; OR in the new nibble
0000EFr 1  91 40          sta (CUR_ADDR),y
0000F1r 1  60             rts
0000F2r 1               
0000F2r 1               ; -----------------------------------------------------------------------------
0000F2r 1               ;   RefreshDisplay — render the monitor screen
0000F2r 1               ;   Line 1: ---$XXXX: $XX---   (address and the byte stored there)
0000F2r 1               ;   Line 2: 16 dashes, or a centered "INS" indicator when editing
0000F2r 1               ;   Modifies: A, X, Y
0000F2r 1               ; -----------------------------------------------------------------------------
0000F2r 1               RefreshDisplay:
0000F2r 1  A2 00          ldx #$00
0000F4r 1  A0 00          ldy #$00
0000F6r 1  20 rr rr       jsr LcdSetPos                 ; line 1, column 0
0000F9r 1               
0000F9r 1  A2 03          ldx #$03                      ; "---"
0000FBr 1  20 rr rr       jsr PrintDashN
0000FEr 1  A9 24          lda #'$'
000100r 1  20 rr rr       jsr LcdData
000103r 1  A5 41          lda CUR_ADDR + 1              ; address (high byte first)
000105r 1  20 rr rr       jsr PrintHexByte
000108r 1  A5 40          lda CUR_ADDR
00010Ar 1  20 rr rr       jsr PrintHexByte
00010Dr 1  A9 3A          lda #':'
00010Fr 1  20 rr rr       jsr LcdData
000112r 1  A9 20          lda #CHAR_SPACE
000114r 1  20 rr rr       jsr LcdData
000117r 1  A9 24          lda #'$'
000119r 1  20 rr rr       jsr LcdData
00011Cr 1  A0 00          ldy #$00                      ; byte at the current address
00011Er 1  B1 40          lda (CUR_ADDR),y
000120r 1  20 rr rr       jsr PrintHexByte
000123r 1  A2 03          ldx #$03                      ; "---"
000125r 1  20 rr rr       jsr PrintDashN
000128r 1               
000128r 1  A2 00          ldx #$00
00012Ar 1  A0 01          ldy #$01
00012Cr 1  20 rr rr       jsr LcdSetPos                 ; line 2, column 0
00012Fr 1  A5 42          lda MODE
000131r 1  D0 06          bne @Ins
000133r 1  A2 10          ldx #$10                      ; 16 dashes
000135r 1  20 rr rr       jsr PrintDashN
000138r 1  60             rts
000139r 1               @Ins:
000139r 1  A2 06          ldx #$06                      ; 6 dashes + "INS" + 7 dashes = 16
00013Br 1  20 rr rr       jsr PrintDashN
00013Er 1  A9 49          lda #'I'
000140r 1  20 rr rr       jsr LcdData
000143r 1  A9 4E          lda #'N'
000145r 1  20 rr rr       jsr LcdData
000148r 1  A9 53          lda #'S'
00014Ar 1  20 rr rr       jsr LcdData
00014Dr 1  A2 07          ldx #$07
00014Fr 1  20 rr rr       jsr PrintDashN
000152r 1  60             rts
000153r 1               
000153r 1               ; -----------------------------------------------------------------------------
000153r 1               ;   PrintDashN — print X dash characters
000153r 1               ;   In: X = count
000153r 1               ;   Modifies: A, X, Y
000153r 1               ; -----------------------------------------------------------------------------
000153r 1               PrintDashN:
000153r 1               @Loop:
000153r 1  E0 00          cpx #$00
000155r 1  F0 0A          beq @Done
000157r 1  DA             phx                           ; LcdData (via LcdDelay) clobbers X/Y
000158r 1  A9 2D          lda #'-'
00015Ar 1  20 rr rr       jsr LcdData
00015Dr 1  FA             plx
00015Er 1  CA             dex
00015Fr 1  80 F2          bra @Loop
000161r 1               @Done:
000161r 1  60             rts
000162r 1               
000162r 1               ; -----------------------------------------------------------------------------
000162r 1               ;   ShowSplash — clear the display and render the splash screen
000162r 1               ;   Modifies: A, X, Y
000162r 1               ; -----------------------------------------------------------------------------
000162r 1               ShowSplash:
000162r 1  20 rr rr       jsr LcdClear
000165r 1  A2 00          ldx #$00
000167r 1  A0 00          ldy #$00
000169r 1  20 rr rr       jsr LcdSetPos
00016Cr 1  A9 rr          lda #<SplashL1
00016Er 1  85 02          sta STR_PTR
000170r 1  A9 rr          lda #>SplashL1
000172r 1  85 03          sta STR_PTR + 1
000174r 1  20 rr rr       jsr LcdPrintStr
000177r 1  A2 00          ldx #$00
000179r 1  A0 01          ldy #$01
00017Br 1  20 rr rr       jsr LcdSetPos
00017Er 1  A9 rr          lda #<SplashL2
000180r 1  85 02          sta STR_PTR
000182r 1  A9 rr          lda #>SplashL2
000184r 1  85 03          sta STR_PTR + 1
000186r 1  20 rr rr       jsr LcdPrintStr
000189r 1  60             rts
00018Ar 1               
00018Ar 1               
00018Ar 1               ; =============================================================================
00018Ar 1               ;   LCD DRIVER
00018Ar 1               ; =============================================================================
00018Ar 1               ;   HD44780-compatible 16x2 display in 8-bit mode.  Port B carries the data
00018Ar 1               ;   bus; Port A carries RS/R-W/E on PA5/PA6/PA7.  Command/data writes use
00018Ar 1               ;   timed software delays instead of busy-flag polling (the R/W read-back
00018Ar 1               ;   path is not relied upon).
00018Ar 1               ; =============================================================================
00018Ar 1               
00018Ar 1               ; -----------------------------------------------------------------------------
00018Ar 1               ;   LcdDelay — short software busy delay (~2 ms at a few MHz)
00018Ar 1               ; -----------------------------------------------------------------------------
00018Ar 1               ;   Used in place of busy-flag polling so the driver does not depend on the
00018Ar 1               ;   LCD R/W read-back path (PA6) working.  Generous enough to cover a normal
00018Ar 1               ;   instruction's execution time (~37 us); callers add extra delay for the
00018Ar 1               ;   slow clear/home commands.
00018Ar 1               ;   Modifies: A, X, Y
00018Ar 1               ; -----------------------------------------------------------------------------
00018Ar 1               LcdDelay:
00018Ar 1  A2 10          ldx #$10
00018Cr 1               @Outer:
00018Cr 1  A0 00          ldy #$00
00018Er 1               @Inner:
00018Er 1  88             dey
00018Fr 1  D0 FD          bne @Inner
000191r 1  CA             dex
000192r 1  D0 F8          bne @Outer
000194r 1  60             rts
000195r 1               
000195r 1               ; -----------------------------------------------------------------------------
000195r 1               ;   LcdLongDelay — generous software delay for the power-on init ritual
000195r 1               ; -----------------------------------------------------------------------------
000195r 1               ;   Covers the HD44780 power-on timing (>15 ms first delay, >4.1 ms / >100 us
000195r 1               ;   between the function-set writes).  Self-contained — does not depend on
000195r 1               ;   KernalInit / SysDelay (and therefore not on HW_PRESENT / the VIA timer).
000195r 1               ;   ~325k cycles (≈325 ms @1 MHz, ≈65 ms @5 MHz) — deliberately overkill.
000195r 1               ;   Modifies: A, X, Y
000195r 1               ; -----------------------------------------------------------------------------
000195r 1               LcdLongDelay:
000195r 1  A2 FF          ldx #$FF
000197r 1               @Outer:
000197r 1  A0 FF          ldy #$FF
000199r 1               @Inner:
000199r 1  88             dey
00019Ar 1  D0 FD          bne @Inner
00019Cr 1  CA             dex
00019Dr 1  D0 F8          bne @Outer
00019Fr 1  60             rts
0001A0r 1               
0001A0r 1               ; -----------------------------------------------------------------------------
0001A0r 1               ;   LcdStrobe — pulse E high then low (data already on Port B, RS/R-W in A)
0001A0r 1               ; -----------------------------------------------------------------------------
0001A0r 1               ;   In: A = Port A control value with E low (RS/R-W set, LCD_E clear)
0001A0r 1               ;   Modifies: A
0001A0r 1               ; -----------------------------------------------------------------------------
0001A0r 1               LcdStrobe:
0001A0r 1  8D 00 C0       sta PORTA                     ; control lines, E low
0001A3r 1  09 80          ora #LCD_E
0001A5r 1  8D 00 C0       sta PORTA                     ; E high
0001A8r 1  29 7F          and #<~LCD_E
0001AAr 1  8D 00 C0       sta PORTA                     ; E low — LCD latches on falling edge
0001ADr 1  60             rts
0001AEr 1               
0001AEr 1               ; -----------------------------------------------------------------------------
0001AEr 1               ;   LcdCmd — write a command byte (RS=0)
0001AEr 1               ;   In: A = command
0001AEr 1               ;   Modifies: A, X, Y
0001AEr 1               ; -----------------------------------------------------------------------------
0001AEr 1               LcdCmd:
0001AEr 1  8D 02 C0       sta PORTB                     ; command byte on the data bus
0001B1r 1  A9 00          lda #$00                      ; RS=0, R/W=0, E=0
0001B3r 1  20 rr rr       jsr LcdStrobe
0001B6r 1  20 rr rr       jsr LcdDelay
0001B9r 1  60             rts
0001BAr 1               
0001BAr 1               ; -----------------------------------------------------------------------------
0001BAr 1               ;   LcdData — write a data byte (RS=1)
0001BAr 1               ;   In: A = data
0001BAr 1               ;   Modifies: A, X, Y
0001BAr 1               ; -----------------------------------------------------------------------------
0001BAr 1               LcdData:
0001BAr 1  8D 02 C0       sta PORTB                     ; data byte on the data bus
0001BDr 1  A9 20          lda #LCD_RS                   ; RS=1, R/W=0, E=0
0001BFr 1  20 rr rr       jsr LcdStrobe
0001C2r 1  20 rr rr       jsr LcdDelay
0001C5r 1  60             rts
0001C6r 1               
0001C6r 1               ; -----------------------------------------------------------------------------
0001C6r 1               ;   LcdCmdRaw — write a command byte (alias of LcdCmd)
0001C6r 1               ;   Retained for the power-on function-set sequence which adds its own
0001C6r 1               ;   longer inter-command delays via LcdLongDelay.
0001C6r 1               ;   In: A = command
0001C6r 1               ;   Modifies: A, X, Y
0001C6r 1               ; -----------------------------------------------------------------------------
0001C6r 1               LcdCmdRaw = LcdCmd
0001C6r 1               
0001C6r 1               ; -----------------------------------------------------------------------------
0001C6r 1               ;   LcdInit — power-on initialization sequence
0001C6r 1               ;   Configures the PIA ports the LCD needs, then runs the HD44780 8-bit
0001C6r 1               ;   init: function set (2-line, 5x8), display on, clear, entry-mode increment.
0001C6r 1               ;   Uses software delays only — no KernalInit / SysDelay dependency.
0001C6r 1               ;   Modifies: A, X, Y
0001C6r 1               ; -----------------------------------------------------------------------------
0001C6r 1               LcdInit:
0001C6r 1                 ; Port A: PA5-7 outputs (LCD control), PA0-4 inputs (keypad code)
0001C6r 1  A9 00          lda #CR_DDR
0001C8r 1  8D 01 C0       sta CRA
0001CBr 1  A9 E0          lda #LCD_DDRA
0001CDr 1  8D 00 C0       sta PORTA                     ; (DDRA) = $E0
0001D0r 1  A9 04          lda #CR_PORT
0001D2r 1  8D 01 C0       sta CRA
0001D5r 1  A9 00          lda #$00
0001D7r 1  8D 00 C0       sta PORTA                     ; control lines low (RS=0, R/W=0, E=0)
0001DAr 1               
0001DAr 1                 ; Port B: all outputs (LCD data bus)
0001DAr 1  A9 00          lda #CR_DDR
0001DCr 1  8D 03 C0       sta CRB
0001DFr 1  A9 FF          lda #$FF
0001E1r 1  8D 02 C0       sta PORTB                     ; (DDRB) all outputs
0001E4r 1  A9 04          lda #CR_PORT
0001E6r 1  8D 03 C0       sta CRB
0001E9r 1               
0001E9r 1                 ; Power-on settle: > 15 ms
0001E9r 1  20 rr rr       jsr LcdLongDelay
0001ECr 1               
0001ECr 1                 ; Function set x3 with long inter-command delays (HD44780 reset ritual)
0001ECr 1  A9 30          lda #$30
0001EEr 1  20 rr rr       jsr LcdCmdRaw
0001F1r 1  20 rr rr       jsr LcdLongDelay              ; > 4.1 ms
0001F4r 1  A9 30          lda #$30
0001F6r 1  20 rr rr       jsr LcdCmdRaw
0001F9r 1  20 rr rr       jsr LcdLongDelay              ; > 100 us
0001FCr 1  A9 30          lda #$30
0001FEr 1  20 rr rr       jsr LcdCmdRaw
000201r 1  20 rr rr       jsr LcdLongDelay
000204r 1               
000204r 1                 ; Remaining configuration commands (each followed by LcdDelay)
000204r 1  A9 38          lda #$38                      ; function set: 8-bit, 2-line, 5x8 font
000206r 1  20 rr rr       jsr LcdCmd
000209r 1  A9 08          lda #$08                      ; display off
00020Br 1  20 rr rr       jsr LcdCmd
00020Er 1  A9 01          lda #$01                      ; clear display
000210r 1  20 rr rr       jsr LcdCmd
000213r 1  20 rr rr       jsr LcdLongDelay              ; clear is slow (~1.5 ms) — extra settle
000216r 1  A9 06          lda #$06                      ; entry mode: increment, no display shift
000218r 1  20 rr rr       jsr LcdCmd
00021Br 1  A9 0C          lda #$0C                      ; display on, cursor off, blink off
00021Dr 1  20 rr rr       jsr LcdCmd
000220r 1  60             rts
000221r 1               
000221r 1               ; -----------------------------------------------------------------------------
000221r 1               ;   LcdClear — clear the display and home the cursor
000221r 1               ;   Modifies: A, X
000221r 1               ; -----------------------------------------------------------------------------
000221r 1               LcdClear:
000221r 1  A9 01          lda #$01
000223r 1  20 rr rr       jsr LcdCmd
000226r 1  60             rts
000227r 1               
000227r 1               ; -----------------------------------------------------------------------------
000227r 1               ;   LcdSetPos — move the cursor to (column, row)
000227r 1               ;   In: X = column (0-15), Y = row (0-1)
000227r 1               ;   Modifies: A, X
000227r 1               ; -----------------------------------------------------------------------------
000227r 1               LcdSetPos:
000227r 1  8A             txa
000228r 1  C0 00          cpy #$00
00022Ar 1  F0 03          beq @Row1
00022Cr 1  18             clc
00022Dr 1  69 40          adc #$40                      ; row 2 DDRAM base offset
00022Fr 1               @Row1:
00022Fr 1  09 80          ora #$80                      ; "Set DDRAM address" command
000231r 1  20 rr rr       jsr LcdCmd
000234r 1  60             rts
000235r 1               
000235r 1               ; -----------------------------------------------------------------------------
000235r 1               ;   LcdPrintStr — print a null-terminated string
000235r 1               ;   In: STR_PTR ($02-$03) = pointer to string
000235r 1               ;   Modifies: A, X, Y
000235r 1               ; -----------------------------------------------------------------------------
000235r 1               LcdPrintStr:
000235r 1  A0 00          ldy #$00
000237r 1               @Loop:
000237r 1  B1 02          lda (STR_PTR),y
000239r 1  F0 08          beq @Done                     ; null terminator
00023Br 1  5A             phy                           ; LcdData (via delays) clobbers Y
00023Cr 1  20 rr rr       jsr LcdData
00023Fr 1  7A             ply
000240r 1  C8             iny
000241r 1  D0 F4          bne @Loop                     ; max 256 chars per call
000243r 1               @Done:
000243r 1  60             rts
000244r 1               
000244r 1               ; -----------------------------------------------------------------------------
000244r 1               ;   PrintHexNib — print the low nibble of A as a hex digit
000244r 1               ;   In: A = value (low nibble used)
000244r 1               ;   Modifies: A, X
000244r 1               ; -----------------------------------------------------------------------------
000244r 1               PrintHexNib:
000244r 1  29 0F          and #$0F
000246r 1  C9 0A          cmp #$0A
000248r 1  90 04          bcc @Digit
00024Ar 1  69 36          adc #$36                      ; C=1: 10..15 + $37 -> 'A'..'F'
00024Cr 1  D0 02          bne @Send                     ; result always nonzero
00024Er 1               @Digit:
00024Er 1  69 30          adc #$30                      ; C=0: 0..9 + $30 -> '0'..'9'
000250r 1               @Send:
000250r 1  20 rr rr       jsr LcdData
000253r 1  60             rts
000254r 1               
000254r 1               ; -----------------------------------------------------------------------------
000254r 1               ;   PrintHexByte — print A as two hex digits
000254r 1               ;   In: A = byte
000254r 1               ;   Modifies: A, X
000254r 1               ; -----------------------------------------------------------------------------
000254r 1               PrintHexByte:
000254r 1  48             pha
000255r 1  4A             lsr a
000256r 1  4A             lsr a
000257r 1  4A             lsr a
000258r 1  4A             lsr a
000259r 1  20 rr rr       jsr PrintHexNib               ; high nibble
00025Cr 1  68             pla
00025Dr 1  20 rr rr       jsr PrintHexNib               ; low nibble
000260r 1  60             rts
000261r 1               
000261r 1               ; -----------------------------------------------------------------------------
000261r 1               ;   PrintHexWord — print a 16-bit value as four hex digits (high byte first)
000261r 1               ;   In: X = high byte, A = low byte
000261r 1               ;   Modifies: A, X
000261r 1               ; -----------------------------------------------------------------------------
000261r 1               PrintHexWord:
000261r 1  48             pha
000262r 1  8A             txa
000263r 1  20 rr rr       jsr PrintHexByte              ; high byte
000266r 1  68             pla
000267r 1  20 rr rr       jsr PrintHexByte              ; low byte
00026Ar 1  60             rts
00026Br 1               
00026Br 1               
00026Br 1               ; =============================================================================
00026Br 1               ;   KEYPAD DRIVER
00026Br 1               ; =============================================================================
00026Br 1               ;   The 74C922 keypad encoder drives PA0-PA4 with a 5-bit keycode and pulses
00026Br 1               ;   CA1 (positive edge) when a key becomes available.  CA2 is held low to
00026Br 1               ;   enable the encoder's active-low output enable.  Key entry is interrupt
00026Br 1               ;   driven: the CA1 edge fires KeyIrq, which latches the keycode into a small
00026Br 1               ;   mailbox (KEY_CODE/KEY_READY) that the monitor loop drains via KeyWait.
00026Br 1               ; =============================================================================
00026Br 1               
00026Br 1               ; -----------------------------------------------------------------------------
00026Br 1               ;   PiaInit — configure the PIA for keypad input (and Port B for LCD data)
00026Br 1               ; -----------------------------------------------------------------------------
00026Br 1               ;   Sets DDRA so PA5-7 are outputs (LCD control) and PA0-4 inputs (keycode),
00026Br 1               ;   DDRB all outputs (LCD data bus), then writes the keypad CRA value which
00026Br 1               ;   enables the 74C922 (CA2 low) and arms CA1 on the positive edge with its
00026Br 1               ;   interrupt ENABLED.  The CPU IRQ must stay masked until the caller is
00026Br 1               ;   ready — CartReset CLIs only after this returns.  Reads PORTA once to clear
00026Br 1               ;   any stale CA1 flag.  Must be called AFTER LcdInit (leaves CRA on PORT).
00026Br 1               ;   Modifies: A
00026Br 1               ; -----------------------------------------------------------------------------
00026Br 1               PiaInit:
00026Br 1                 ; Port A direction: PA5-7 outputs, PA0-4 inputs
00026Br 1  A9 00          lda #CR_DDR
00026Dr 1  8D 01 C0       sta CRA
000270r 1  A9 E0          lda #LCD_DDRA                 ; $E0
000272r 1  8D 00 C0       sta PORTA                     ; (DDRA)
000275r 1               
000275r 1                 ; Port B direction: all outputs (LCD data bus)
000275r 1  A9 00          lda #CR_DDR
000277r 1  8D 03 C0       sta CRB
00027Ar 1  A9 FF          lda #$FF
00027Cr 1  8D 02 C0       sta PORTB                     ; (DDRB)
00027Fr 1  A9 04          lda #CR_PORT
000281r 1  8D 03 C0       sta CRB                       ; select PORTB data register
000284r 1               
000284r 1                 ; Port A control: CA2 manual output low (74C922 OE), CA1 positive edge,
000284r 1                 ; CA1 IRQ enabled, PORTA data register selected
000284r 1  A9 37          lda #PIA_CRA_KEYPAD           ; $37
000286r 1  8D 01 C0       sta CRA
000289r 1               
000289r 1  AD 00 C0       lda PORTA                     ; clear any pending CA1 flag
00028Cr 1  60             rts
00028Dr 1               
00028Dr 1               ; -----------------------------------------------------------------------------
00028Dr 1               ;   KeyIrq — CA1 (keypad data-available) interrupt handler
00028Dr 1               ; -----------------------------------------------------------------------------
00028Dr 1               ;   Installed in IRQ_PTR by CartReset and reached through the IRQ vector
00028Dr 1               ;   trampoline (jmp (IRQ_PTR)).  Because the cartridge owns the IRQ, this
00028Dr 1               ;   handler also dispatches BRK (which shares the vector) to BRK_PTR so
00028Dr 1               ;   executed user code keeps its clean-return behaviour.
00028Dr 1               ;
00028Dr 1               ;   The IRQ has two sources sharing the line: the R65C51 serial RX
00028Dr 1               ;   and the keypad CA1 edge.  Serial is serviced first so a fast host stream
00028Dr 1               ;   is never dropped while a key is also pending: if SC_STATUS shows RDRF, the
00028Dr 1               ;   byte is read; an ESC byte triggers a break-to-monitor abort (WarmStart),
00028Dr 1               ;   any other byte is pushed into the SER_RXBUF ring.  Then, on a keypad CA1
00028Dr 1               ;   edge it reads PORTA *once*, right at the data-available edge where the
00028Dr 1               ;   74C922 outputs are valid, masks the 5-bit keycode, rejects out-of-range
00028Dr 1               ;   phantom codes, and either aborts on the ESC key or stores the keycode in
00028Dr 1               ;   the KEY_CODE/KEY_READY mailbox.  Reading PORTA clears the CA1 flag.
00028Dr 1               ;   Modifies: nothing visible (saves/restores A and X)
00028Dr 1               ; -----------------------------------------------------------------------------
00028Dr 1               KeyIrq:
00028Dr 1  48             pha
00028Er 1  DA             phx
00028Fr 1  BA             tsx
000290r 1  BD 03 01       lda $0103,x                   ; stacked processor status (P)
000293r 1  29 10          and #$10                      ; B flag set -> this was a BRK, not an IRQ
000295r 1  D0 34          bne @Brk
000297r 1               
000297r 1                 ; Two sources share the CPU /IRQ line: the keypad PIA (CA1 edge) and the
000297r 1                 ; R65C51 ACIA (serial RX).  Both are serviced every entry, and the loop
000297r 1                 ; below keeps draining until neither has work pending — this is what keeps a
000297r 1                 ; break-to-monitor ESC reliable from *either* source while a launched program
000297r 1                 ; is running (the cooperative main loop, and thus the SerFeed parser, is
000297r 1                 ; suspended then, so ESC must be caught here in the ISR).  The keypad is
000297r 1                 ; checked first because that path is the proven one; the serial
000297r 1                 ; drain loop guarantees a serial ESC can never be stranded behind an ACIA
000297r 1                 ; receive overrun.
000297r 1               @Scan:
000297r 1                 ; --- Keypad CA1 source ----------------------------------------------------
000297r 1  AD 01 C0       lda CRA
00029Ar 1  29 80          and #PIA_CA1_FLAG             ; keypad data-available?
00029Cr 1  F0 13          beq @Serial                   ; no keypad edge — go drain the serial card
00029Er 1  AD 00 C0       lda PORTA                     ; latch keycode (also clears the CA1 flag)
0002A1r 1  29 1F          and #KEY_MASK                 ; keep PA0-4 (0-31)
0002A3r 1  C9 10          cmp #KEY_ESC                  ; ESC is a break-to-monitor abort
0002A5r 1  F0 29          beq @Esc                      ; -> WarmStart, never reaches the mailbox
0002A7r 1  C9 18          cmp #KEY_COUNT
0002A9r 1  B0 06          bcs @Serial                   ; phantom code >= 24 — discard, still drain SC
0002ABr 1  85 44          sta KEY_CODE                  ; mailbox: keycode
0002ADr 1  A9 01          lda #$01
0002AFr 1  85 45          sta KEY_READY                 ; signal the monitor loop
0002B1r 1               
0002B1r 1                 ; --- Serial RX source (R65C51 ACIA) ---------------------------------------
0002B1r 1               @Serial:
0002B1r 1  AD 01 90       lda SC_STATUS                 ; reading status also clears the ACIA IRQ flag
0002B4r 1  29 08          and #SC_STATUS_RDRF           ; RX data register full?
0002B6r 1  F0 10          beq @Exit                     ; nothing buffered in the ACIA — done
0002B8r 1  AD 00 90       lda SC_DATA                   ; read it (clears RDRF / the overrun flag)
0002BBr 1  C9 1B          cmp #CHAR_ESC                 ; serial ESC is a break-to-monitor abort, just
0002BDr 1  F0 11          beq @Esc                      ;   like the keypad ESC key -> WarmStart
0002BFr 1  A6 46          ldx SER_RXHEAD
0002C1r 1  9D 00 04       sta SER_RXBUF,x               ; otherwise push the byte into the RX ring
0002C4r 1  E6 46          inc SER_RXHEAD                ; byte index wraps naturally at 256
0002C6r 1  80 CF          bra @Scan                     ; got a byte — re-scan both sources (drains the
0002C8r 1                                               ;   ACIA fully so a queued ESC is never missed)
0002C8r 1               @Exit:
0002C8r 1  FA             plx
0002C9r 1  68             pla
0002CAr 1  40             rti
0002CBr 1               @Brk:
0002CBr 1  FA             plx                           ; restore regs; leave P/PCL/PCH on the stack
0002CCr 1  68             pla
0002CDr 1  6C 02 03       jmp (BRK_PTR)                 ; BrkHandler RTIs back to the user code
0002D0r 1               @Esc:
0002D0r 1  4C rr rr       jmp WarmStart                 ; abandon the interrupted frame, re-enter monitor
0002D3r 1               
0002D3r 1               ; -----------------------------------------------------------------------------
0002D3r 1               ;   KeyPoll — non-blocking keypad read (drains the KeyIrq mailbox)
0002D3r 1               ;   Out: C=1 -> A = keycode (0-23);  C=0 -> no key pending (A undefined)
0002D3r 1               ;   Modifies: A
0002D3r 1               ; -----------------------------------------------------------------------------
0002D3r 1               KeyPoll:
0002D3r 1  A5 45          lda KEY_READY
0002D5r 1  F0 08          beq @None                     ; nothing latched
0002D7r 1  78             sei                           ; grab the mailbox atomically vs KeyIrq
0002D8r 1  A5 44          lda KEY_CODE
0002DAr 1  64 45          stz KEY_READY
0002DCr 1  58             cli
0002DDr 1  38             sec                           ; C=1: key available
0002DEr 1  60             rts
0002DFr 1               @None:
0002DFr 1  18             clc                           ; C=0: no key
0002E0r 1  60             rts
0002E1r 1               
0002E1r 1               ; -----------------------------------------------------------------------------
0002E1r 1               ;   KeyWait — block until a key is available
0002E1r 1               ;   Out: A = keycode (0-23)
0002E1r 1               ;   Modifies: A
0002E1r 1               ; -----------------------------------------------------------------------------
0002E1r 1               KeyWait:
0002E1r 1  20 rr rr       jsr KeyPoll
0002E4r 1  90 FB          bcc KeyWait
0002E6r 1  60             rts
0002E7r 1               
0002E7r 1               ; -----------------------------------------------------------------------------
0002E7r 1               ;   KeyToSym — translate a keycode to a printable LCD symbol
0002E7r 1               ;   In:  A = keycode (0-23)
0002E7r 1               ;   Out: A = display character
0002E7r 1               ;   Modifies: A, X
0002E7r 1               ; -----------------------------------------------------------------------------
0002E7r 1               KeyToSym:
0002E7r 1  AA             tax
0002E8r 1  BD rr rr       lda KeySymTable,x
0002EBr 1  60             rts
0002ECr 1               
0002ECr 1               
0002ECr 1               ; -----------------------------------------------------------------------------
0002ECr 1               ;   KeyToHex — translate a keycode to its hex nibble value
0002ECr 1               ; -----------------------------------------------------------------------------
0002ECr 1               ;   In:  A = keycode (0-23)
0002ECr 1               ;   Out: C=1 -> A = nibble (0-15) for a hex-digit key (0-9, A-F)
0002ECr 1               ;        C=0 -> the key is not a hex digit (A preserved as $FF)
0002ECr 1               ;   Modifies: A, X
0002ECr 1               ; -----------------------------------------------------------------------------
0002ECr 1               KeyToHex:
0002ECr 1  AA             tax
0002EDr 1  BD rr rr       lda HexValTable,x
0002F0r 1  C9 FF          cmp #$FF                      ; sentinel: not a hex digit
0002F2r 1  F0 02          beq @NotHex
0002F4r 1  38             sec                           ; C=1: A holds the nibble
0002F5r 1  60             rts
0002F6r 1               @NotHex:
0002F6r 1  18             clc                           ; C=0: not a hex key
0002F7r 1  60             rts
0002F8r 1               
0002F8r 1               
0002F8r 1               ; =============================================================================
0002F8r 1               ;   SERIAL WOZMON MONITOR
0002F8r 1               ; =============================================================================
0002F8r 1               ;   A Wozmon-compatible serial monitor that shares memory with the keypad
0002F8r 1               ;   monitor and runs concurrently with it.  The command language is a faithful
0002F8r 1               ;   re-implementation of Apple-1 Wozmon, so bin2woz output (deposit lines of
0002F8r 1               ;   the form "ADDR: BB BB ...") is accepted byte-for-byte.  The only change
0002F8r 1               ;   from the original is the prompt: "> " instead of "\".  All commands are
0002F8r 1               ;   unchanged:
0002F8r 1               ;
0002F8r 1               ;     XXXX            examine the byte at XXXX
0002F8r 1               ;     XXXX.YYYY       examine the block XXXX..YYYY
0002F8r 1               ;     XXXX: BB BB ..  deposit bytes starting at XXXX (auto-incrementing)
0002F8r 1               ;     XXXX R          run from XXXX (JMP, original Wozmon semantics)
0002F8r 1               ;
0002F8r 1               ;   The IRQ handler (KeyIrq) pushes received bytes into the SER_RXBUF ring;
0002F8r 1               ;   the cooperative main loop drains the ring through SerService one byte at a
0002F8r 1               ;   time so the keypad stays responsive during a host stream.
0002F8r 1               ;
0002F8r 1               ;   Faithfulness note: incoming bytes have bit 7 set before parsing, exactly as
0002F8r 1               ;   the Apple-1 keyboard delivered them, so Wozmon's original byte comparisons
0002F8r 1               ;   and hex-decode arithmetic work unmodified.  Output clears bit 7 (and maps
0002F8r 1               ;   CR -> CR/LF) on the way to the serial port.
0002F8r 1               ; =============================================================================
0002F8r 1               
0002F8r 1               ; -----------------------------------------------------------------------------
0002F8r 1               ;   SerInit — bring up the serial card and reset the Wozmon parser state
0002F8r 1               ;   Called from CartReset before interrupts are enabled.
0002F8r 1               ;   Modifies: A
0002F8r 1               ; -----------------------------------------------------------------------------
0002F8r 1               SerInit:
0002F8r 1  20 4E A0       jsr InitSC                    ; BIOS: 8-N-1, 19200 baud, RX IRQ enabled
0002FBr 1  64 46          stz SER_RXHEAD                ; empty RX ring
0002FDr 1  64 47          stz SER_RXTAIL
0002FFr 1  64 50          stz SER_IDX                   ; empty line buffer
000301r 1  64 4F          stz WMODE                     ; XAM mode
000303r 1  64 51          stz SER_DIRTY
000305r 1  60             rts
000306r 1               
000306r 1               ; -----------------------------------------------------------------------------
000306r 1               ;   SerService — drain at most one byte from the RX ring into the parser
000306r 1               ;   Non-blocking.  Tail-calls SerFeed (which may run a full line on CR).
000306r 1               ;   Modifies: A, X, Y
000306r 1               ; -----------------------------------------------------------------------------
000306r 1               SerService:
000306r 1  20 rr rr       jsr SerGetChar
000309r 1  90 03          bcc @None
00030Br 1  4C rr rr       jmp SerFeed                   ; tail-call: SerFeed returns to our caller
00030Er 1               @None:
00030Er 1  60             rts
00030Fr 1               
00030Fr 1               ; -----------------------------------------------------------------------------
00030Fr 1               ;   SerGetChar — pull one byte from the RX ring (filled by KeyIrq)
00030Fr 1               ;   Out: C=1 -> A = byte with bit 7 set (Apple-1 style); C=0 -> ring empty
00030Fr 1               ;   Modifies: A, X
00030Fr 1               ; -----------------------------------------------------------------------------
00030Fr 1               SerGetChar:
00030Fr 1  A5 47          lda SER_RXTAIL
000311r 1  C5 46          cmp SER_RXHEAD
000313r 1  F0 0A          beq @Empty                    ; tail == head -> nothing buffered
000315r 1  AA             tax
000316r 1  BD 00 04       lda SER_RXBUF,x               ; fetch the oldest byte
000319r 1  E6 47          inc SER_RXTAIL                ; advance (wraps at 256)
00031Br 1  09 80          ora #$80                      ; set bit 7 for the Wozmon parser
00031Dr 1  38             sec
00031Er 1  60             rts
00031Fr 1               @Empty:
00031Fr 1  18             clc
000320r 1  60             rts
000321r 1               
000321r 1               ; -----------------------------------------------------------------------------
000321r 1               ;   SerFeed — accumulate one received byte into the line buffer
000321r 1               ;   In: A = byte (bit 7 set).  Handles backspace / CR like Wozmon's character
000321r 1               ;   loop; a CR runs the line through SerProcess.  ESC is NOT handled here — it
000321r 1               ;   is consumed in the ISR (KeyIrq) as a break-to-monitor abort, so it never
000321r 1               ;   reaches the RX ring or this parser.
000321r 1               ;   Modifies: A, X, Y
000321r 1               ; -----------------------------------------------------------------------------
000321r 1               SerFeed:
000321r 1  C9 DF          cmp #$DF                      ; "_" backspace (Apple-1)?
000323r 1  F0 25          beq @Bs
000325r 1  C9 88          cmp #$88                      ; BS ($08|$80)?
000327r 1  F0 21          beq @Bs
000329r 1  C9 FF          cmp #$FF                      ; DEL ($7F|$80)?
00032Br 1  F0 1D          beq @Bs
00032Dr 1  A4 50          ldy SER_IDX
00032Fr 1  99 00 02       sta SER_LINEBUF,y             ; store into the line buffer
000332r 1  C9 8D          cmp #$8D                      ; CR ($0D|$80)?  (test before echo clobbers A)
000334r 1  F0 0B          beq @Cr
000336r 1  20 rr rr       jsr SerEcho                   ; echo the typed character
000339r 1  C8             iny
00033Ar 1  10 02          bpl @Store                    ; line < 128 chars — keep going
00033Cr 1  80 09          bra @Cancel                   ; over-long line: discard it, fresh prompt
00033Er 1               @Store:
00033Er 1  84 50          sty SER_IDX
000340r 1  60             rts
000341r 1               @Cr:
000341r 1  20 rr rr       jsr SerEcho                   ; echo CR -> CR/LF
000344r 1  4C rr rr       jmp SerProcess                ; parse and act on the completed line
000347r 1               @Cancel:
000347r 1  4C rr rr       jmp SerPrompt                 ; discard the line, fresh prompt
00034Ar 1               @Bs:
00034Ar 1  A4 50          ldy SER_IDX
00034Cr 1  F0 12          beq @BsDone                   ; already at the start — nothing to erase
00034Er 1  88             dey
00034Fr 1  84 50          sty SER_IDX
000351r 1  A9 88          lda #$88                      ; visually erase on the terminal: BS, space, BS
000353r 1  20 rr rr       jsr SerEcho
000356r 1  A9 A0          lda #$A0                      ; space
000358r 1  20 rr rr       jsr SerEcho
00035Br 1  A9 88          lda #$88
00035Dr 1  20 rr rr       jsr SerEcho
000360r 1               @BsDone:
000360r 1  60             rts
000361r 1               
000361r 1               ; -----------------------------------------------------------------------------
000361r 1               ;   SerProcess — parse and execute a completed Wozmon line
000361r 1               ; -----------------------------------------------------------------------------
000361r 1               ;   Faithful port of the Apple-1 Wozmon line interpreter.  The line lives in
000361r 1               ;   SER_LINEBUF, terminated by the CR ($8D) at SER_IDX.  Examine / block
000361r 1               ;   examine / deposit / run all follow the original semantics exactly.
000361r 1               ;   Modifies: A, X, Y
000361r 1               ; -----------------------------------------------------------------------------
000361r 1               SerProcess:
000361r 1  A0 FF          ldy #$ff                      ; reset the text index (INY -> 0 below)
000363r 1  A9 00          lda #$00                      ; default XAM mode
000365r 1  AA             tax                           ; 0 -> X
000366r 1               @SetStor:
000366r 1  0A             asl a                         ; ":" arrives as $BA -> $74 (STOR); XAM stays 0
000367r 1               @SetMode:
000367r 1  85 4F          sta WMODE                     ; $00=XAM, $74=STOR, $AE=BLOCK XAM
000369r 1               @BlSkip:
000369r 1  C8             iny                           ; advance the text index
00036Ar 1               @NextItem:
00036Ar 1  B9 00 02       lda SER_LINEBUF,y             ; next character
00036Dr 1  C9 8D          cmp #$8D                      ; CR -> end of line
00036Fr 1  D0 03          bne @ChkDot
000371r 1  4C rr rr       jmp SerPrompt                 ; line consumed — emit the next prompt
000374r 1               @ChkDot:
000374r 1  C9 AE          cmp #$AE                      ; "."?
000376r 1  90 F1          bcc @BlSkip                   ; below "." -> delimiter, skip it
000378r 1  F0 ED          beq @SetMode                  ; "." -> BLOCK XAM mode (A=$AE)
00037Ar 1  C9 BA          cmp #$BA                      ; ":"?
00037Cr 1  F0 E8          beq @SetStor                  ; ":" -> STOR mode (A=$BA)
00037Er 1  C9 D2          cmp #$D2                      ; "R"?
000380r 1  F0 3F          beq @Run                      ; run user program
000382r 1  86 4C          stx L                         ; clear the hex accumulator
000384r 1  86 4D          stx H
000386r 1  84 4E          sty YSAV                      ; remember where the number started
000388r 1               @NextHex:
000388r 1  B9 00 02       lda SER_LINEBUF,y             ; get a character for the hex test
00038Br 1  49 B0          eor #$B0                      ; map "0".."9" to $0-$9
00038Dr 1  C9 0A          cmp #$0A                      ; decimal digit?
00038Fr 1  90 06          bcc @Dig
000391r 1  69 88          adc #$88                      ; map "A".."F" to $FA-$FF
000393r 1  C9 FA          cmp #$FA                      ; valid hex letter?
000395r 1  90 11          bcc @NotHex                   ; no — not a hex character
000397r 1               @Dig:
000397r 1  0A             asl a
000398r 1  0A             asl a                         ; hex digit to the MSD of A
000399r 1  0A             asl a
00039Ar 1  0A             asl a
00039Br 1  A2 04          ldx #$04                      ; shift count
00039Dr 1               @HexShift:
00039Dr 1  0A             asl a                         ; hex digit left, MSB into carry
00039Er 1  26 4C          rol L                         ; rotate into the accumulator
0003A0r 1  26 4D          rol H
0003A2r 1  CA             dex
0003A3r 1  D0 F8          bne @HexShift
0003A5r 1  C8             iny                           ; advance the text index
0003A6r 1  D0 E0          bne @NextHex                  ; always taken (Y < 256)
0003A8r 1               @NotHex:
0003A8r 1  C4 4E          cpy YSAV                      ; were any hex digits given?
0003AAr 1  F0 18          beq @Escape                   ; none -> treat as ESC
0003ACr 1  24 4F          bit WMODE                     ; B6=1 STOR, B6=0 XAM/BLOCK
0003AEr 1  50 17          bvc @NotStor
0003B0r 1  A5 4C          lda L                         ; deposit: store the low byte
0003B2r 1  81 4A          sta (STL,x)                   ; X=0 -> via STH:STL
0003B4r 1  E6 4A          inc STL                       ; auto-increment the deposit address
0003B6r 1  D0 02          bne @Deposited
0003B8r 1  E6 4B          inc STH
0003BAr 1               @Deposited:
0003BAr 1  A9 01          lda #$01
0003BCr 1  85 51          sta SER_DIRTY                 ; memory changed — flag an LCD refresh
0003BEr 1  4C rr rr       jmp @NextItem
0003C1r 1               @Run:
0003C1r 1  6C 48 00       jmp (XAML)                    ; run at the last examined address (original R)
0003C4r 1               @Escape:
0003C4r 1  4C rr rr       jmp SerPrompt                 ; nothing parsed — fresh prompt
0003C7r 1               @NotStor:
0003C7r 1  30 2B          bmi @XamNext                  ; B7=1 -> BLOCK XAM continuation
0003C9r 1  A2 02          ldx #$02                      ; copy the hex value to the store + examine
0003CBr 1               @SetAdr:
0003CBr 1  B5 4B          lda L-1,x                     ;   indices (two bytes)
0003CDr 1  95 49          sta STL-1,x
0003CFr 1  95 47          sta XAML-1,x
0003D1r 1  CA             dex
0003D2r 1  D0 F7          bne @SetAdr                   ; X reaches 0 with Z=1 (prints the address)
0003D4r 1               @NxtPrnt:
0003D4r 1  D0 14          bne @PrData                   ; NE -> mid-row, no new address label
0003D6r 1  A9 8D          lda #$8D                      ; CR
0003D8r 1  20 rr rr       jsr SerEcho
0003DBr 1  A5 49          lda XAMH                      ; print the examine address
0003DDr 1  20 rr rr       jsr PrByte
0003E0r 1  A5 48          lda XAML
0003E2r 1  20 rr rr       jsr PrByte
0003E5r 1  A9 BA          lda #$BA                      ; ":"
0003E7r 1  20 rr rr       jsr SerEcho
0003EAr 1               @PrData:
0003EAr 1  A9 A0          lda #$A0                      ; space
0003ECr 1  20 rr rr       jsr SerEcho
0003EFr 1  A1 48          lda (XAML,x)                  ; print the data byte (X=0)
0003F1r 1  20 rr rr       jsr PrByte
0003F4r 1               @XamNext:
0003F4r 1  86 4F          stx WMODE                     ; X=0 -> back to XAM mode
0003F6r 1  A5 48          lda XAML                      ; more bytes to print in the range?
0003F8r 1  C5 4C          cmp L
0003FAr 1  A5 49          lda XAMH
0003FCr 1  E5 4D          sbc H
0003FEr 1  B0 0C          bcs @ToNextItem               ; not less -> done with this range
000400r 1  E6 48          inc XAML                      ; advance the examine index
000402r 1  D0 02          bne @Mod8
000404r 1  E6 49          inc XAMH
000406r 1               @Mod8:
000406r 1  A5 48          lda XAML                      ; start a new row every 8 bytes
000408r 1  29 07          and #$07
00040Ar 1  10 C8          bpl @NxtPrnt                  ; always taken (result is 0-7); Z drives the
00040Cr 1               @ToNextItem:                    ;   address-label decision in @NxtPrnt
00040Cr 1  4C rr rr       jmp @NextItem
00040Fr 1               
00040Fr 1               ; -----------------------------------------------------------------------------
00040Fr 1               ;   SerPrompt — emit a CR/LF and the "> " prompt, reset the line buffer
00040Fr 1               ;   Modifies: A
00040Fr 1               ; -----------------------------------------------------------------------------
00040Fr 1               SerPrompt:
00040Fr 1  A9 0D          lda #CHAR_CR
000411r 1  20 rr rr       jsr SerEcho                   ; CR -> CR/LF
000414r 1  A9 3E          lda #'>'
000416r 1  20 rr rr       jsr SerPutc
000419r 1  A9 20          lda #CHAR_SPACE
00041Br 1  20 rr rr       jsr SerPutc
00041Er 1  64 50          stz SER_IDX                   ; start a fresh line
000420r 1  60             rts
000421r 1               
000421r 1               ; -----------------------------------------------------------------------------
000421r 1               ;   PrByte / PrHex — print A as two hex digits over serial (Wozmon PRBYTE)
000421r 1               ;   In: A = byte.  PrHex falls through into SerEcho.
000421r 1               ;   Modifies: A
000421r 1               ; -----------------------------------------------------------------------------
000421r 1               PrByte:
000421r 1  48             pha
000422r 1  4A             lsr a
000423r 1  4A             lsr a
000424r 1  4A             lsr a                         ; high nibble to the low nibble position
000425r 1  4A             lsr a
000426r 1  20 rr rr       jsr PrHex
000429r 1  68             pla
00042Ar 1               PrHex:
00042Ar 1  29 0F          and #$0F                      ; mask the low nibble
00042Cr 1  09 B0          ora #$B0                      ; "0".."9"
00042Er 1  C9 BA          cmp #$BA
000430r 1  90 02          bcc SerEcho                   ; a digit — send it
000432r 1  69 06          adc #$06                      ; letter offset: "A".."F"
000434r 1                 ; fall through to SerEcho
000434r 1               
000434r 1               ; -----------------------------------------------------------------------------
000434r 1               ;   SerEcho — send one character to the serial port
000434r 1               ;   In: A = character (bit 7 may be set).  Clears bit 7 and maps CR -> CR/LF.
000434r 1               ;   Preserves X and Y (the line parser holds state in them across echoes).
000434r 1               ;   Modifies: A
000434r 1               ; -----------------------------------------------------------------------------
000434r 1               SerEcho:
000434r 1  DA             phx
000435r 1  5A             phy
000436r 1  29 7F          and #$7F                      ; back to plain ASCII
000438r 1  C9 0D          cmp #CHAR_CR                  ; CR?
00043Ar 1  D0 0C          bne @One
00043Cr 1  A9 0D          lda #CHAR_CR
00043Er 1  20 rr rr       jsr SerPutc
000441r 1  A9 0A          lda #CHAR_LF                  ; CR -> CR + LF
000443r 1  20 rr rr       jsr SerPutc
000446r 1  80 03          bra @Done
000448r 1               @One:
000448r 1  20 rr rr       jsr SerPutc
00044Br 1               @Done:
00044Br 1  7A             ply
00044Cr 1  FA             plx
00044Dr 1  60             rts
00044Er 1               
00044Er 1               ; -----------------------------------------------------------------------------
00044Er 1               ;   SerPutc — send one byte to the serial port, NON-BLOCKING
00044Er 1               ; -----------------------------------------------------------------------------
00044Er 1               ;   In: A = byte (sent as-is).  Preserves X and Y.
00044Er 1               ;   Unlike the BIOS SerialChrout (which blocks until TDRE — and therefore
00044Er 1               ;   hangs forever when the R65C51's /CTS is not asserted by a connected
00044Er 1               ;   terminal), this waits for TX-ready only for a bounded time and then drops
00044Er 1               ;   the byte.  That keeps the keypad monitor fully alive whether or not a host
00044Er 1               ;   terminal is attached.  When a terminal IS connected it exits as soon as
00044Er 1               ;   TDRE sets, so back-to-back bytes are not dropped.
00044Er 1               ;   Modifies: A
00044Er 1               ; -----------------------------------------------------------------------------
00044Er 1               SerPutc:
00044Er 1  48             pha                           ; save the byte on the stack
00044Fr 1  DA             phx
000450r 1  5A             phy
000451r 1  A2 08          ldx #$08                      ; bounded TDRE wait (~16-bit countdown)
000453r 1               @WaitHi:
000453r 1  A0 00          ldy #$00
000455r 1               @WaitLo:
000455r 1  AD 01 90       lda SC_STATUS
000458r 1  29 10          and #SC_STATUS_TDRE           ; TX data register empty?
00045Ar 1  D0 0A          bne @Send
00045Cr 1  88             dey
00045Dr 1  D0 F6          bne @WaitLo
00045Fr 1  CA             dex
000460r 1  D0 F1          bne @WaitHi
000462r 1                 ; timeout — no terminal; drop the byte
000462r 1  7A             ply
000463r 1  FA             plx
000464r 1  68             pla
000465r 1  60             rts
000466r 1               @Send:
000466r 1  7A             ply
000467r 1  FA             plx
000468r 1  68             pla                           ; recover the byte
000469r 1  8D 00 90       sta SC_DATA                   ; transmit it
00046Cr 1  60             rts
00046Dr 1               
00046Dr 1               ; -----------------------------------------------------------------------------
00046Dr 1               ;   SerPrintStr — send a null-terminated string over serial
00046Dr 1               ;   In: STR_PTR ($02-$03) = pointer to the string
00046Dr 1               ;   Modifies: A, Y
00046Dr 1               ; -----------------------------------------------------------------------------
00046Dr 1               SerPrintStr:
00046Dr 1  A0 00          ldy #$00
00046Fr 1               @Loop:
00046Fr 1  B1 02          lda (STR_PTR),y
000471r 1  F0 06          beq @Done                     ; null terminator
000473r 1  20 rr rr       jsr SerEcho                   ; SerEcho preserves Y
000476r 1  C8             iny
000477r 1  D0 F6          bne @Loop
000479r 1               @Done:
000479r 1  60             rts
00047Ar 1               
00047Ar 1               
00047Ar 1               ; =============================================================================
00047Ar 1               ;   INTERRUPT HANDLERS & VECTOR TRAMPOLINES
00047Ar 1               ; =============================================================================
00047Ar 1               ;   The cartridge owns the hardware vectors at $FFFA-$FFFF.  Following the
00047Ar 1               ;   BIOS convention, the NMI and IRQ vectors trampoline through the writable
00047Ar 1               ;   RAM vectors (NMI_PTR / IRQ_PTR) that KernalInit installs.  CartReset then
00047Ar 1               ;   repoints IRQ_PTR at the local KeyIrq handler so the keypad CA1 edge drives
00047Ar 1               ;   key input (see the keypad driver section); NMI_PTR keeps the Kernal
00047Ar 1               ;   default (RTI).
00047Ar 1               ;
00047Ar 1               ;   BRK shares the IRQ vector.  KeyIrq detects the B flag and dispatches via
00047Ar 1               ;   BRK_PTR (-> BrkHandler) with P/PCL/PCH still on the stack, so BrkHandler
00047Ar 1               ;   only needs to RTI to resume the interrupted code.
00047Ar 1               ; -----------------------------------------------------------------------------
00047Ar 1               
00047Ar 1               ; -----------------------------------------------------------------------------
00047Ar 1               ;   NmiVector / IrqVector — hardware-vector trampolines through the RAM vectors
00047Ar 1               ; -----------------------------------------------------------------------------
00047Ar 1               NmiVector:
00047Ar 1  6C 04 03       jmp (NMI_PTR)                  ; default: Kernal Nmi (RTI)
00047Dr 1               
00047Dr 1               IrqVector:
00047Dr 1  6C 00 03       jmp (IRQ_PTR)                  ; CartReset points IRQ_PTR at KeyIrq
000480r 1               
000480r 1               ; -----------------------------------------------------------------------------
000480r 1               ;   BrkHandler — local BRK handler
000480r 1               ; -----------------------------------------------------------------------------
000480r 1               ;   Reached via JMP (BRK_PTR) from KeyIrq after a BRK.  A/X are already
000480r 1               ;   restored and the P/PCL/PCH frame is intact, so resuming is a plain RTI.
000480r 1               ;   This keeps a stray BRK in executed user code from entering the overlaid
000480r 1               ;   BIOS monitor.
000480r 1               ; -----------------------------------------------------------------------------
000480r 1               BrkHandler:
000480r 1  40             rti
000481r 1               
000481r 1               
000481r 1               ; =============================================================================
000481r 1               ;   Data
000481r 1               ; =============================================================================
000481r 1               
000481r 1               SplashL1:
000481r 1  4B 49 4D 20    .byte "KIM MONITOR v1.0", $00
000485r 1  4D 4F 4E 49  
000489r 1  54 4F 52 20  
000492r 1               SplashL2:
000492r 1  2D 2D 45 53    .byte "--ESC TO START--", $00
000496r 1  43 20 54 4F  
00049Ar 1  20 53 54 41  
0004A3r 1               
0004A3r 1               ; -----------------------------------------------------------------------------
0004A3r 1               ;   KeySymTable — keycode (0-23) -> printable LCD symbol
0004A3r 1               ; -----------------------------------------------------------------------------
0004A3r 1               ;   Hex digit keys map to their hex character; navigation/command keys map to
0004A3r 1               ;   a distinct printable glyph for the keypad echo test.
0004A3r 1               ;     $00 LEFT  $0B RIGHT  $10 ESC  $11 INS  $12 PGUP  $14 UP  $15 DEL  $16 PGDN
0004A3r 1               ; -----------------------------------------------------------------------------
0004A3r 1               KeySymTable:
0004A3r 1  3C             .byte '<'                     ; $00 LEFT
0004A4r 1  31             .byte '1'                     ; $01
0004A5r 1  32             .byte '2'                     ; $02
0004A6r 1  33             .byte '3'                     ; $03
0004A7r 1  34             .byte '4'                     ; $04
0004A8r 1  35             .byte '5'                     ; $05
0004A9r 1  36             .byte '6'                     ; $06
0004AAr 1  37             .byte '7'                     ; $07
0004ABr 1  38             .byte '8'                     ; $08
0004ACr 1  39             .byte '9'                     ; $09
0004ADr 1  30             .byte '0'                     ; $0A
0004AEr 1  3E             .byte '>'                     ; $0B RIGHT
0004AFr 1  46             .byte 'F'                     ; $0C
0004B0r 1  45             .byte 'E'                     ; $0D
0004B1r 1  44             .byte 'D'                     ; $0E
0004B2r 1  43             .byte 'C'                     ; $0F
0004B3r 1  2A             .byte '*'                     ; $10 ESC
0004B4r 1  49             .byte 'I'                     ; $11 INS
0004B5r 1  55             .byte 'U'                     ; $12 PGUP
0004B6r 1  41             .byte 'A'                     ; $13
0004B7r 1  5E             .byte '^'                     ; $14 UP
0004B8r 1  58             .byte 'X'                     ; $15 DEL
0004B9r 1  4E             .byte 'N'                     ; $16 PGDN
0004BAr 1  42             .byte 'B'                     ; $17
0004BBr 1               
0004BBr 1               
0004BBr 1               ; -----------------------------------------------------------------------------
0004BBr 1               ;   HexValTable — keycode (0-23) -> hex nibble value, $FF = not a hex digit
0004BBr 1               ; -----------------------------------------------------------------------------
0004BBr 1               ;   Used by KeyToHex.  Maps the ten digit keys (0-9) and the six letter keys
0004BBr 1               ;   (A-F) to their 0-15 nibble value; every navigation/command key maps to the
0004BBr 1               ;   $FF sentinel so the dispatch loop ignores it during address/data entry.
0004BBr 1               ; -----------------------------------------------------------------------------
0004BBr 1               HexValTable:
0004BBr 1  FF             .byte $FF                     ; $00 LEFT
0004BCr 1  01             .byte $01                     ; $01 1
0004BDr 1  02             .byte $02                     ; $02 2
0004BEr 1  03             .byte $03                     ; $03 3
0004BFr 1  04             .byte $04                     ; $04 4
0004C0r 1  05             .byte $05                     ; $05 5
0004C1r 1  06             .byte $06                     ; $06 6
0004C2r 1  07             .byte $07                     ; $07 7
0004C3r 1  08             .byte $08                     ; $08 8
0004C4r 1  09             .byte $09                     ; $09 9
0004C5r 1  00             .byte $00                     ; $0A 0
0004C6r 1  FF             .byte $FF                     ; $0B RIGHT
0004C7r 1  0F             .byte $0F                     ; $0C F
0004C8r 1  0E             .byte $0E                     ; $0D E
0004C9r 1  0D             .byte $0D                     ; $0E D
0004CAr 1  0C             .byte $0C                     ; $0F C
0004CBr 1  FF             .byte $FF                     ; $10 ESC
0004CCr 1  FF             .byte $FF                     ; $11 INS
0004CDr 1  FF             .byte $FF                     ; $12 PGUP
0004CEr 1  0A             .byte $0A                     ; $13 A
0004CFr 1  FF             .byte $FF                     ; $14 UP
0004D0r 1  FF             .byte $FF                     ; $15 DEL
0004D1r 1  FF             .byte $FF                     ; $16 PGDN
0004D2r 1  0B             .byte $0B                     ; $17 B
0004D3r 1               
0004D3r 1               
0004D3r 1               ; =============================================================================
0004D3r 1               ;   CPU Vectors — cart owns $FFFA-$FFFF
0004D3r 1               ; =============================================================================
0004D3r 1               ;   NMI and IRQ trampoline through the Kernal RAM vectors (see above);
0004D3r 1               ;   RESET enters the cartridge.
0004D3r 1               
0004D3r 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiVector                ; NMI vector   -> jmp (NMI_PTR)
000002r 1  rr rr        .word   CartReset                ; RESET vector — cartridge entry point
000004r 1  rr rr        .word   IrqVector                ; IRQ vector   -> jmp (IRQ_PTR)
000004r 1               
