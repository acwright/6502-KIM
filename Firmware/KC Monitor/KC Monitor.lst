000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               .include "6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc — External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.4
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for user programs
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$05FF   User Variables / BASIC workspace
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active — centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS — interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines SEI on entry and CLI on exit unconditionally, so calling
000000r 2               ;   either one from inside an interrupt-disabled section re-enables interrupts.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Temporarily disables matrix keyboard encoder
000000r 2                                                        ;   Modifies: A, X; enables interrupts
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Temporarily disables PS/2 keyboard encoder
000000r 2                                                        ;   Modifies: A, X; enables interrupts
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — set to inhibit clock updates during write
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 4
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   KC Monitor — KIM-1-style keypad/LCD memory monitor
000000r 1               ; =============================================================================
000000r 1               ;   Cartridge ROM for the Keypad Card (KC).  Drives a 16x2 HD44780 LCD and a
000000r 1               ;   24-key keypad through a 65C21 PIA.  The cart overlays $C000-$FFFF; ROM
000000r 1               ;   (AT28C64, 8 KB) lives at $E000-$FFFF and the PIA registers are mirrored
000000r 1               ;   across the I/O window $C000-$DFFF.
000000r 1               ;
000000r 1               ;   This file implements:
000000r 1               ;     - Build scaffolding & KC-local PIA/LCD constants
000000r 1               ;     - LCD driver
000000r 1               ;     - PIA init & keypad input
000000r 1               ;     - Monitor state machine
000000r 1               ;     - Entry point, interrupt handlers & CPU vectors
000000r 1               ;     - ESC = break-to-monitor abort (handled in KeyIrq)
000000r 1               ;     - Wozmon-compatible serial monitor (concurrent with the keypad)
000000r 1               ; =============================================================================
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   KC PIA register map (65C21)
000000r 1               ; =============================================================================
000000r 1               ;   The PIA is mirrored across the I/O window $C000-$DFFF.  A0=RS0, A1=RS1.
000000r 1               ;     $C000  PORTA / DDRA  (selected by CRA bit 2)
000000r 1               ;     $C001  CRA
000000r 1               ;     $C002  PORTB / DDRB  (selected by CRB bit 2)
000000r 1               ;     $C003  CRB
000000r 1               ;
000000r 1               ;   Wiring:
000000r 1               ;     PA0-PA4 = keypad code        (input)
000000r 1               ;     PA5     = LCD RS             (output)
000000r 1               ;     PA6     = LCD R/W            (output)
000000r 1               ;     PA7     = LCD E              (output)
000000r 1               ;     PB0-PB7 = LCD data bus       (output)
000000r 1               ;     CA1     = keypad data-available
000000r 1               ;     CA2     = active-low OE of the 74C922 keypad encoder
000000r 1               
000000r 1               PORTA               := $C000             ; Port A data / DDRA (per CRA bit 2)
000000r 1               CRA                 := $C001             ; Control register A
000000r 1               PORTB               := $C002             ; Port B data / DDRB (per CRB bit 2)
000000r 1               CRB                 := $C003             ; Control register B
000000r 1               
000000r 1               ; Control-register bit 2 selects the data register (1) or the data
000000r 1               ; direction register (0) at the shared port address.
000000r 1               CR_DDR              = %00000000          ; access DDRx
000000r 1               CR_PORT             = %00000100          ; access PORTx data register
000000r 1               
000000r 1               ; Data direction for Port A: PA5/PA6/PA7 outputs (LCD control),
000000r 1               ; PA0-PA4 inputs (keypad code).
000000r 1               LCD_DDRA            = %11100000          ; $E0
000000r 1               
000000r 1               ; LCD control-line masks on Port A
000000r 1               LCD_RS              = %00100000          ; PA5 — register select (1=data, 0=cmd)
000000r 1               LCD_RW              = %01000000          ; PA6 — read/write (1=read, 0=write)
000000r 1               LCD_E               = %10000000          ; PA7 — enable strobe
000000r 1               
000000r 1               ; LCD busy flag (Port B DB7, valid when reading with RS=0/R/W=1)
000000r 1               LCD_BUSY            = %10000000
000000r 1               
000000r 1               ; -----------------------------------------------------------------------------
000000r 1               ;   Keypad (74C922 encoder via PIA Port A + CA1/CA2)
000000r 1               ; -----------------------------------------------------------------------------
000000r 1               ;   The encoder presents a 5-bit keycode on PA0-PA4 and raises CA1 (positive
000000r 1               ;   edge) when a key becomes available.  CA2 is driven low to enable the
000000r 1               ;   encoder's active-low output enable (OE).  Key entry is interrupt driven:
000000r 1               ;   the CA1 rising edge raises the CPU IRQ, and the handler (KeyIrq) reads the
000000r 1               ;   keycode at that instant — when the 74C922 outputs are guaranteed valid —
000000r 1               ;   so a read can never straddle a key transition the way polling at an
000000r 1               ;   arbitrary later time could.
000000r 1               ;
000000r 1               ;   CRA layout for the keypad:
000000r 1               ;     bit 7   CA1 active-edge flag (IRQF1) — set on key-available, read-only
000000r 1               ;     bit 5-3 110 = CA2 manual output low (enables 74C922 OE)
000000r 1               ;     bit 2   1   = access PORTA data register (not DDRA)
000000r 1               ;     bit 1   1   = CA1 active on the positive (rising) edge
000000r 1               ;     bit 0   1   = CA1 interrupt enabled
000000r 1               PIA_CA1_FLAG        = %10000000          ; CRA bit 7 — CA1 active-edge flag
000000r 1               PIA_CRA_KEYPAD      = %00110111          ; $37 — CA2 out low, CA1 +edge, IRQ ON, PORT
000000r 1               KEY_MASK            = %00011111          ; PA0-PA4 carry the keycode (0-23)
000000r 1               KEY_COUNT           = 24                  ; valid keycodes are $00-$17
000000r 1               
000000r 1               ; Named keycodes (used by the monitor dispatch)
000000r 1               KEY_LEFT            = $00
000000r 1               KEY_RIGHT           = $0B
000000r 1               KEY_ESC             = $10
000000r 1               KEY_INS             = $11
000000r 1               KEY_PGUP            = $12
000000r 1               KEY_A               = $13
000000r 1               KEY_UP              = $14
000000r 1               KEY_DEL             = $15
000000r 1               KEY_PGDN            = $16
000000r 1               KEY_B               = $17
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Monitor zero-page state
000000r 1               ; =============================================================================
000000r 1               ;   Lives in the free user zero page ($36-$FF).  CUR_ADDR is the address the
000000r 1               ;   monitor is inspecting/editing; it doubles as the (zp),y pointer for byte
000000r 1               ;   access and as the execute trampoline target.  MODE holds the INS edit
000000r 1               ;   flag; MON_TMP is scratch for the nibble-shift edits.
000000r 1               CUR_ADDR            := $40               ; 2 bytes — current address pointer
000000r 1               MODE                := $42               ; 1 byte  — INS edit-mode flag (0=off)
000000r 1               MON_TMP             := $43               ; 1 byte  — scratch for nibble edits
000000r 1               KEY_CODE            := $44               ; 1 byte  — last keycode latched by KeyIrq
000000r 1               KEY_READY           := $45               ; 1 byte  — nonzero when a key is pending
000000r 1               
000000r 1               MODE_INS            = $01                ; MODE value: insert/edit mode active
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Serial Wozmon zero-page state
000000r 1               ; =============================================================================
000000r 1               ;   A Wozmon-compatible serial monitor runs concurrently with the keypad
000000r 1               ;   monitor, sharing the same memory.  Incoming bytes are pushed into a
000000r 1               ;   256-byte RX ring by the IRQ handler and drained by the cooperative main
000000r 1               ;   loop into a Wozmon line parser.  The parser variables mirror the original
000000r 1               ;   Apple-1 Wozmon (XAML/XAMH, STL/STH, L/H, YSAV, MODE) but live in the free
000000r 1               ;   user zero page since $24-$2B are reserved by the Kernal here.  WMODE is
000000r 1               ;   kept distinct from the keypad MODE byte.
000000r 1               SER_RXHEAD          := $46               ; 1 byte  — RX ring write index (IRQ)
000000r 1               SER_RXTAIL          := $47               ; 1 byte  — RX ring read index (main loop)
000000r 1               XAML                := $48               ; 2 bytes — last "examined" address (lo/hi)
000000r 1               XAMH                := $49
000000r 1               STL                 := $4A               ; 2 bytes — current deposit address (lo/hi)
000000r 1               STH                 := $4B
000000r 1               L                   := $4C               ; 2 bytes — hex accumulator (lo/hi)
000000r 1               H                   := $4D
000000r 1               YSAV                := $4E               ; 1 byte  — saved index (hex-present test)
000000r 1               WMODE               := $4F               ; 1 byte  — Wozmon mode ($00=XAM, $74=STOR, $AE=BLOCK)
000000r 1               SER_IDX             := $50               ; 1 byte  — current line-buffer index
000000r 1               SER_DIRTY           := $51               ; 1 byte  — nonzero when a serial deposit changed memory
000000r 1               
000000r 1               ; The RX ring buffer (256 bytes, byte indices wrap naturally) and the Wozmon
000000r 1               ; line buffer share the low-RAM input region; neither is used by the keypad
000000r 1               ; monitor.
000000r 1               SER_RXBUF           := $0400             ; 256-byte serial RX ring buffer
000000r 1               SER_LINEBUF         := INPUT_BUFFER      ; $0200 — Wozmon line accumulation buffer
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   ROM
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .segment "ROM"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   CartReset — power-on entry point
000000r 1               ; =============================================================================
000000r 1               ;   RESET vectors here.  Resets the stack, runs KernalInit to bring up the
000000r 1               ;   Kernal RAM vectors and probe the base system, overrides the BRK vector so
000000r 1               ;   a BRK from executed user code returns cleanly instead of diving into the
000000r 1               ;   now-overlaid BIOS monitor, brings up the LCD and keypad PIA, seeds the
000000r 1               ;   monitor state, shows the splash screen, then enters the monitor loop
000000r 1               ;   directly (no ESC gate).
000000r 1               ;
000000r 1               ;   Key entry is interrupt driven, so after init it repoints IRQ_PTR at the
000000r 1               ;   local KeyIrq handler and enables interrupts (CLI) before showing the
000000r 1               ;   splash.  BRK is unaffected by the I flag; the BRK_PTR override below keeps
000000r 1               ;   a BRK in executed user code from entering the overlaid BIOS monitor.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               CartReset:
000000r 1  78             sei
000001r 1  A2 FF          ldx #$ff
000003r 1  9A             txs                           ; Reset the stack pointer (required by KernalInit)
000004r 1               
000004r 1  20 78 A0       jsr KernalInit                ; Init Kernal RAM vectors + probe base system
000007r 1                                               ; (clears decimal mode, leaves interrupts off)
000007r 1               
000007r 1                 ; Override the BRK vector: KernalInit points it at the BIOS monitor, which
000007r 1                 ; the cartridge has overlaid.  Route BRK to a local RTI handler instead.
000007r 1  A9 rr          lda #<BrkHandler
000009r 1  8D 02 03       sta BRK_PTR
00000Cr 1  A9 rr          lda #>BrkHandler
00000Er 1  8D 03 03       sta BRK_PTR + 1
000011r 1               
000011r 1                 ; Route the IRQ through our keypad handler.  KernalInit set IRQ_PTR to the
000011r 1                 ; Kernal's own IRQ service; the cart drives only the keypad, so take it over.
000011r 1  A9 rr          lda #<KeyIrq
000013r 1  8D 00 03       sta IRQ_PTR
000016r 1  A9 rr          lda #>KeyIrq
000018r 1  8D 01 03       sta IRQ_PTR + 1
00001Br 1               
00001Br 1  20 rr rr       jsr LcdInit                   ; Bring up the LCD (must precede PiaInit)
00001Er 1  20 rr rr       jsr PiaInit                   ; Configure keypad + enable CA1 IRQ, clear flag
000021r 1               
000021r 1  20 rr rr       jsr SerInit                   ; Bring up the serial card + Wozmon parser state
000024r 1               
000024r 1  64 45          stz KEY_READY                 ; no key pending yet
000026r 1               
000026r 1                 ; Seed monitor state: start at user RAM ($0800), edit mode off
000026r 1  A9 00          lda #<PROGRAM_START
000028r 1  85 40          sta CUR_ADDR
00002Ar 1  A9 08          lda #>PROGRAM_START
00002Cr 1  85 41          sta CUR_ADDR + 1
00002Er 1  64 42          stz MODE
000030r 1               
000030r 1  58             cli                           ; enable IRQs — keypad CA1 + serial RX drive input
000031r 1               
000031r 1                 ; LCD splash first — it must never depend on the serial terminal being
000031r 1                 ; connected.  (SerialChrout/our serial TX blocks on TDRE, which the R65C51
000031r 1                 ; gates on /CTS; with no terminal connected the serial banner would stall.)
000031r 1  20 rr rr       jsr ShowSplash                ; brief splash while the serial banner emits
000034r 1               
000034r 1                 ; Serial startup banner + first Wozmon prompt.  Emitted through the
000034r 1                 ; non-blocking SerPutc path, so a missing/disconnected terminal just drops
000034r 1                 ; these bytes instead of hanging the keypad monitor.
000034r 1  A9 rr          lda #<SplashL1
000036r 1  85 02          sta STR_PTR
000038r 1  A9 rr          lda #>SplashL1
00003Ar 1  85 03          sta STR_PTR + 1
00003Cr 1  20 rr rr       jsr SerPrintStr               ; "KIM MONITOR v1.0"
00003Fr 1  20 rr rr       jsr SerPrompt                 ; CR/LF + "> "
000042r 1               
000042r 1                 ; Splash gate: hold on the splash until the user starts the monitor.  The
000042r 1                 ; prompt says "ESC TO START", but ANY keypad key (KeyPoll) begins — and an
000042r 1                 ; ESC from the keypad OR the serial terminal jumps to WarmStart from inside
000042r 1                 ; KeyIrq and enters the monitor the same way.  Accepting any key keeps the
000042r 1                 ; marginal ESC key switch from trapping us here: a clean ESC is no longer
000042r 1                 ; required to boot.
000042r 1               @WaitStart:
000042r 1  20 rr rr       jsr KeyPoll                   ; C=1 -> a keypad key was pressed
000045r 1  90 FB          bcc @WaitStart                ; (the press is consumed, just dismisses splash)
000047r 1  20 rr rr       jsr RefreshDisplay            ; first paint of the monitor screen
00004Ar 1  4C rr rr       jmp MonitorLoop
00004Dr 1               
00004Dr 1               
00004Dr 1               ; =============================================================================
00004Dr 1               ;   MONITOR STATE MACHINE
00004Dr 1               ; =============================================================================
00004Dr 1               ;   A KIM-1-style memory monitor.  The display shows the current address and
00004Dr 1               ;   the byte stored there; the keypad navigates, edits, and executes.
00004Dr 1               ;
00004Dr 1               ;     LEFT / RIGHT   address -1 / +1
00004Dr 1               ;     PGUP / PGDN    address +$0100 / -$0100
00004Dr 1               ;     0-F            INS off: shift a hex nibble into the address (KIM-1 style)
00004Dr 1               ;                    INS on : shift a hex nibble into the byte at the address
00004Dr 1               ;     INS            toggle edit mode
00004Dr 1               ;     DEL            zero the byte at the address, cancel edit mode
00004Dr 1               ;     UP             execute via JSR (jmp (CUR_ADDR)); RTS returns to monitor
00004Dr 1               ;     ESC            break-to-monitor abort (handled in KeyIrq -> WarmStart)
00004Dr 1               ; =============================================================================
00004Dr 1               
00004Dr 1               ; -----------------------------------------------------------------------------
00004Dr 1               ;   WarmStart — break-to-monitor abort target
00004Dr 1               ; -----------------------------------------------------------------------------
00004Dr 1               ;   Entered by JMP from KeyIrq when an ESC arrives from EITHER source — the
00004Dr 1               ;   keypad ESC key or an ESC byte over serial — from anywhere, including a
00004Dr 1               ;   program launched with keypad UP or with the serial "R" command.  The
00004Dr 1               ;   interrupted stack frame is abandoned: ESC is a panic "return to the
00004Dr 1               ;   monitor" and does not restore the aborted caller.
00004Dr 1               ;
00004Dr 1               ;   Resets the stack pointer (the IRQ and whatever it interrupted are
00004Dr 1               ;   discarded), cancels any in-progress INS edit, flushes buffered serial
00004Dr 1               ;   input, re-enables interrupts (KeyIrq was entered with I set), repaints the
00004Dr 1               ;   keypad monitor (LCD) and re-arms the serial monitor with a fresh prompt,
00004Dr 1               ;   then re-enters the monitor loop.
00004Dr 1               ; -----------------------------------------------------------------------------
00004Dr 1               WarmStart:
00004Dr 1  A2 FF          ldx #$ff
00004Fr 1  9A             txs                           ; discard the interrupted stack frame
000050r 1  64 42          stz MODE                      ; cancel any in-progress INS edit
000052r 1  A5 46          lda SER_RXHEAD                ; flush any buffered serial input (still inside
000054r 1  85 47          sta SER_RXTAIL                ;   the IRQ-masked window so KeyIrq can't race)
000056r 1  64 51          stz SER_DIRTY
000058r 1  58             cli                           ; KeyIrq left I set — re-enable IRQs
000059r 1  20 rr rr       jsr RefreshDisplay            ; repaint the keypad monitor (LCD)
00005Cr 1  20 rr rr       jsr SerPrompt                 ; and re-arm the serial monitor (fresh prompt)
00005Fr 1  4C rr rr       jmp MonitorLoop
000062r 1               
000062r 1               ; -----------------------------------------------------------------------------
000062r 1               ;   MonitorLoop — cooperative poll of both inputs
000062r 1               ; -----------------------------------------------------------------------------
000062r 1               ;   The keypad and the Wozmon serial monitor run concurrently from this one
000062r 1               ;   loop; neither input blocks.  A keypad press is dispatched and repaints the
000062r 1               ;   LCD.  Serial bytes are drained one at a time into the Wozmon line parser;
000062r 1               ;   when a serial line deposits into memory the SER_DIRTY flag triggers a
000062r 1               ;   refresh so the change shows on the LCD at the current address.
000062r 1               ; -----------------------------------------------------------------------------
000062r 1               MonitorLoop:
000062r 1  20 rr rr       jsr KeyPoll                   ; C=1 -> A = keycode (0-23)
000065r 1  90 06          bcc @Serial
000067r 1  20 rr rr       jsr Dispatch
00006Ar 1  20 rr rr       jsr RefreshDisplay
00006Dr 1               @Serial:
00006Dr 1  20 rr rr       jsr SerService                ; process up to one pending serial byte
000070r 1  A5 51          lda SER_DIRTY                 ; did a serial deposit change memory?
000072r 1  F0 EE          beq MonitorLoop
000074r 1  64 51          stz SER_DIRTY
000076r 1  20 rr rr       jsr RefreshDisplay            ; reflect the serial deposit on the LCD
000079r 1  80 E7          bra MonitorLoop
00007Br 1               
00007Br 1               ; -----------------------------------------------------------------------------
00007Br 1               ;   Dispatch — act on a keycode
00007Br 1               ;   In: A = keycode (0-23)
00007Br 1               ;   Modifies: A, X, Y
00007Br 1               ; -----------------------------------------------------------------------------
00007Br 1               Dispatch:
00007Br 1  C9 00          cmp #KEY_LEFT
00007Dr 1  F0 28          beq DoLeft
00007Fr 1  C9 0B          cmp #KEY_RIGHT
000081r 1  F0 2D          beq DoRight
000083r 1  C9 12          cmp #KEY_PGUP
000085r 1  F0 30          beq DoPgUp
000087r 1  C9 16          cmp #KEY_PGDN
000089r 1  F0 2F          beq DoPgDn
00008Br 1  C9 11          cmp #KEY_INS
00008Dr 1  F0 2E          beq DoIns
00008Fr 1  C9 15          cmp #KEY_DEL
000091r 1  F0 31          beq DoDel
000093r 1  C9 14          cmp #KEY_UP
000095r 1  F0 36          beq DoUp
000097r 1  20 rr rr       jsr KeyToHex                  ; hex digit?  C=1 -> A = nibble (0-15)
00009Ar 1  90 0A          bcc @Done                     ; non-hex key: ignore
00009Cr 1  A6 42          ldx MODE
00009Er 1  D0 03          bne @EditData                 ; INS on: edit the byte at the address
0000A0r 1  4C rr rr       jmp ShiftAddrNibble           ; INS off: shift the nibble into the address
0000A3r 1               @EditData:
0000A3r 1  4C rr rr       jmp ShiftDataNibble
0000A6r 1               @Done:
0000A6r 1  60             rts
0000A7r 1               
0000A7r 1               ; --- Navigation -------------------------------------------------------------
0000A7r 1               DoLeft:
0000A7r 1  A5 40          lda CUR_ADDR
0000A9r 1  D0 02          bne @NoBorrow
0000ABr 1  C6 41          dec CUR_ADDR + 1
0000ADr 1               @NoBorrow:
0000ADr 1  C6 40          dec CUR_ADDR
0000AFr 1  60             rts
0000B0r 1               
0000B0r 1               DoRight:
0000B0r 1  E6 40          inc CUR_ADDR
0000B2r 1  D0 02          bne @Done
0000B4r 1  E6 41          inc CUR_ADDR + 1
0000B6r 1               @Done:
0000B6r 1  60             rts
0000B7r 1               
0000B7r 1               DoPgUp:
0000B7r 1  E6 41          inc CUR_ADDR + 1              ; +$0100
0000B9r 1  60             rts
0000BAr 1               
0000BAr 1               DoPgDn:
0000BAr 1  C6 41          dec CUR_ADDR + 1              ; -$0100
0000BCr 1  60             rts
0000BDr 1               
0000BDr 1               ; --- Mode / edit ------------------------------------------------------------
0000BDr 1               DoIns:
0000BDr 1  A5 42          lda MODE
0000BFr 1  49 01          eor #MODE_INS                 ; toggle the edit-mode flag
0000C1r 1  85 42          sta MODE
0000C3r 1  60             rts
0000C4r 1               
0000C4r 1               DoDel:
0000C4r 1  A9 00          lda #$00
0000C6r 1  A0 00          ldy #$00
0000C8r 1  91 40          sta (CUR_ADDR),y              ; zero the byte at the address
0000CAr 1  64 42          stz MODE                      ; cancel edit mode
0000CCr 1  60             rts
0000CDr 1               
0000CDr 1               ; --- Execute ----------------------------------------------------------------
0000CDr 1               DoUp:
0000CDr 1  20 rr rr       jsr CallUser                  ; jmp (CUR_ADDR); user RTS returns here
0000D0r 1  60             rts
0000D1r 1               
0000D1r 1               CallUser:
0000D1r 1  6C 40 00       jmp (CUR_ADDR)
0000D4r 1               
0000D4r 1               ; -----------------------------------------------------------------------------
0000D4r 1               ;   ShiftAddrNibble — shift one hex nibble into CUR_ADDR (KIM-1 style)
0000D4r 1               ;   In: A = nibble (low 4 bits)
0000D4r 1               ;   Modifies: A, X
0000D4r 1               ; -----------------------------------------------------------------------------
0000D4r 1               ShiftAddrNibble:
0000D4r 1  48             pha
0000D5r 1  A2 04          ldx #$04                      ; CUR_ADDR <<= 4 (16-bit)
0000D7r 1               @Shift:
0000D7r 1  06 40          asl CUR_ADDR
0000D9r 1  26 41          rol CUR_ADDR + 1
0000DBr 1  CA             dex
0000DCr 1  D0 F9          bne @Shift
0000DEr 1  68             pla
0000DFr 1  05 40          ora CUR_ADDR                  ; OR the new nibble into the low byte
0000E1r 1  85 40          sta CUR_ADDR
0000E3r 1  60             rts
0000E4r 1               
0000E4r 1               ; -----------------------------------------------------------------------------
0000E4r 1               ;   ShiftDataNibble — shift one hex nibble into the byte at CUR_ADDR
0000E4r 1               ;   In: A = nibble (low 4 bits)
0000E4r 1               ;   Modifies: A, Y
0000E4r 1               ; -----------------------------------------------------------------------------
0000E4r 1               ShiftDataNibble:
0000E4r 1  85 43          sta MON_TMP
0000E6r 1  A0 00          ldy #$00
0000E8r 1  B1 40          lda (CUR_ADDR),y
0000EAr 1  0A             asl a                         ; old byte <<= 4
0000EBr 1  0A             asl a
0000ECr 1  0A             asl a
0000EDr 1  0A             asl a
0000EEr 1  05 43          ora MON_TMP                   ; OR in the new nibble
0000F0r 1  91 40          sta (CUR_ADDR),y
0000F2r 1  60             rts
0000F3r 1               
0000F3r 1               ; -----------------------------------------------------------------------------
0000F3r 1               ;   RefreshDisplay — render the monitor screen
0000F3r 1               ;   Line 1: ---$XXXX: $XX---   (address and the byte stored there)
0000F3r 1               ;   Line 2: 16 dashes, or a centered "INS" indicator when editing
0000F3r 1               ;   Modifies: A, X, Y
0000F3r 1               ; -----------------------------------------------------------------------------
0000F3r 1               RefreshDisplay:
0000F3r 1  A2 00          ldx #$00
0000F5r 1  A0 00          ldy #$00
0000F7r 1  20 rr rr       jsr LcdSetPos                 ; line 1, column 0
0000FAr 1               
0000FAr 1  A2 03          ldx #$03                      ; "---"
0000FCr 1  20 rr rr       jsr PrintDashN
0000FFr 1  A9 24          lda #'$'
000101r 1  20 rr rr       jsr LcdData
000104r 1  A5 41          lda CUR_ADDR + 1              ; address (high byte first)
000106r 1  20 rr rr       jsr PrintHexByte
000109r 1  A5 40          lda CUR_ADDR
00010Br 1  20 rr rr       jsr PrintHexByte
00010Er 1  A9 3A          lda #':'
000110r 1  20 rr rr       jsr LcdData
000113r 1  A9 20          lda #CHAR_SPACE
000115r 1  20 rr rr       jsr LcdData
000118r 1  A9 24          lda #'$'
00011Ar 1  20 rr rr       jsr LcdData
00011Dr 1  A0 00          ldy #$00                      ; byte at the current address
00011Fr 1  B1 40          lda (CUR_ADDR),y
000121r 1  20 rr rr       jsr PrintHexByte
000124r 1  A2 03          ldx #$03                      ; "---"
000126r 1  20 rr rr       jsr PrintDashN
000129r 1               
000129r 1  A2 00          ldx #$00
00012Br 1  A0 01          ldy #$01
00012Dr 1  20 rr rr       jsr LcdSetPos                 ; line 2, column 0
000130r 1  A5 42          lda MODE
000132r 1  D0 06          bne @Ins
000134r 1  A2 10          ldx #$10                      ; 16 dashes
000136r 1  20 rr rr       jsr PrintDashN
000139r 1  60             rts
00013Ar 1               @Ins:
00013Ar 1  A2 06          ldx #$06                      ; 6 dashes + "INS" + 7 dashes = 16
00013Cr 1  20 rr rr       jsr PrintDashN
00013Fr 1  A9 49          lda #'I'
000141r 1  20 rr rr       jsr LcdData
000144r 1  A9 4E          lda #'N'
000146r 1  20 rr rr       jsr LcdData
000149r 1  A9 53          lda #'S'
00014Br 1  20 rr rr       jsr LcdData
00014Er 1  A2 07          ldx #$07
000150r 1  20 rr rr       jsr PrintDashN
000153r 1  60             rts
000154r 1               
000154r 1               ; -----------------------------------------------------------------------------
000154r 1               ;   PrintDashN — print X dash characters
000154r 1               ;   In: X = count
000154r 1               ;   Modifies: A, X, Y
000154r 1               ; -----------------------------------------------------------------------------
000154r 1               PrintDashN:
000154r 1               @Loop:
000154r 1  E0 00          cpx #$00
000156r 1  F0 0A          beq @Done
000158r 1  DA             phx                           ; LcdData (via LcdDelay) clobbers X/Y
000159r 1  A9 2D          lda #'-'
00015Br 1  20 rr rr       jsr LcdData
00015Er 1  FA             plx
00015Fr 1  CA             dex
000160r 1  80 F2          bra @Loop
000162r 1               @Done:
000162r 1  60             rts
000163r 1               
000163r 1               ; -----------------------------------------------------------------------------
000163r 1               ;   ShowSplash — clear the display and render the splash screen
000163r 1               ;   Modifies: A, X, Y
000163r 1               ; -----------------------------------------------------------------------------
000163r 1               ShowSplash:
000163r 1  20 rr rr       jsr LcdClear
000166r 1  A2 00          ldx #$00
000168r 1  A0 00          ldy #$00
00016Ar 1  20 rr rr       jsr LcdSetPos
00016Dr 1  A9 rr          lda #<SplashL1
00016Fr 1  85 02          sta STR_PTR
000171r 1  A9 rr          lda #>SplashL1
000173r 1  85 03          sta STR_PTR + 1
000175r 1  20 rr rr       jsr LcdPrintStr
000178r 1  A2 00          ldx #$00
00017Ar 1  A0 01          ldy #$01
00017Cr 1  20 rr rr       jsr LcdSetPos
00017Fr 1  A9 rr          lda #<SplashL2
000181r 1  85 02          sta STR_PTR
000183r 1  A9 rr          lda #>SplashL2
000185r 1  85 03          sta STR_PTR + 1
000187r 1  20 rr rr       jsr LcdPrintStr
00018Ar 1  60             rts
00018Br 1               
00018Br 1               
00018Br 1               ; =============================================================================
00018Br 1               ;   LCD DRIVER
00018Br 1               ; =============================================================================
00018Br 1               ;   HD44780-compatible 16x2 display in 8-bit mode.  Port B carries the data
00018Br 1               ;   bus; Port A carries RS/R-W/E on PA5/PA6/PA7.  Command/data writes use
00018Br 1               ;   timed software delays instead of busy-flag polling (the R/W read-back
00018Br 1               ;   path is not relied upon).
00018Br 1               ; =============================================================================
00018Br 1               
00018Br 1               ; -----------------------------------------------------------------------------
00018Br 1               ;   LcdDelay — short software busy delay (~640 us @ 1 MHz)
00018Br 1               ; -----------------------------------------------------------------------------
00018Br 1               ;   Used in place of busy-flag polling so the driver does not depend on the
00018Br 1               ;   LCD R/W read-back path (PA6) working.  An HD44780 finishes a normal
00018Br 1               ;   command/data write in ~37 us, so this single ~640 us loop carries a wide
00018Br 1               ;   margin while staying short enough that a full RefreshDisplay (~34 writes)
00018Br 1               ;   completes in ~22 ms — fast enough to keep the keypad responsive.  Callers
00018Br 1               ;   add LcdLongDelay for the slow clear/home commands (~1.5 ms).
00018Br 1               ;   Modifies: A, X
00018Br 1               ; -----------------------------------------------------------------------------
00018Br 1               LcdDelay:
00018Br 1  A2 80          ldx #$80                      ; 128 * 5 cycles ≈ 640 us @ 1 MHz
00018Dr 1               @Loop:
00018Dr 1  CA             dex
00018Er 1  D0 FD          bne @Loop
000190r 1  60             rts
000191r 1               
000191r 1               ; -----------------------------------------------------------------------------
000191r 1               ;   LcdLongDelay — generous software delay for the power-on init ritual
000191r 1               ; -----------------------------------------------------------------------------
000191r 1               ;   Covers the HD44780 power-on timing (>15 ms first delay, >4.1 ms / >100 us
000191r 1               ;   between the function-set writes) and the slow clear/home commands (~1.5 ms).
000191r 1               ;   Self-contained — does not depend on KernalInit / SysDelay (and therefore
000191r 1               ;   not on HW_PRESENT / the VIA timer).  ~41 ms @ 1 MHz: comfortably above the
000191r 1               ;   >15 ms power-on minimum, yet short enough that boot (run with IRQs masked)
000191r 1               ;   no longer swallows early ESC presses.
000191r 1               ;   Modifies: A, X, Y
000191r 1               ; -----------------------------------------------------------------------------
000191r 1               LcdLongDelay:
000191r 1  A2 20          ldx #$20                      ; 32 * 256 * 5 cycles ≈ 41 ms @ 1 MHz
000193r 1               @Outer:
000193r 1  A0 00          ldy #$00
000195r 1               @Inner:
000195r 1  88             dey
000196r 1  D0 FD          bne @Inner
000198r 1  CA             dex
000199r 1  D0 F8          bne @Outer
00019Br 1  60             rts
00019Cr 1               
00019Cr 1               ; -----------------------------------------------------------------------------
00019Cr 1               ;   LcdStrobe — pulse E high then low (data already on Port B, RS/R-W in A)
00019Cr 1               ; -----------------------------------------------------------------------------
00019Cr 1               ;   In: A = Port A control value with E low (RS/R-W set, LCD_E clear)
00019Cr 1               ;   Modifies: A
00019Cr 1               ; -----------------------------------------------------------------------------
00019Cr 1               LcdStrobe:
00019Cr 1  8D 00 C0       sta PORTA                     ; control lines, E low
00019Fr 1  09 80          ora #LCD_E
0001A1r 1  8D 00 C0       sta PORTA                     ; E high
0001A4r 1  29 7F          and #<~LCD_E
0001A6r 1  8D 00 C0       sta PORTA                     ; E low — LCD latches on falling edge
0001A9r 1  60             rts
0001AAr 1               
0001AAr 1               ; -----------------------------------------------------------------------------
0001AAr 1               ;   LcdCmd — write a command byte (RS=0)
0001AAr 1               ;   In: A = command
0001AAr 1               ;   Modifies: A, X, Y
0001AAr 1               ; -----------------------------------------------------------------------------
0001AAr 1               LcdCmd:
0001AAr 1  8D 02 C0       sta PORTB                     ; command byte on the data bus
0001ADr 1  A9 00          lda #$00                      ; RS=0, R/W=0, E=0
0001AFr 1  20 rr rr       jsr LcdStrobe
0001B2r 1  20 rr rr       jsr LcdDelay
0001B5r 1  60             rts
0001B6r 1               
0001B6r 1               ; -----------------------------------------------------------------------------
0001B6r 1               ;   LcdData — write a data byte (RS=1)
0001B6r 1               ;   In: A = data
0001B6r 1               ;   Modifies: A, X, Y
0001B6r 1               ; -----------------------------------------------------------------------------
0001B6r 1               LcdData:
0001B6r 1  8D 02 C0       sta PORTB                     ; data byte on the data bus
0001B9r 1  A9 20          lda #LCD_RS                   ; RS=1, R/W=0, E=0
0001BBr 1  20 rr rr       jsr LcdStrobe
0001BEr 1  20 rr rr       jsr LcdDelay
0001C1r 1  60             rts
0001C2r 1               
0001C2r 1               ; -----------------------------------------------------------------------------
0001C2r 1               ;   LcdCmdRaw — write a command byte (alias of LcdCmd)
0001C2r 1               ;   Retained for the power-on function-set sequence which adds its own
0001C2r 1               ;   longer inter-command delays via LcdLongDelay.
0001C2r 1               ;   In: A = command
0001C2r 1               ;   Modifies: A, X, Y
0001C2r 1               ; -----------------------------------------------------------------------------
0001C2r 1               LcdCmdRaw = LcdCmd
0001C2r 1               
0001C2r 1               ; -----------------------------------------------------------------------------
0001C2r 1               ;   LcdInit — power-on initialization sequence
0001C2r 1               ;   Configures the PIA ports the LCD needs, then runs the HD44780 8-bit
0001C2r 1               ;   init: function set (2-line, 5x8), display on, clear, entry-mode increment.
0001C2r 1               ;   Uses software delays only — no KernalInit / SysDelay dependency.
0001C2r 1               ;   Modifies: A, X, Y
0001C2r 1               ; -----------------------------------------------------------------------------
0001C2r 1               LcdInit:
0001C2r 1                 ; Port A: PA5-7 outputs (LCD control), PA0-4 inputs (keypad code)
0001C2r 1  A9 00          lda #CR_DDR
0001C4r 1  8D 01 C0       sta CRA
0001C7r 1  A9 E0          lda #LCD_DDRA
0001C9r 1  8D 00 C0       sta PORTA                     ; (DDRA) = $E0
0001CCr 1  A9 04          lda #CR_PORT
0001CEr 1  8D 01 C0       sta CRA
0001D1r 1  A9 00          lda #$00
0001D3r 1  8D 00 C0       sta PORTA                     ; control lines low (RS=0, R/W=0, E=0)
0001D6r 1               
0001D6r 1                 ; Port B: all outputs (LCD data bus)
0001D6r 1  A9 00          lda #CR_DDR
0001D8r 1  8D 03 C0       sta CRB
0001DBr 1  A9 FF          lda #$FF
0001DDr 1  8D 02 C0       sta PORTB                     ; (DDRB) all outputs
0001E0r 1  A9 04          lda #CR_PORT
0001E2r 1  8D 03 C0       sta CRB
0001E5r 1               
0001E5r 1                 ; Power-on settle: > 15 ms
0001E5r 1  20 rr rr       jsr LcdLongDelay
0001E8r 1               
0001E8r 1                 ; Function set x3 with long inter-command delays (HD44780 reset ritual)
0001E8r 1  A9 30          lda #$30
0001EAr 1  20 rr rr       jsr LcdCmdRaw
0001EDr 1  20 rr rr       jsr LcdLongDelay              ; > 4.1 ms
0001F0r 1  A9 30          lda #$30
0001F2r 1  20 rr rr       jsr LcdCmdRaw
0001F5r 1  20 rr rr       jsr LcdLongDelay              ; > 100 us
0001F8r 1  A9 30          lda #$30
0001FAr 1  20 rr rr       jsr LcdCmdRaw
0001FDr 1  20 rr rr       jsr LcdLongDelay
000200r 1               
000200r 1                 ; Remaining configuration commands (each followed by LcdDelay)
000200r 1  A9 38          lda #$38                      ; function set: 8-bit, 2-line, 5x8 font
000202r 1  20 rr rr       jsr LcdCmd
000205r 1  A9 08          lda #$08                      ; display off
000207r 1  20 rr rr       jsr LcdCmd
00020Ar 1  A9 01          lda #$01                      ; clear display
00020Cr 1  20 rr rr       jsr LcdCmd
00020Fr 1  20 rr rr       jsr LcdLongDelay              ; clear is slow (~1.5 ms) — extra settle
000212r 1  A9 06          lda #$06                      ; entry mode: increment, no display shift
000214r 1  20 rr rr       jsr LcdCmd
000217r 1  A9 0C          lda #$0C                      ; display on, cursor off, blink off
000219r 1  20 rr rr       jsr LcdCmd
00021Cr 1  60             rts
00021Dr 1               
00021Dr 1               ; -----------------------------------------------------------------------------
00021Dr 1               ;   LcdClear — clear the display and home the cursor
00021Dr 1               ;   Modifies: A, X
00021Dr 1               ; -----------------------------------------------------------------------------
00021Dr 1               LcdClear:
00021Dr 1  A9 01          lda #$01
00021Fr 1  20 rr rr       jsr LcdCmd
000222r 1  20 rr rr       jsr LcdLongDelay              ; clear/home is slow (~1.5 ms) — LcdDelay alone
000225r 1  60             rts                           ;   is now too short to cover it
000226r 1               
000226r 1               ; -----------------------------------------------------------------------------
000226r 1               ;   LcdSetPos — move the cursor to (column, row)
000226r 1               ;   In: X = column (0-15), Y = row (0-1)
000226r 1               ;   Modifies: A, X
000226r 1               ; -----------------------------------------------------------------------------
000226r 1               LcdSetPos:
000226r 1  8A             txa
000227r 1  C0 00          cpy #$00
000229r 1  F0 03          beq @Row1
00022Br 1  18             clc
00022Cr 1  69 40          adc #$40                      ; row 2 DDRAM base offset
00022Er 1               @Row1:
00022Er 1  09 80          ora #$80                      ; "Set DDRAM address" command
000230r 1  20 rr rr       jsr LcdCmd
000233r 1  60             rts
000234r 1               
000234r 1               ; -----------------------------------------------------------------------------
000234r 1               ;   LcdPrintStr — print a null-terminated string
000234r 1               ;   In: STR_PTR ($02-$03) = pointer to string
000234r 1               ;   Modifies: A, X, Y
000234r 1               ; -----------------------------------------------------------------------------
000234r 1               LcdPrintStr:
000234r 1  A0 00          ldy #$00
000236r 1               @Loop:
000236r 1  B1 02          lda (STR_PTR),y
000238r 1  F0 08          beq @Done                     ; null terminator
00023Ar 1  5A             phy                           ; LcdData (via delays) clobbers Y
00023Br 1  20 rr rr       jsr LcdData
00023Er 1  7A             ply
00023Fr 1  C8             iny
000240r 1  D0 F4          bne @Loop                     ; max 256 chars per call
000242r 1               @Done:
000242r 1  60             rts
000243r 1               
000243r 1               ; -----------------------------------------------------------------------------
000243r 1               ;   PrintHexNib — print the low nibble of A as a hex digit
000243r 1               ;   In: A = value (low nibble used)
000243r 1               ;   Modifies: A, X
000243r 1               ; -----------------------------------------------------------------------------
000243r 1               PrintHexNib:
000243r 1  29 0F          and #$0F
000245r 1  C9 0A          cmp #$0A
000247r 1  90 04          bcc @Digit
000249r 1  69 36          adc #$36                      ; C=1: 10..15 + $37 -> 'A'..'F'
00024Br 1  D0 02          bne @Send                     ; result always nonzero
00024Dr 1               @Digit:
00024Dr 1  69 30          adc #$30                      ; C=0: 0..9 + $30 -> '0'..'9'
00024Fr 1               @Send:
00024Fr 1  20 rr rr       jsr LcdData
000252r 1  60             rts
000253r 1               
000253r 1               ; -----------------------------------------------------------------------------
000253r 1               ;   PrintHexByte — print A as two hex digits
000253r 1               ;   In: A = byte
000253r 1               ;   Modifies: A, X
000253r 1               ; -----------------------------------------------------------------------------
000253r 1               PrintHexByte:
000253r 1  48             pha
000254r 1  4A             lsr a
000255r 1  4A             lsr a
000256r 1  4A             lsr a
000257r 1  4A             lsr a
000258r 1  20 rr rr       jsr PrintHexNib               ; high nibble
00025Br 1  68             pla
00025Cr 1  20 rr rr       jsr PrintHexNib               ; low nibble
00025Fr 1  60             rts
000260r 1               
000260r 1               ; -----------------------------------------------------------------------------
000260r 1               ;   PrintHexWord — print a 16-bit value as four hex digits (high byte first)
000260r 1               ;   In: X = high byte, A = low byte
000260r 1               ;   Modifies: A, X
000260r 1               ; -----------------------------------------------------------------------------
000260r 1               PrintHexWord:
000260r 1  48             pha
000261r 1  8A             txa
000262r 1  20 rr rr       jsr PrintHexByte              ; high byte
000265r 1  68             pla
000266r 1  20 rr rr       jsr PrintHexByte              ; low byte
000269r 1  60             rts
00026Ar 1               
00026Ar 1               
00026Ar 1               ; =============================================================================
00026Ar 1               ;   KEYPAD DRIVER
00026Ar 1               ; =============================================================================
00026Ar 1               ;   The 74C922 keypad encoder drives PA0-PA4 with a 5-bit keycode and pulses
00026Ar 1               ;   CA1 (positive edge) when a key becomes available.  CA2 is held low to
00026Ar 1               ;   enable the encoder's active-low output enable.  Key entry is interrupt
00026Ar 1               ;   driven: the CA1 edge fires KeyIrq, which latches the keycode into a small
00026Ar 1               ;   mailbox (KEY_CODE/KEY_READY) that the monitor loop drains via KeyWait.
00026Ar 1               ; =============================================================================
00026Ar 1               
00026Ar 1               ; -----------------------------------------------------------------------------
00026Ar 1               ;   PiaInit — configure the PIA for keypad input (and Port B for LCD data)
00026Ar 1               ; -----------------------------------------------------------------------------
00026Ar 1               ;   Sets DDRA so PA5-7 are outputs (LCD control) and PA0-4 inputs (keycode),
00026Ar 1               ;   DDRB all outputs (LCD data bus), then writes the keypad CRA value which
00026Ar 1               ;   enables the 74C922 (CA2 low) and arms CA1 on the positive edge with its
00026Ar 1               ;   interrupt ENABLED.  The CPU IRQ must stay masked until the caller is
00026Ar 1               ;   ready — CartReset CLIs only after this returns.  Reads PORTA once to clear
00026Ar 1               ;   any stale CA1 flag.  Must be called AFTER LcdInit (leaves CRA on PORT).
00026Ar 1               ;   Modifies: A
00026Ar 1               ; -----------------------------------------------------------------------------
00026Ar 1               PiaInit:
00026Ar 1                 ; Port A direction: PA5-7 outputs, PA0-4 inputs
00026Ar 1  A9 00          lda #CR_DDR
00026Cr 1  8D 01 C0       sta CRA
00026Fr 1  A9 E0          lda #LCD_DDRA                 ; $E0
000271r 1  8D 00 C0       sta PORTA                     ; (DDRA)
000274r 1               
000274r 1                 ; Port B direction: all outputs (LCD data bus)
000274r 1  A9 00          lda #CR_DDR
000276r 1  8D 03 C0       sta CRB
000279r 1  A9 FF          lda #$FF
00027Br 1  8D 02 C0       sta PORTB                     ; (DDRB)
00027Er 1  A9 04          lda #CR_PORT
000280r 1  8D 03 C0       sta CRB                       ; select PORTB data register
000283r 1               
000283r 1                 ; Port A control: CA2 manual output low (74C922 OE), CA1 positive edge,
000283r 1                 ; CA1 IRQ enabled, PORTA data register selected
000283r 1  A9 37          lda #PIA_CRA_KEYPAD           ; $37
000285r 1  8D 01 C0       sta CRA
000288r 1               
000288r 1  AD 00 C0       lda PORTA                     ; clear any pending CA1 flag
00028Br 1  60             rts
00028Cr 1               
00028Cr 1               ; -----------------------------------------------------------------------------
00028Cr 1               ;   KeyIrq — CA1 (keypad data-available) interrupt handler
00028Cr 1               ; -----------------------------------------------------------------------------
00028Cr 1               ;   Installed in IRQ_PTR by CartReset and reached through the IRQ vector
00028Cr 1               ;   trampoline (jmp (IRQ_PTR)).  Because the cartridge owns the IRQ, this
00028Cr 1               ;   handler also dispatches BRK (which shares the vector) to BRK_PTR so
00028Cr 1               ;   executed user code keeps its clean-return behaviour.
00028Cr 1               ;
00028Cr 1               ;   The IRQ has two sources sharing the line: the R65C51 serial RX
00028Cr 1               ;   and the keypad CA1 edge.  Serial is serviced first so a fast host stream
00028Cr 1               ;   is never dropped while a key is also pending: if SC_STATUS shows RDRF, the
00028Cr 1               ;   byte is read; an ESC byte triggers a break-to-monitor abort (WarmStart),
00028Cr 1               ;   any other byte is pushed into the SER_RXBUF ring.  The serial half is
00028Cr 1               ;   skipped entirely when no Serial Card was probed (HW_SC clear), so a
00028Cr 1               ;   keypad-only machine never reads a floating bus here.  Then, on a keypad CA1
00028Cr 1               ;   edge it reads PORTA *once*, right at the data-available edge where the
00028Cr 1               ;   74C922 outputs are valid, masks the 5-bit keycode, rejects out-of-range
00028Cr 1               ;   phantom codes, and either aborts on the ESC key or stores the keycode in
00028Cr 1               ;   the KEY_CODE/KEY_READY mailbox.  Reading PORTA clears the CA1 flag.
00028Cr 1               ;   Modifies: nothing visible (saves/restores A and X)
00028Cr 1               ; -----------------------------------------------------------------------------
00028Cr 1               KeyIrq:
00028Cr 1  48             pha
00028Dr 1  DA             phx
00028Er 1  BA             tsx
00028Fr 1  BD 03 01       lda $0103,x                   ; stacked processor status (P)
000292r 1  29 10          and #$10                      ; B flag set -> this was a BRK, not an IRQ
000294r 1  D0 3B          bne @Brk
000296r 1               
000296r 1                 ; Two sources share the CPU /IRQ line: the keypad PIA (CA1 edge) and the
000296r 1                 ; R65C51 ACIA (serial RX).  Both are serviced every entry, and the loop
000296r 1                 ; below keeps draining until neither has work pending — this is what keeps a
000296r 1                 ; break-to-monitor ESC reliable from *either* source while a launched program
000296r 1                 ; is running (the cooperative main loop, and thus the SerFeed parser, is
000296r 1                 ; suspended then, so ESC must be caught here in the ISR).  The keypad is
000296r 1                 ; checked first because that path is the proven one; the serial
000296r 1                 ; drain loop guarantees a serial ESC can never be stranded behind an ACIA
000296r 1                 ; receive overrun.
000296r 1               @Scan:
000296r 1                 ; --- Keypad CA1 source ----------------------------------------------------
000296r 1  AD 01 C0       lda CRA
000299r 1  29 80          and #PIA_CA1_FLAG             ; keypad data-available?
00029Br 1  F0 13          beq @Serial                   ; no keypad edge — go drain the serial card
00029Dr 1  AD 00 C0       lda PORTA                     ; latch keycode (also clears the CA1 flag)
0002A0r 1  29 1F          and #KEY_MASK                 ; keep PA0-4 (0-31)
0002A2r 1  C9 10          cmp #KEY_ESC                  ; ESC is a break-to-monitor abort
0002A4r 1  F0 30          beq @Esc                      ; -> WarmStart, never reaches the mailbox
0002A6r 1  C9 18          cmp #KEY_COUNT
0002A8r 1  B0 06          bcs @Serial                   ; phantom code >= 24 — discard, still drain SC
0002AAr 1  85 44          sta KEY_CODE                  ; mailbox: keycode
0002ACr 1  A9 01          lda #$01
0002AEr 1  85 45          sta KEY_READY                 ; signal the monitor loop
0002B0r 1               
0002B0r 1                 ; --- Serial RX source (R65C51 ACIA) ---------------------------------------
0002B0r 1               @Serial:
0002B0r 1  AD 0D 03       lda HW_PRESENT
0002B3r 1  29 10          and #HW_SC                    ; no Serial Card -> $9001 is open bus, and a
0002B5r 1  F0 17          beq @Exit                     ;   floating RDRF would inject phantom bytes
0002B7r 1  AD 01 90       lda SC_STATUS                 ; reading status also clears the ACIA IRQ flag
0002BAr 1  29 08          and #SC_STATUS_RDRF           ; RX data register full?
0002BCr 1  F0 10          beq @Exit                     ; nothing buffered in the ACIA — done
0002BEr 1  AD 00 90       lda SC_DATA                   ; read it (clears RDRF / the overrun flag)
0002C1r 1  C9 1B          cmp #CHAR_ESC                 ; serial ESC is a break-to-monitor abort, just
0002C3r 1  F0 11          beq @Esc                      ;   like the keypad ESC key -> WarmStart
0002C5r 1  A6 46          ldx SER_RXHEAD
0002C7r 1  9D 00 04       sta SER_RXBUF,x               ; otherwise push the byte into the RX ring
0002CAr 1  E6 46          inc SER_RXHEAD                ; byte index wraps naturally at 256
0002CCr 1  80 C8          bra @Scan                     ; got a byte — re-scan both sources (drains the
0002CEr 1                                               ;   ACIA fully so a queued ESC is never missed)
0002CEr 1               @Exit:
0002CEr 1  FA             plx
0002CFr 1  68             pla
0002D0r 1  40             rti
0002D1r 1               @Brk:
0002D1r 1  FA             plx                           ; restore regs; leave P/PCL/PCH on the stack
0002D2r 1  68             pla
0002D3r 1  6C 02 03       jmp (BRK_PTR)                 ; BrkHandler RTIs back to the user code
0002D6r 1               @Esc:
0002D6r 1  4C rr rr       jmp WarmStart                 ; abandon the interrupted frame, re-enter monitor
0002D9r 1               
0002D9r 1               ; -----------------------------------------------------------------------------
0002D9r 1               ;   KeyPoll — non-blocking keypad read (drains the KeyIrq mailbox)
0002D9r 1               ;   Out: C=1 -> A = keycode (0-23);  C=0 -> no key pending (A undefined)
0002D9r 1               ;   Modifies: A
0002D9r 1               ; -----------------------------------------------------------------------------
0002D9r 1               KeyPoll:
0002D9r 1  A5 45          lda KEY_READY
0002DBr 1  F0 08          beq @None                     ; nothing latched
0002DDr 1  78             sei                           ; grab the mailbox atomically vs KeyIrq
0002DEr 1  A5 44          lda KEY_CODE
0002E0r 1  64 45          stz KEY_READY
0002E2r 1  58             cli
0002E3r 1  38             sec                           ; C=1: key available
0002E4r 1  60             rts
0002E5r 1               @None:
0002E5r 1  18             clc                           ; C=0: no key
0002E6r 1  60             rts
0002E7r 1               
0002E7r 1               ; -----------------------------------------------------------------------------
0002E7r 1               ;   KeyWait — block until a key is available
0002E7r 1               ;   Out: A = keycode (0-23)
0002E7r 1               ;   Modifies: A
0002E7r 1               ; -----------------------------------------------------------------------------
0002E7r 1               KeyWait:
0002E7r 1  20 rr rr       jsr KeyPoll
0002EAr 1  90 FB          bcc KeyWait
0002ECr 1  60             rts
0002EDr 1               
0002EDr 1               ; -----------------------------------------------------------------------------
0002EDr 1               ;   KeyToSym — translate a keycode to a printable LCD symbol
0002EDr 1               ;   In:  A = keycode (0-23)
0002EDr 1               ;   Out: A = display character
0002EDr 1               ;   Modifies: A, X
0002EDr 1               ; -----------------------------------------------------------------------------
0002EDr 1               KeyToSym:
0002EDr 1  AA             tax
0002EEr 1  BD rr rr       lda KeySymTable,x
0002F1r 1  60             rts
0002F2r 1               
0002F2r 1               
0002F2r 1               ; -----------------------------------------------------------------------------
0002F2r 1               ;   KeyToHex — translate a keycode to its hex nibble value
0002F2r 1               ; -----------------------------------------------------------------------------
0002F2r 1               ;   In:  A = keycode (0-23)
0002F2r 1               ;   Out: C=1 -> A = nibble (0-15) for a hex-digit key (0-9, A-F)
0002F2r 1               ;        C=0 -> the key is not a hex digit (A preserved as $FF)
0002F2r 1               ;   Modifies: A, X
0002F2r 1               ; -----------------------------------------------------------------------------
0002F2r 1               KeyToHex:
0002F2r 1  AA             tax
0002F3r 1  BD rr rr       lda HexValTable,x
0002F6r 1  C9 FF          cmp #$FF                      ; sentinel: not a hex digit
0002F8r 1  F0 02          beq @NotHex
0002FAr 1  38             sec                           ; C=1: A holds the nibble
0002FBr 1  60             rts
0002FCr 1               @NotHex:
0002FCr 1  18             clc                           ; C=0: not a hex key
0002FDr 1  60             rts
0002FEr 1               
0002FEr 1               
0002FEr 1               ; =============================================================================
0002FEr 1               ;   SERIAL WOZMON MONITOR
0002FEr 1               ; =============================================================================
0002FEr 1               ;   A Wozmon-compatible serial monitor that shares memory with the keypad
0002FEr 1               ;   monitor and runs concurrently with it.  The command language is a faithful
0002FEr 1               ;   re-implementation of Apple-1 Wozmon, so bin2woz output (deposit lines of
0002FEr 1               ;   the form "ADDR: BB BB ...") is accepted byte-for-byte.  The only change
0002FEr 1               ;   from the original is the prompt: "> " instead of "\".  All commands are
0002FEr 1               ;   unchanged:
0002FEr 1               ;
0002FEr 1               ;     XXXX            examine the byte at XXXX
0002FEr 1               ;     XXXX.YYYY       examine the block XXXX..YYYY
0002FEr 1               ;     XXXX: BB BB ..  deposit bytes starting at XXXX (auto-incrementing)
0002FEr 1               ;     XXXX R          run from XXXX (JMP, original Wozmon semantics)
0002FEr 1               ;
0002FEr 1               ;   The IRQ handler (KeyIrq) pushes received bytes into the SER_RXBUF ring;
0002FEr 1               ;   the cooperative main loop drains the ring through SerService one byte at a
0002FEr 1               ;   time so the keypad stays responsive during a host stream.
0002FEr 1               ;
0002FEr 1               ;   Faithfulness note: incoming bytes have bit 7 set before parsing, exactly as
0002FEr 1               ;   the Apple-1 keyboard delivered them, so Wozmon's original byte comparisons
0002FEr 1               ;   and hex-decode arithmetic work unmodified.  Output clears bit 7 (and maps
0002FEr 1               ;   CR -> CR/LF) on the way to the serial port.
0002FEr 1               ; =============================================================================
0002FEr 1               
0002FEr 1               ; -----------------------------------------------------------------------------
0002FEr 1               ;   SerInit — bring up the serial card and reset the Wozmon parser state
0002FEr 1               ;   Called from CartReset before interrupts are enabled.
0002FEr 1               ;
0002FEr 1               ;   The Serial Card is optional hardware, so the ACIA is only touched when the
0002FEr 1               ;   boot probe actually found one (HW_PRESENT bit HW_SC), matching the guarding
0002FEr 1               ;   convention the Kernal uses for every other card.  The parser state is reset
0002FEr 1               ;   either way, so the Ser* routines stay safe to call on a keypad-only build.
0002FEr 1               ;   Modifies: A
0002FEr 1               ; -----------------------------------------------------------------------------
0002FEr 1               SerInit:
0002FEr 1  AD 0D 03       lda HW_PRESENT
000301r 1  29 10          and #HW_SC                    ; Serial Card fitted?  (it is optional hardware)
000303r 1  F0 03          beq @NoCard                   ; no — leave $9000 alone, run keypad-only
000305r 1  20 4E A0       jsr InitSC                    ; BIOS: 8-N-1, 19200 baud, RX IRQ enabled
000308r 1               @NoCard:
000308r 1  64 46          stz SER_RXHEAD                ; empty RX ring
00030Ar 1  64 47          stz SER_RXTAIL
00030Cr 1  64 50          stz SER_IDX                   ; empty line buffer
00030Er 1  64 4F          stz WMODE                     ; XAM mode
000310r 1  64 51          stz SER_DIRTY
000312r 1  60             rts
000313r 1               
000313r 1               ; -----------------------------------------------------------------------------
000313r 1               ;   SerService — drain at most one byte from the RX ring into the parser
000313r 1               ;   Non-blocking.  Tail-calls SerFeed (which may run a full line on CR).
000313r 1               ;   Modifies: A, X, Y
000313r 1               ; -----------------------------------------------------------------------------
000313r 1               SerService:
000313r 1  20 rr rr       jsr SerGetChar
000316r 1  90 03          bcc @None
000318r 1  4C rr rr       jmp SerFeed                   ; tail-call: SerFeed returns to our caller
00031Br 1               @None:
00031Br 1  60             rts
00031Cr 1               
00031Cr 1               ; -----------------------------------------------------------------------------
00031Cr 1               ;   SerGetChar — pull one byte from the RX ring (filled by KeyIrq)
00031Cr 1               ;   Out: C=1 -> A = byte with bit 7 set (Apple-1 style); C=0 -> ring empty
00031Cr 1               ;   Modifies: A, X
00031Cr 1               ; -----------------------------------------------------------------------------
00031Cr 1               SerGetChar:
00031Cr 1  A5 47          lda SER_RXTAIL
00031Er 1  C5 46          cmp SER_RXHEAD
000320r 1  F0 0A          beq @Empty                    ; tail == head -> nothing buffered
000322r 1  AA             tax
000323r 1  BD 00 04       lda SER_RXBUF,x               ; fetch the oldest byte
000326r 1  E6 47          inc SER_RXTAIL                ; advance (wraps at 256)
000328r 1  09 80          ora #$80                      ; set bit 7 for the Wozmon parser
00032Ar 1  38             sec
00032Br 1  60             rts
00032Cr 1               @Empty:
00032Cr 1  18             clc
00032Dr 1  60             rts
00032Er 1               
00032Er 1               ; -----------------------------------------------------------------------------
00032Er 1               ;   SerFeed — accumulate one received byte into the line buffer
00032Er 1               ;   In: A = byte (bit 7 set).  Handles backspace / CR like Wozmon's character
00032Er 1               ;   loop; a CR runs the line through SerProcess.  ESC is NOT handled here — it
00032Er 1               ;   is consumed in the ISR (KeyIrq) as a break-to-monitor abort, so it never
00032Er 1               ;   reaches the RX ring or this parser.
00032Er 1               ;   Modifies: A, X, Y
00032Er 1               ; -----------------------------------------------------------------------------
00032Er 1               SerFeed:
00032Er 1  C9 DF          cmp #$DF                      ; "_" backspace (Apple-1)?
000330r 1  F0 25          beq @Bs
000332r 1  C9 88          cmp #$88                      ; BS ($08|$80)?
000334r 1  F0 21          beq @Bs
000336r 1  C9 FF          cmp #$FF                      ; DEL ($7F|$80)?
000338r 1  F0 1D          beq @Bs
00033Ar 1  A4 50          ldy SER_IDX
00033Cr 1  99 00 02       sta SER_LINEBUF,y             ; store into the line buffer
00033Fr 1  C9 8D          cmp #$8D                      ; CR ($0D|$80)?  (test before echo clobbers A)
000341r 1  F0 0B          beq @Cr
000343r 1  20 rr rr       jsr SerEcho                   ; echo the typed character
000346r 1  C8             iny
000347r 1  10 02          bpl @Store                    ; line < 128 chars — keep going
000349r 1  80 09          bra @Cancel                   ; over-long line: discard it, fresh prompt
00034Br 1               @Store:
00034Br 1  84 50          sty SER_IDX
00034Dr 1  60             rts
00034Er 1               @Cr:
00034Er 1  20 rr rr       jsr SerEcho                   ; echo CR -> CR/LF
000351r 1  4C rr rr       jmp SerProcess                ; parse and act on the completed line
000354r 1               @Cancel:
000354r 1  4C rr rr       jmp SerPrompt                 ; discard the line, fresh prompt
000357r 1               @Bs:
000357r 1  A4 50          ldy SER_IDX
000359r 1  F0 12          beq @BsDone                   ; already at the start — nothing to erase
00035Br 1  88             dey
00035Cr 1  84 50          sty SER_IDX
00035Er 1  A9 88          lda #$88                      ; visually erase on the terminal: BS, space, BS
000360r 1  20 rr rr       jsr SerEcho
000363r 1  A9 A0          lda #$A0                      ; space
000365r 1  20 rr rr       jsr SerEcho
000368r 1  A9 88          lda #$88
00036Ar 1  20 rr rr       jsr SerEcho
00036Dr 1               @BsDone:
00036Dr 1  60             rts
00036Er 1               
00036Er 1               ; -----------------------------------------------------------------------------
00036Er 1               ;   SerProcess — parse and execute a completed Wozmon line
00036Er 1               ; -----------------------------------------------------------------------------
00036Er 1               ;   Faithful port of the Apple-1 Wozmon line interpreter.  The line lives in
00036Er 1               ;   SER_LINEBUF, terminated by the CR ($8D) at SER_IDX.  Examine / block
00036Er 1               ;   examine / deposit / run all follow the original semantics exactly.
00036Er 1               ;   Modifies: A, X, Y
00036Er 1               ; -----------------------------------------------------------------------------
00036Er 1               SerProcess:
00036Er 1  A0 FF          ldy #$ff                      ; reset the text index (INY -> 0 below)
000370r 1  A9 00          lda #$00                      ; default XAM mode
000372r 1  AA             tax                           ; 0 -> X
000373r 1               @SetStor:
000373r 1  0A             asl a                         ; ":" arrives as $BA -> $74 (STOR); XAM stays 0
000374r 1               @SetMode:
000374r 1  85 4F          sta WMODE                     ; $00=XAM, $74=STOR, $AE=BLOCK XAM
000376r 1               @BlSkip:
000376r 1  C8             iny                           ; advance the text index
000377r 1               @NextItem:
000377r 1  B9 00 02       lda SER_LINEBUF,y             ; next character
00037Ar 1  C9 8D          cmp #$8D                      ; CR -> end of line
00037Cr 1  D0 03          bne @ChkDot
00037Er 1  4C rr rr       jmp SerPrompt                 ; line consumed — emit the next prompt
000381r 1               @ChkDot:
000381r 1  C9 AE          cmp #$AE                      ; "."?
000383r 1  90 F1          bcc @BlSkip                   ; below "." -> delimiter, skip it
000385r 1  F0 ED          beq @SetMode                  ; "." -> BLOCK XAM mode (A=$AE)
000387r 1  C9 BA          cmp #$BA                      ; ":"?
000389r 1  F0 E8          beq @SetStor                  ; ":" -> STOR mode (A=$BA)
00038Br 1  C9 D2          cmp #$D2                      ; "R"?
00038Dr 1  F0 3F          beq @Run                      ; run user program
00038Fr 1  86 4C          stx L                         ; clear the hex accumulator
000391r 1  86 4D          stx H
000393r 1  84 4E          sty YSAV                      ; remember where the number started
000395r 1               @NextHex:
000395r 1  B9 00 02       lda SER_LINEBUF,y             ; get a character for the hex test
000398r 1  49 B0          eor #$B0                      ; map "0".."9" to $0-$9
00039Ar 1  C9 0A          cmp #$0A                      ; decimal digit?
00039Cr 1  90 06          bcc @Dig
00039Er 1  69 88          adc #$88                      ; map "A".."F" to $FA-$FF
0003A0r 1  C9 FA          cmp #$FA                      ; valid hex letter?
0003A2r 1  90 11          bcc @NotHex                   ; no — not a hex character
0003A4r 1               @Dig:
0003A4r 1  0A             asl a
0003A5r 1  0A             asl a                         ; hex digit to the MSD of A
0003A6r 1  0A             asl a
0003A7r 1  0A             asl a
0003A8r 1  A2 04          ldx #$04                      ; shift count
0003AAr 1               @HexShift:
0003AAr 1  0A             asl a                         ; hex digit left, MSB into carry
0003ABr 1  26 4C          rol L                         ; rotate into the accumulator
0003ADr 1  26 4D          rol H
0003AFr 1  CA             dex
0003B0r 1  D0 F8          bne @HexShift
0003B2r 1  C8             iny                           ; advance the text index
0003B3r 1  D0 E0          bne @NextHex                  ; always taken (Y < 256)
0003B5r 1               @NotHex:
0003B5r 1  C4 4E          cpy YSAV                      ; were any hex digits given?
0003B7r 1  F0 18          beq @Escape                   ; none -> treat as ESC
0003B9r 1  24 4F          bit WMODE                     ; B6=1 STOR, B6=0 XAM/BLOCK
0003BBr 1  50 17          bvc @NotStor
0003BDr 1  A5 4C          lda L                         ; deposit: store the low byte
0003BFr 1  81 4A          sta (STL,x)                   ; X=0 -> via STH:STL
0003C1r 1  E6 4A          inc STL                       ; auto-increment the deposit address
0003C3r 1  D0 02          bne @Deposited
0003C5r 1  E6 4B          inc STH
0003C7r 1               @Deposited:
0003C7r 1  A9 01          lda #$01
0003C9r 1  85 51          sta SER_DIRTY                 ; memory changed — flag an LCD refresh
0003CBr 1  4C rr rr       jmp @NextItem
0003CEr 1               @Run:
0003CEr 1  6C 48 00       jmp (XAML)                    ; run at the last examined address (original R)
0003D1r 1               @Escape:
0003D1r 1  4C rr rr       jmp SerPrompt                 ; nothing parsed — fresh prompt
0003D4r 1               @NotStor:
0003D4r 1  30 2B          bmi @XamNext                  ; B7=1 -> BLOCK XAM continuation
0003D6r 1  A2 02          ldx #$02                      ; copy the hex value to the store + examine
0003D8r 1               @SetAdr:
0003D8r 1  B5 4B          lda L-1,x                     ;   indices (two bytes)
0003DAr 1  95 49          sta STL-1,x
0003DCr 1  95 47          sta XAML-1,x
0003DEr 1  CA             dex
0003DFr 1  D0 F7          bne @SetAdr                   ; X reaches 0 with Z=1 (prints the address)
0003E1r 1               @NxtPrnt:
0003E1r 1  D0 14          bne @PrData                   ; NE -> mid-row, no new address label
0003E3r 1  A9 8D          lda #$8D                      ; CR
0003E5r 1  20 rr rr       jsr SerEcho
0003E8r 1  A5 49          lda XAMH                      ; print the examine address
0003EAr 1  20 rr rr       jsr PrByte
0003EDr 1  A5 48          lda XAML
0003EFr 1  20 rr rr       jsr PrByte
0003F2r 1  A9 BA          lda #$BA                      ; ":"
0003F4r 1  20 rr rr       jsr SerEcho
0003F7r 1               @PrData:
0003F7r 1  A9 A0          lda #$A0                      ; space
0003F9r 1  20 rr rr       jsr SerEcho
0003FCr 1  A1 48          lda (XAML,x)                  ; print the data byte (X=0)
0003FEr 1  20 rr rr       jsr PrByte
000401r 1               @XamNext:
000401r 1  86 4F          stx WMODE                     ; X=0 -> back to XAM mode
000403r 1  A5 48          lda XAML                      ; more bytes to print in the range?
000405r 1  C5 4C          cmp L
000407r 1  A5 49          lda XAMH
000409r 1  E5 4D          sbc H
00040Br 1  B0 0C          bcs @ToNextItem               ; not less -> done with this range
00040Dr 1  E6 48          inc XAML                      ; advance the examine index
00040Fr 1  D0 02          bne @Mod8
000411r 1  E6 49          inc XAMH
000413r 1               @Mod8:
000413r 1  A5 48          lda XAML                      ; start a new row every 8 bytes
000415r 1  29 07          and #$07
000417r 1  10 C8          bpl @NxtPrnt                  ; always taken (result is 0-7); Z drives the
000419r 1               @ToNextItem:                    ;   address-label decision in @NxtPrnt
000419r 1  4C rr rr       jmp @NextItem
00041Cr 1               
00041Cr 1               ; -----------------------------------------------------------------------------
00041Cr 1               ;   SerPrompt — emit a CR/LF and the "> " prompt, reset the line buffer
00041Cr 1               ;   Modifies: A
00041Cr 1               ; -----------------------------------------------------------------------------
00041Cr 1               SerPrompt:
00041Cr 1  A9 0D          lda #CHAR_CR
00041Er 1  20 rr rr       jsr SerEcho                   ; CR -> CR/LF
000421r 1  A9 3E          lda #'>'
000423r 1  20 rr rr       jsr SerPutc
000426r 1  A9 20          lda #CHAR_SPACE
000428r 1  20 rr rr       jsr SerPutc
00042Br 1  64 50          stz SER_IDX                   ; start a fresh line
00042Dr 1  60             rts
00042Er 1               
00042Er 1               ; -----------------------------------------------------------------------------
00042Er 1               ;   PrByte / PrHex — print A as two hex digits over serial (Wozmon PRBYTE)
00042Er 1               ;   In: A = byte.  PrHex falls through into SerEcho.
00042Er 1               ;   Modifies: A
00042Er 1               ; -----------------------------------------------------------------------------
00042Er 1               PrByte:
00042Er 1  48             pha
00042Fr 1  4A             lsr a
000430r 1  4A             lsr a
000431r 1  4A             lsr a                         ; high nibble to the low nibble position
000432r 1  4A             lsr a
000433r 1  20 rr rr       jsr PrHex
000436r 1  68             pla
000437r 1               PrHex:
000437r 1  29 0F          and #$0F                      ; mask the low nibble
000439r 1  09 B0          ora #$B0                      ; "0".."9"
00043Br 1  C9 BA          cmp #$BA
00043Dr 1  90 02          bcc SerEcho                   ; a digit — send it
00043Fr 1  69 06          adc #$06                      ; letter offset: "A".."F"
000441r 1                 ; fall through to SerEcho
000441r 1               
000441r 1               ; -----------------------------------------------------------------------------
000441r 1               ;   SerEcho — send one character to the serial port
000441r 1               ;   In: A = character (bit 7 may be set).  Clears bit 7 and maps CR -> CR/LF.
000441r 1               ;   Preserves X and Y (the line parser holds state in them across echoes).
000441r 1               ;   Modifies: A
000441r 1               ; -----------------------------------------------------------------------------
000441r 1               SerEcho:
000441r 1  DA             phx
000442r 1  5A             phy
000443r 1  29 7F          and #$7F                      ; back to plain ASCII
000445r 1  C9 0D          cmp #CHAR_CR                  ; CR?
000447r 1  D0 0C          bne @One
000449r 1  A9 0D          lda #CHAR_CR
00044Br 1  20 rr rr       jsr SerPutc
00044Er 1  A9 0A          lda #CHAR_LF                  ; CR -> CR + LF
000450r 1  20 rr rr       jsr SerPutc
000453r 1  80 03          bra @Done
000455r 1               @One:
000455r 1  20 rr rr       jsr SerPutc
000458r 1               @Done:
000458r 1  7A             ply
000459r 1  FA             plx
00045Ar 1  60             rts
00045Br 1               
00045Br 1               ; -----------------------------------------------------------------------------
00045Br 1               ;   SerPutc — send one byte to the serial port, NON-BLOCKING
00045Br 1               ; -----------------------------------------------------------------------------
00045Br 1               ;   In: A = byte (sent as-is).  Preserves X and Y.
00045Br 1               ;   Unlike the BIOS SerialChrout (which blocks until TDRE — and therefore
00045Br 1               ;   hangs forever when the R65C51's /CTS is not asserted by a connected
00045Br 1               ;   terminal), this waits for TX-ready only for a bounded time and then drops
00045Br 1               ;   the byte.  That keeps the keypad monitor fully alive whether or not a host
00045Br 1               ;   terminal is attached.  When a terminal IS connected it exits as soon as
00045Br 1               ;   TDRE sets, so back-to-back bytes are not dropped.
00045Br 1               ;   Modifies: A
00045Br 1               ; -----------------------------------------------------------------------------
00045Br 1               SerPutc:
00045Br 1  48             pha                           ; save the byte on the stack
00045Cr 1  DA             phx
00045Dr 1  5A             phy
00045Er 1  AD 0D 03       lda HW_PRESENT
000461r 1  29 10          and #HW_SC                    ; Serial Card fitted?
000463r 1  F0 11          beq @Drop                     ; no — drop the byte without touching $9000
000465r 1                                               ;   (and without paying the TDRE timeout)
000465r 1  A2 08          ldx #$08                      ; bounded TDRE wait (~16-bit countdown)
000467r 1               @WaitHi:
000467r 1  A0 00          ldy #$00
000469r 1               @WaitLo:
000469r 1  AD 01 90       lda SC_STATUS
00046Cr 1  29 10          and #SC_STATUS_TDRE           ; TX data register empty?
00046Er 1  D0 0A          bne @Send
000470r 1  88             dey
000471r 1  D0 F6          bne @WaitLo
000473r 1  CA             dex
000474r 1  D0 F1          bne @WaitHi
000476r 1                 ; timeout — no terminal; drop the byte
000476r 1               @Drop:
000476r 1  7A             ply
000477r 1  FA             plx
000478r 1  68             pla
000479r 1  60             rts
00047Ar 1               @Send:
00047Ar 1  7A             ply
00047Br 1  FA             plx
00047Cr 1  68             pla                           ; recover the byte
00047Dr 1  8D 00 90       sta SC_DATA                   ; transmit it
000480r 1  60             rts
000481r 1               
000481r 1               ; -----------------------------------------------------------------------------
000481r 1               ;   SerPrintStr — send a null-terminated string over serial
000481r 1               ;   In: STR_PTR ($02-$03) = pointer to the string
000481r 1               ;   Modifies: A, Y
000481r 1               ; -----------------------------------------------------------------------------
000481r 1               SerPrintStr:
000481r 1  A0 00          ldy #$00
000483r 1               @Loop:
000483r 1  B1 02          lda (STR_PTR),y
000485r 1  F0 06          beq @Done                     ; null terminator
000487r 1  20 rr rr       jsr SerEcho                   ; SerEcho preserves Y
00048Ar 1  C8             iny
00048Br 1  D0 F6          bne @Loop
00048Dr 1               @Done:
00048Dr 1  60             rts
00048Er 1               
00048Er 1               
00048Er 1               ; =============================================================================
00048Er 1               ;   INTERRUPT HANDLERS & VECTOR TRAMPOLINES
00048Er 1               ; =============================================================================
00048Er 1               ;   The cartridge owns the hardware vectors at $FFFA-$FFFF.  Following the
00048Er 1               ;   BIOS convention, the NMI and IRQ vectors trampoline through the writable
00048Er 1               ;   RAM vectors (NMI_PTR / IRQ_PTR) that KernalInit installs.  CartReset then
00048Er 1               ;   repoints IRQ_PTR at the local KeyIrq handler so the keypad CA1 edge drives
00048Er 1               ;   key input (see the keypad driver section); NMI_PTR keeps the Kernal
00048Er 1               ;   default (RTI).
00048Er 1               ;
00048Er 1               ;   BRK shares the IRQ vector.  KeyIrq detects the B flag and dispatches via
00048Er 1               ;   BRK_PTR (-> BrkHandler) with P/PCL/PCH still on the stack, so BrkHandler
00048Er 1               ;   only needs to RTI to resume the interrupted code.
00048Er 1               ; -----------------------------------------------------------------------------
00048Er 1               
00048Er 1               ; -----------------------------------------------------------------------------
00048Er 1               ;   NmiVector / IrqVector — hardware-vector trampolines through the RAM vectors
00048Er 1               ; -----------------------------------------------------------------------------
00048Er 1               NmiVector:
00048Er 1  6C 04 03       jmp (NMI_PTR)                  ; default: Kernal Nmi (RTI)
000491r 1               
000491r 1               IrqVector:
000491r 1  6C 00 03       jmp (IRQ_PTR)                  ; CartReset points IRQ_PTR at KeyIrq
000494r 1               
000494r 1               ; -----------------------------------------------------------------------------
000494r 1               ;   BrkHandler — local BRK handler
000494r 1               ; -----------------------------------------------------------------------------
000494r 1               ;   Reached via JMP (BRK_PTR) from KeyIrq after a BRK.  A/X are already
000494r 1               ;   restored and the P/PCL/PCH frame is intact, so resuming is a plain RTI.
000494r 1               ;   This keeps a stray BRK in executed user code from entering the overlaid
000494r 1               ;   BIOS monitor.
000494r 1               ; -----------------------------------------------------------------------------
000494r 1               BrkHandler:
000494r 1  40             rti
000495r 1               
000495r 1               
000495r 1               ; =============================================================================
000495r 1               ;   Data
000495r 1               ; =============================================================================
000495r 1               
000495r 1               SplashL1:
000495r 1  4B 49 4D 20    .byte "KIM MONITOR v1.0", $00
000499r 1  4D 4F 4E 49  
00049Dr 1  54 4F 52 20  
0004A6r 1               SplashL2:
0004A6r 1  2D 2D 45 53    .byte "--ESC TO START--", $00
0004AAr 1  43 20 54 4F  
0004AEr 1  20 53 54 41  
0004B7r 1               
0004B7r 1               ; -----------------------------------------------------------------------------
0004B7r 1               ;   KeySymTable — keycode (0-23) -> printable LCD symbol
0004B7r 1               ; -----------------------------------------------------------------------------
0004B7r 1               ;   Hex digit keys map to their hex character; navigation/command keys map to
0004B7r 1               ;   a distinct printable glyph for the keypad echo test.
0004B7r 1               ;     $00 LEFT  $0B RIGHT  $10 ESC  $11 INS  $12 PGUP  $14 UP  $15 DEL  $16 PGDN
0004B7r 1               ; -----------------------------------------------------------------------------
0004B7r 1               KeySymTable:
0004B7r 1  3C             .byte '<'                     ; $00 LEFT
0004B8r 1  31             .byte '1'                     ; $01
0004B9r 1  32             .byte '2'                     ; $02
0004BAr 1  33             .byte '3'                     ; $03
0004BBr 1  34             .byte '4'                     ; $04
0004BCr 1  35             .byte '5'                     ; $05
0004BDr 1  36             .byte '6'                     ; $06
0004BEr 1  37             .byte '7'                     ; $07
0004BFr 1  38             .byte '8'                     ; $08
0004C0r 1  39             .byte '9'                     ; $09
0004C1r 1  30             .byte '0'                     ; $0A
0004C2r 1  3E             .byte '>'                     ; $0B RIGHT
0004C3r 1  46             .byte 'F'                     ; $0C
0004C4r 1  45             .byte 'E'                     ; $0D
0004C5r 1  44             .byte 'D'                     ; $0E
0004C6r 1  43             .byte 'C'                     ; $0F
0004C7r 1  2A             .byte '*'                     ; $10 ESC
0004C8r 1  49             .byte 'I'                     ; $11 INS
0004C9r 1  55             .byte 'U'                     ; $12 PGUP
0004CAr 1  41             .byte 'A'                     ; $13
0004CBr 1  5E             .byte '^'                     ; $14 UP
0004CCr 1  58             .byte 'X'                     ; $15 DEL
0004CDr 1  4E             .byte 'N'                     ; $16 PGDN
0004CEr 1  42             .byte 'B'                     ; $17
0004CFr 1               
0004CFr 1               
0004CFr 1               ; -----------------------------------------------------------------------------
0004CFr 1               ;   HexValTable — keycode (0-23) -> hex nibble value, $FF = not a hex digit
0004CFr 1               ; -----------------------------------------------------------------------------
0004CFr 1               ;   Used by KeyToHex.  Maps the ten digit keys (0-9) and the six letter keys
0004CFr 1               ;   (A-F) to their 0-15 nibble value; every navigation/command key maps to the
0004CFr 1               ;   $FF sentinel so the dispatch loop ignores it during address/data entry.
0004CFr 1               ; -----------------------------------------------------------------------------
0004CFr 1               HexValTable:
0004CFr 1  FF             .byte $FF                     ; $00 LEFT
0004D0r 1  01             .byte $01                     ; $01 1
0004D1r 1  02             .byte $02                     ; $02 2
0004D2r 1  03             .byte $03                     ; $03 3
0004D3r 1  04             .byte $04                     ; $04 4
0004D4r 1  05             .byte $05                     ; $05 5
0004D5r 1  06             .byte $06                     ; $06 6
0004D6r 1  07             .byte $07                     ; $07 7
0004D7r 1  08             .byte $08                     ; $08 8
0004D8r 1  09             .byte $09                     ; $09 9
0004D9r 1  00             .byte $00                     ; $0A 0
0004DAr 1  FF             .byte $FF                     ; $0B RIGHT
0004DBr 1  0F             .byte $0F                     ; $0C F
0004DCr 1  0E             .byte $0E                     ; $0D E
0004DDr 1  0D             .byte $0D                     ; $0E D
0004DEr 1  0C             .byte $0C                     ; $0F C
0004DFr 1  FF             .byte $FF                     ; $10 ESC
0004E0r 1  FF             .byte $FF                     ; $11 INS
0004E1r 1  FF             .byte $FF                     ; $12 PGUP
0004E2r 1  0A             .byte $0A                     ; $13 A
0004E3r 1  FF             .byte $FF                     ; $14 UP
0004E4r 1  FF             .byte $FF                     ; $15 DEL
0004E5r 1  FF             .byte $FF                     ; $16 PGDN
0004E6r 1  0B             .byte $0B                     ; $17 B
0004E7r 1               
0004E7r 1               
0004E7r 1               ; =============================================================================
0004E7r 1               ;   CPU Vectors — cart owns $FFFA-$FFFF
0004E7r 1               ; =============================================================================
0004E7r 1               ;   NMI and IRQ trampoline through the Kernal RAM vectors (see above);
0004E7r 1               ;   RESET enters the cartridge.
0004E7r 1               
0004E7r 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiVector                ; NMI vector   -> jmp (NMI_PTR)
000002r 1  rr rr        .word   CartReset                ; RESET vector — cartridge entry point
000004r 1  rr rr        .word   IrqVector                ; IRQ vector   -> jmp (IRQ_PTR)
000004r 1               
