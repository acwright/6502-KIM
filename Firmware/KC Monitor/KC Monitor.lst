000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               .include "kim.inc"
000000r 2               ; =============================================================================
000000r 2               ;   kim.inc — Machine include file for the 6502-KIM running KC Monitor
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.6   (Kernal only — see THE CARTRIDGE OVERLAY below)
000000r 2               ;   Cartridge: KC Monitor v1.0 (Keypad Card, AT28C64)
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   This file describes the KIM *as it actually is with the Keypad Card
000000r 2               ;   fitted*.  It is deliberately NOT the family-wide 6502.inc from the BIOS
000000r 2               ;   repository: that file documents the ACE, a machine with every card
000000r 2               ;   populated and the full BIOS ROM intact.  On a KIM most of that is either
000000r 2               ;   absent hardware or has been overlaid by the cartridge, and calling into it
000000r 2               ;   does not do what 6502.inc says it does.
000000r 2               ;
000000r 2               ;   If a symbol is not in this file, it is not usable on a stock KIM.
000000r 2               ;
000000r 2               ;   MEMORY MAP (Keypad Card fitted)
000000r 2               ;   ------------------------------
000000r 2               ;   $0000-$0003   Zero Page: Kernal pointers (see Section 1)
000000r 2               ;   $0004-$0023   Zero Page: was BASIC's — free on a KIM (BASIC is overlaid)
000000r 2               ;   $0024-$0039   Zero Page: Kernal scratch (CF, serial, delay, XModem)
000000r 2               ;   $003A-$003F   Zero Page: free for user programs
000000r 2               ;   $0040-$0051   Zero Page: KC MONITOR state — do not touch (see Section 1)
000000r 2               ;   $0052-$00FF   Zero Page: free for user programs
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$027F   KC MONITOR Wozmon line buffer — LIVE, not spare RAM
000000r 2               ;   $0280-$02FF   free (the upper half of the Kernal's unused input ring)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, HW flags, etc.)
000000r 2               ;   $0400-$04FF   KC MONITOR serial RX ring — LIVE, not spare RAM
000000r 2               ;   $0500-$05FF   User Variables
000000r 2               ;   $0600-$07FF   free on a KIM (the Kernal's FS sector buffer; no CF fitted)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$8FFF   IO 1-4: unpopulated on a KIM (open bus)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA) — optional, usually fitted
000000r 2               ;   $9400-$9FFF   IO 6-8: unpopulated on a KIM (open bus)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points — SURVIVES the overlay)
000000r 2               ;   $A100-$B7FF   Kernal Implementation                    (SURVIVES the overlay)
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB)                  (SURVIVES the overlay)
000000r 2               ;   $C000-$DFFF   Keypad Card PIA registers (mirrored I/O window)
000000r 2               ;   $E000-$FFF9   Keypad Card ROM (AT28C64, 8 KB) — KC Monitor
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ) — the cartridge's own
000000r 2               ;
000000r 2               ;   THE CARTRIDGE OVERLAY — what is GONE on a KIM
000000r 2               ;   ---------------------------------------------
000000r 2               ;   The Keypad Card overlays $C000-$FFFF.  Everything the BIOS ROM put there
000000r 2               ;   is unreachable; the addresses now decode to the PIA or to cartridge ROM:
000000r 2               ;
000000r 2               ;     $C000-$EDFF   BASIC interpreter        -> gone (PIA window + cart ROM)
000000r 2               ;     $EE00-$FEFF   Machine Code Monitor     -> gone (cart ROM)
000000r 2               ;     $FF00-$FFF9   Wozmon                   -> gone (cart ROM)
000000r 2               ;     $FFFA-$FFFF   BIOS CPU vectors         -> replaced by the cartridge's
000000r 2               ;
000000r 2               ;   So there is no MONITOR_ENTRY, no MONITOR_BRK_ENTRY, no BASIC entry, and no
000000r 2               ;   BIOS Wozmon on this machine.  A BRK does NOT drop into the BIOS monitor —
000000r 2               ;   KC Monitor points BRK_PTR at its own handler, which simply RTIs.  The BRK
000000r 2               ;   register save area at $0310-$0316 is therefore never populated on a KIM.
000000r 2               ;
000000r 2               ;   What survives is $A000-$BFFF: the Kernal jump table, the Kernal itself,
000000r 2               ;   and the character set ROM.  KC Monitor calls KernalInit at reset, so the
000000r 2               ;   Kernal's RAM vectors and HW_PRESENT are set up normally.
000000r 2               ;
000000r 2               ;   HARDWARE ACTUALLY PRESENT
000000r 2               ;   -------------------------
000000r 2               ;   A stock KIM is a CPU Card, a Memory Card, a Keypad Card, and (usually) a
000000r 2               ;   Serial Card.  IO slots 1-4 and 6-8 are empty: no banked RAM, no RTC, no
000000r 2               ;   CompactFlash, no GPIO/VIA, no SID, no video.  Their register windows read
000000r 2               ;   open bus, and the Kernal routines that drive them are inert (they check
000000r 2               ;   HW_PRESENT first — see GRACEFUL DEGRADATION below).  Only Sections 4 and 5
000000r 2               ;   below list what is real; nothing here defines a register for a card the
000000r 2               ;   KIM does not have.
000000r 2               ;
000000r 2               ;   Everything is driven through the Keypad Card instead: a 24-key keypad and
000000r 2               ;   a 16x2 HD44780 LCD on a 65C21 PIA, plus the Serial Card when fitted.
000000r 2               ;
000000r 2               ;   CONSOLE I/O IS NOT WHAT YOU EXPECT
000000r 2               ;   ----------------------------------
000000r 2               ;   There is no video card, so the Kernal's console layer has nowhere good to
000000r 2               ;   go.  Two consequences bite user programs on a KIM:
000000r 2               ;
000000r 2               ;     * Chrout ($A000) dispatches on IO_MODE.  With a Serial Card fitted the
000000r 2               ;       boot probe selects serial, and Chrout lands in SerialChrout, which
000000r 2               ;       BLOCKS until TDRE — and the R65C51 gates TDRE on /CTS.  With no
000000r 2               ;       terminal connected, a single Chrout hangs the machine forever.  With
000000r 2               ;       no Serial Card fitted, IO_MODE is left as the probe found it and
000000r 2               ;       output goes nowhere at all.  Everything built on Chrout (PrintStr,
000000r 2               ;       PrintCRLF, PrintDecU16, FsPrintDisk) inherits this.
000000r 2               ;
000000r 2               ;     * Chrin ($A003) and the ring routines around it are INERT under KC
000000r 2               ;       Monitor.  They read the Kernal's input ring at $0200, which is filled
000000r 2               ;       only by the Kernal's own IRQ handler — and the cartridge takes over
000000r 2               ;       IRQ_PTR at reset, so nothing ever calls WriteBuffer.  Chrin always
000000r 2               ;       returns C=0.  Typed characters DO appear in $0200 while you watch, but
000000r 2               ;       that is KC Monitor's own Wozmon line buffer aliased onto the same page
000000r 2               ;       (see Section 3), not the Kernal ring filling up.
000000r 2               ;
000000r 2               ;   A program that wants console I/O on a KIM should talk to the Serial Card
000000r 2               ;   directly (Section 5) rather than through Chrout/Chrin.
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE (KC Monitor)
000000r 2               ;   --------------------------
000000r 2               ;   RESET vectors into the cartridge, not the BIOS.  KC Monitor resets the
000000r 2               ;   stack, calls KernalInit to bring up the Kernal RAM vectors and probe the
000000r 2               ;   base system, then takes over IRQ_PTR (keypad + serial RX) and BRK_PTR,
000000r 2               ;   brings up the LCD and PIA, and shows the splash on both the LCD and the
000000r 2               ;   serial port.  It then holds until ESC arrives from EITHER the keypad ESC
000000r 2               ;   key or the serial port; only once the gate opens does the LCD paint the
000000r 2               ;   address/byte display and the serial "> " prompt appear.  There is no boot
000000r 2               ;   menu and no BASIC to launch.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so a call
000000r 2               ;   on a machine without that card is safe rather than a crash.  On a KIM that
000000r 2               ;   means most of the jump table is a silent no-op or an immediate C=1 error
000000r 2               ;   return.  The per-routine notes in Section 4 say which is which.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as documented
000000r 2               ;   per routine.  Carry flag is used for success/error returns (C=0 success,
000000r 2               ;   C=1 error) where noted.
000000r 2               ;
000000r 2               ;   RUNNING UNDER KC MONITOR
000000r 2               ;   ------------------------
000000r 2               ;   A program launched from the monitor (keypad UP, or the serial "XXXX R"
000000r 2               ;   command) is called as a subroutine by both consoles, so it returns to the
000000r 2               ;   monitor on RTS — note that this is NOT original Wozmon's "R", which jumps.
000000r 2               ;   It runs with the cartridge's IRQ handler still installed.  That
000000r 2               ;   handler is what makes ESC a reliable break-to-monitor abort from anywhere,
000000r 2               ;   so a program that wants to stay abortable should leave IRQ_PTR alone and
000000r 2               ;   leave interrupts enabled.  A program that repoints IRQ_PTR or SEIs for a
000000r 2               ;   long stretch gives up ESC and can only be recovered with RESET.
000000r 2               ;
000000r 2               ;   The monitor also owns the PIA (Section 5) and the zero page at $40-$51,
000000r 2               ;   the line buffer at $0200-$027F and the RX ring at $0400-$04FF (Section 3).
000000r 2               ;   Writing to any of those corrupts the monitor you are going to return to.
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Kernal pointers ---------------------------------------------------------
000000r 2               ; Used as parameters to Kernal calls.  STR_PTR is the one that matters on a
000000r 2               ; KIM; the CF and XModem pointers are listed for completeness (XModem works
000000r 2               ; over the Serial Card, CF does not exist here).
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (PrintStr, and KC Monitor's LcdPrintStr / SerPrintStr)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector buffer pointer (no CF card on a KIM)
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA         (no CF card on a KIM)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; --- KC Monitor state — RESERVED --------------------------------------------
000000r 2               ; The cartridge keeps its whole working state here.  A user program that
000000r 2               ; clobbers any of it corrupts the monitor it will return to on RTS or ESC.
000000r 2               ; These are documented, not exported: the monitor defines them itself.
000000r 2               ;
000000r 2               ;   $40-$41  CUR_ADDR    current address (keypad monitor)
000000r 2               ;   $42      MODE        INS edit-mode flag
000000r 2               ;   $43      MON_TMP     nibble-edit scratch
000000r 2               ;   $44      KEY_CODE    last keycode latched by the IRQ handler
000000r 2               ;   $45      KEY_READY   nonzero when a keypad press is pending
000000r 2               ;   $46-$47  SER_RXHEAD / SER_RXTAIL   serial RX ring indices
000000r 2               ;   $48-$4F  XAML/XAMH, STL/STH, L/H, YSAV, WMODE   Wozmon parser state
000000r 2               ;   $50      SER_IDX     line-buffer index
000000r 2               ;   $51      SER_DIRTY   set when a serial deposit changed memory
000000r 2               
000000r 2               KC_ZP_START         = $40                ; first byte owned by KC Monitor
000000r 2               KC_ZP_END           = $51                ; last byte owned by KC Monitor
000000r 2               
000000r 2               ; --- Free zero page ----------------------------------------------------------
000000r 2               ; $04-$23 (BASIC's old scratch — BASIC is overlaid, so this is free on a KIM)
000000r 2               ; $3A-$3F and $52-$FF
000000r 2               ; Note: $24-$2D belong to the Kernal's CF/XModem routines and do not survive a
000000r 2               ;       call into them; $2E-$39 was the BIOS Monitor's, which is overlaid.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               ; Set up by KernalInit, which KC Monitor calls at reset.  Only the entries
000000r 2               ; that mean something on a KIM are listed.
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector
000000r 2                                                        ;   KC Monitor points this at its own handler
000000r 2                                                        ;   (keypad CA1 + serial RX + ESC abort).
000000r 2                                                        ;   Repointing it costs you the ESC abort.
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector
000000r 2                                                        ;   KC Monitor points this at a plain RTI, so a
000000r 2                                                        ;   BRK in user code resumes instead of entering
000000r 2                                                        ;   the (overlaid) BIOS monitor
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (Kernal default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2                                                        ;   No video card on a KIM — see CONSOLE I/O above
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set by the boot probe)
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers).  On a stock
000000r 2               ; KIM only HW_SC is ever set, and only when a Serial Card is fitted.
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1) — absent on a KIM
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2) — absent on a KIM
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3) — absent on a KIM
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card  (IO 4) — absent on a KIM
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card   (IO 5) — the one to test on a KIM
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card     (IO 6) — absent on a KIM
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card    (IO 7) — absent on a KIM
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card    (IO 8) — absent on a KIM
000000r 2               
000000r 2               ; Test before using the Serial Card directly:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_SC
000000r 2               ;     beq @NoSerial
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address, honoured by the BIOS
000000r 2                                                        ;   reset flow only.  INERT on a KIM: the cartridge
000000r 2                                                        ;   owns the RESET vector, so the BIOS boot flow that
000000r 2                                                        ;   reads this never runs.  KernalInit still zeroes it.
000000r 2               
000000r 2               ; Not listed, because they are meaningless on a KIM:
000000r 2               ;   VID_CURSOR_X/Y ($0307-$0308)  no video card
000000r 2               ;   CF_DISK ($030F), FS_IO_ADDR ($037F), FS_FILE_SIZE ($034A)   no CF card
000000r 2               ;   BRK_P..BRK_SP ($0310-$0316)   populated by the BIOS monitor's BRK handler,
000000r 2               ;                                 which is overlaid — never written on a KIM
000000r 2               ;   PRG_IMAGE_END ($038E)         consumed by BASIC, which is overlaid
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               PROGRAM_START       := $0800             ; User programs load here (KC Monitor's
000000r 2                                                        ;   power-on address).  Program space runs
000000r 2                                                        ;   to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               CHARSET_ROM         := $B800             ; 2 KB CP437 character set, 256 x 8-byte
000000r 2                                                        ;   patterns.  Survives the overlay and is
000000r 2                                                        ;   readable, though a KIM has no video card
000000r 2                                                        ;   to draw it on — useful as pattern data
000000r 2               
000000r 2               ; --- The pages KC Monitor lives in -------------------------------------------
000000r 2               ; These are NOT spare RAM.  On a stock ACE, $0200-$02FF is the Kernal's input
000000r 2               ; ring; on a KIM the Kernal ring is dead (nothing feeds it — see CONSOLE I/O)
000000r 2               ; and the bottom half of the page is the monitor's live Wozmon line buffer,
000000r 2               ; deliberately aliased onto it.  Anyone scavenging $0200 for scratch on the
000000r 2               ; strength of the family-wide 6502.inc will corrupt the line being typed.
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — the Kernal's input ring.
000000r 2                                                        ;   INERT on a KIM (never written by the Kernal).
000000r 2               KC_LINEBUF          := $0200             ; $0200-$027F — KC Monitor's Wozmon line buffer.
000000r 2                                                        ;   LIVE whenever the serial monitor is running.
000000r 2               KC_RXBUF            := $0400             ; $0400-$04FF — KC Monitor's serial RX ring,
000000r 2                                                        ;   filled by the cartridge IRQ handler.  LIVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.  The
000000r 2               ; whole table survives the cartridge overlay and every address below is real —
000000r 2               ; but most of it drives cards a KIM does not have, and says so.
000000r 2               ;
000000r 2               ; The tag on each group says what to expect on a stock KIM:
000000r 2               ;   [WORKS]   does its job
000000r 2               ;   [SERIAL]  works when a Serial Card is fitted (test HW_SC), inert otherwise
000000r 2               ;   [INERT]   returns silently having done nothing — no card to drive
000000r 2               ;   [FAILS]   returns C=1 immediately — no card to drive
000000r 2               ;   [BROKEN]  present, but does not do what it says on a KIM (see the note)
000000r 2               
000000r 2               ; --- Character I/O -----------------------------------------------------------
000000r 2               Chrout              := $A000             ; [SERIAL] Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character.  Preserves: A, X, Y
000000r 2                                                        ;   WARNING: on a KIM this reaches SerialChrout, which
000000r 2                                                        ;   blocks until TDRE.  No terminal connected = hang.
000000r 2                                                        ;   Prefer talking to the ACIA directly (Section 5)
000000r 2               
000000r 2               Chrin               := $A003             ; [BROKEN] Input character from the Kernal ring
000000r 2                                                        ;   Always returns C=0 on a KIM: the cartridge owns
000000r 2                                                        ;   IRQ_PTR, so nothing ever calls WriteBuffer
000000r 2               WriteBuffer         := $A006             ; [BROKEN] Write byte to the Kernal input ring
000000r 2               ReadBuffer          := $A009             ; [BROKEN] Read byte from the Kernal input ring
000000r 2               BufferSize          := $A00C             ; [BROKEN] Unread byte count — always 0 on a KIM
000000r 2               
000000r 2               ; --- IO Mode -----------------------------------------------------------------
000000r 2               SetIOMode           := $A00F             ; [WORKS] Set IO_MODE   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               GetIOMode           := $A012             ; [WORKS] Get IO_MODE   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (IO 8) — no video card on a KIM -----------------------------------
000000r 2               InitVideo           := $A015             ; [INERT]
000000r 2               VideoClear          := $A018             ; [INERT]
000000r 2               VideoPutChar        := $A01B             ; [INERT]
000000r 2               VideoSetCursor      := $A01E             ; [INERT]
000000r 2               VideoGetCursor      := $A021             ; [INERT]
000000r 2               VideoScroll         := $A024             ; [INERT]
000000r 2               VideoSetColor       := $A027             ; [INERT]
000000r 2               VideoChroutRaw      := $A02A             ; [INERT]
000000r 2               
000000r 2               ; --- Sound (IO 7) — no SID on a KIM ------------------------------------------
000000r 2               InitSID             := $A02D             ; [INERT]
000000r 2               Beep                := $A030             ; [INERT]
000000r 2               SidPlayNote         := $A033             ; [INERT]
000000r 2               SidSilence          := $A036             ; [INERT]
000000r 2               SidSetVolume        := $A039             ; [INERT]
000000r 2               
000000r 2               ; --- Filesystem (IO 4) — no CompactFlash on a KIM ----------------------------
000000r 2               FsLoadFile          := $A03C             ; [FAILS] C=1
000000r 2               FsSaveFile          := $A03F             ; [FAILS] C=1
000000r 2               FsDeleteFile        := $A042             ; [FAILS] C=1
000000r 2               FsLoadFileAddr      := $A07E             ; [FAILS] C=1
000000r 2               FsSaveFileAddr      := $A081             ; [FAILS] C=1
000000r 2               FsFormatDisk        := $A084             ; [FAILS] C=1
000000r 2               FsSetDisk           := $A087             ; [INERT] sets CF_DISK; nothing reads it here
000000r 2               FsGetDisk           := $A08A             ; [INERT]
000000r 2               FsPrintDisk         := $A08D             ; [SERIAL] prints via Chrout — same caveat as Chrout
000000r 2               
000000r 2               ; --- Keyboard / GPIO (IO 6) — no GPIO card on a KIM --------------------------
000000r 2               ;   The KIM's keypad is on the Keypad Card's PIA, not the VIA.  These drive the
000000r 2               ;   GPIO card's encoders and are not the way to read the keypad.
000000r 2               InitKB              := $A045             ; [INERT]
000000r 2               ReadJoystick1       := $A048             ; [BROKEN] no HW_PRESENT check — reads a floating bus
000000r 2               ReadJoystick2       := $A04B             ; [BROKEN] no HW_PRESENT check — reads a floating bus
000000r 2               KBDisable           := $A099             ; [INERT]
000000r 2               KBEnable            := $A09C             ; [INERT]
000000r 2               
000000r 2               ; --- Serial (IO 5) — the KIM's one real I/O card -----------------------------
000000r 2               InitSC              := $A04E             ; [SERIAL] Initialize serial card (8-N-1, 19200 baud, RX IRQ on)
000000r 2                                                        ;   Modifies: A
000000r 2                                                        ;   KC Monitor calls this at reset when HW_SC is set
000000r 2               
000000r 2               SerialChrout        := $A051             ; [SERIAL] Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   BLOCKS until TX register is empty.  The R65C51 gates
000000r 2                                                        ;   TDRE on /CTS, so this hangs forever with no terminal
000000r 2                                                        ;   attached — KC Monitor uses its own bounded-wait
000000r 2                                                        ;   SerPutc instead, and so should anything that must
000000r 2                                                        ;   survive a disconnected port
000000r 2               
000000r 2               XModemLoad          := $A054             ; [SERIAL] Receive data via XModem into memory
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; [SERIAL] Send data via XModem from memory
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (IO 3) — no RTC card on a KIM ---------------------------------------
000000r 2               RtcReadTime         := $A05A             ; [INERT]
000000r 2               RtcReadDate         := $A05D             ; [INERT]
000000r 2               RtcWriteTime        := $A060             ; [INERT]
000000r 2               RtcWriteDate        := $A063             ; [INERT]
000000r 2               RtcReadNVRAM        := $A066             ; [INERT]
000000r 2               RtcWriteNVRAM       := $A069             ; [INERT]
000000r 2               
000000r 2               ; --- CompactFlash sector I/O (IO 4) — no CF card on a KIM --------------------
000000r 2               StReadSector        := $A06C             ; [FAILS] C=1
000000r 2               StWriteSector       := $A06F             ; [FAILS] C=1
000000r 2               StWaitReady         := $A072             ; [FAILS] C=1 immediately (the boot probe found no card)
000000r 2               
000000r 2               ; --- Timing ------------------------------------------------------------------
000000r 2               SysDelay            := $A075             ; [WORKS] Delay for A/X centiseconds (10 ms units, 16-bit)
000000r 2                                                        ;   In: A = low byte, X = high byte
000000r 2                                                        ;   Uses VIA T1 if available — on a KIM there is no GPIO
000000r 2                                                        ;   card, so this always takes the software-loop path
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- System ------------------------------------------------------------------
000000r 2               KernalInit          := $A078             ; [WORKS] Initialize Kernal vectors, probe & init all I/O
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2                                                        ;   KC Monitor calls this once at reset; a user program
000000r 2                                                        ;   should NOT call it again — it would undo the
000000r 2                                                        ;   cartridge's IRQ_PTR/BRK_PTR takeover
000000r 2               
000000r 2               KernalVersion       := $A07B             ; [WORKS] Get BIOS version  Out: A = major, X = minor
000000r 2               
000000r 2               ; --- General output utilities (all routed through Chrout) --------------------
000000r 2               PrintStr            := $A090             ; [SERIAL] Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; [SERIAL] Print CR ($0D) then LF ($0A)
000000r 2               PrintDecU16         := $A096             ; [SERIAL] Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               ; Only what a KIM actually has.  IO slots 1-4 and 6-8 ($8000-$8FFF, $9400-$9FFF)
000000r 2               ; are unpopulated and read open bus; if you fit one of those cards, take its
000000r 2               ; register definitions from the BIOS's family-wide 6502.inc.
000000r 2               
000000r 2               ; -----------------------------------------------------------------------------
000000r 2               ;   Serial Card (R65C51 ACIA) — IO 5: $9000-$9003
000000r 2               ; -----------------------------------------------------------------------------
000000r 2               ;   Optional hardware.  Test HW_SC in HW_PRESENT before touching these — with
000000r 2               ;   no card fitted the window is open bus and a floating RDRF will hand you
000000r 2               ;   phantom bytes.  Default config after InitSC: 8-N-1, 19200 baud, RX IRQ on.
000000r 2               
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register (reading clears the IRQ flag)
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; Serial Command Register values, as the RTS scheme uses them.
000000r 2               ;
000000r 2               ;   The transmitter interrupt control bits (3-2, "TIC") drive the RTS pin AND
000000r 2               ;   the transmitter together.  Rockwell's Rev. 4 sheet and Synertek's spell the
000000r 2               ;   four values out, and the bench settled it on a real R6551 (2026-09-17):
000000r 2               ;
000000r 2               ;     00 = Transmit Interrupt Disabled, RTSB = High, Transmitter OFF
000000r 2               ;     01 = Transmit Interrupt Enabled,  RTSB = Low,  Transmitter on
000000r 2               ;     10 = Transmit Interrupt Disabled, RTSB = Low,  Transmitter on
000000r 2               ;     11 = Transmit Interrupt Disabled, RTSB = Low,  Transmit BRK
000000r 2               ;
000000r 2               ;   So raising RTS ("stop sending") also silences the board: a byte written
000000r 2               ;   with TIC 00 standing never leaves, and TDRE never sets.  Anything that
000000r 2               ;   wants to transmit has to put RTS down first.  InitSC leaves $09 here.
000000r 2               SC_CMD_RTS_LOW      := %00001001         ; DTR on, RX IRQ on, TIC 10: RTS low, transmitter on
000000r 2               SC_CMD_RTS_HIGH     := %00000001         ; DTR on, RX IRQ on, TIC 00: RTS high, transmitter off
000000r 2               
000000r 2               ; -----------------------------------------------------------------------------
000000r 2               ;   Keypad Card PIA (65C21) — $C000-$C003, mirrored across $C000-$DFFF
000000r 2               ; -----------------------------------------------------------------------------
000000r 2               ;   The card that makes the KIM a KIM.  A0=RS0, A1=RS1.
000000r 2               ;
000000r 2               ;   Wiring:
000000r 2               ;     PA0-PA4 = keypad code        (input)
000000r 2               ;     PA5     = LCD RS             (output)
000000r 2               ;     PA6     = LCD R/W            (output)
000000r 2               ;     PA7     = LCD E              (output)
000000r 2               ;     PB0-PB7 = LCD data bus       (output)
000000r 2               ;     CA1     = keypad data-available
000000r 2               ;     CA2     = active-low OE of the 74C922 keypad encoder
000000r 2               ;
000000r 2               ;   KC Monitor owns this PIA.  A program launched from the monitor that writes
000000r 2               ;   here will scramble the LCD and can break keypad input — including the ESC
000000r 2               ;   abort that would have got you back.
000000r 2               
000000r 2               PORTA               := $C000             ; Port A data / DDRA (per CRA bit 2)
000000r 2               CRA                 := $C001             ; Control register A
000000r 2               PORTB               := $C002             ; Port B data / DDRB (per CRB bit 2)
000000r 2               CRB                 := $C003             ; Control register B
000000r 2               
000000r 2               ; Control-register bit 2 selects the data register (1) or the data direction
000000r 2               ; register (0) at the shared port address.
000000r 2               CR_DDR              = %00000000          ; access DDRx
000000r 2               CR_PORT             = %00000100          ; access PORTx data register
000000r 2               
000000r 2               ; Data direction for Port A: PA5/PA6/PA7 outputs (LCD control),
000000r 2               ; PA0-PA4 inputs (keypad code).
000000r 2               LCD_DDRA            = %11100000          ; $E0
000000r 2               
000000r 2               ; LCD control-line masks on Port A
000000r 2               LCD_RS              = %00100000          ; PA5 — register select (1=data, 0=cmd)
000000r 2               LCD_RW              = %01000000          ; PA6 — read/write (1=read, 0=write)
000000r 2               LCD_E               = %10000000          ; PA7 — enable strobe
000000r 2               
000000r 2               ; LCD busy flag (Port B DB7, valid when reading with RS=0 / R/W=1).  KC Monitor
000000r 2               ; uses timed delays instead of polling this, so the read-back path is untested
000000r 2               ; hardware — treat it with suspicion.
000000r 2               LCD_BUSY            = %10000000
000000r 2               
000000r 2               ; -----------------------------------------------------------------------------
000000r 2               ;   Keypad (74C922 encoder via PIA Port A + CA1/CA2)
000000r 2               ; -----------------------------------------------------------------------------
000000r 2               ;   The encoder presents a 5-bit keycode on PA0-PA4 and raises CA1 (positive
000000r 2               ;   edge) when a key becomes available.  CA2 is driven low to enable the
000000r 2               ;   encoder's active-low output enable (OE).  Scanning, debounce and encoding
000000r 2               ;   are all done in hardware on the Keypad Helper.
000000r 2               ;
000000r 2               ;   Read the keycode at the CA1 edge (in an interrupt handler), where the
000000r 2               ;   74C922 outputs are guaranteed valid — polling at an arbitrary later time
000000r 2               ;   can straddle a key transition.
000000r 2               ;
000000r 2               ;   CRA layout for the keypad:
000000r 2               ;     bit 7   CA1 active-edge flag (IRQF1) — set on key-available, read-only
000000r 2               ;     bit 5-3 110 = CA2 manual output low (enables 74C922 OE)
000000r 2               ;     bit 2   1   = access PORTA data register (not DDRA)
000000r 2               ;     bit 1   1   = CA1 active on the positive (rising) edge
000000r 2               ;     bit 0   1   = CA1 interrupt enabled
000000r 2               
000000r 2               PIA_CA1_FLAG        = %10000000          ; CRA bit 7 — CA1 active-edge flag
000000r 2               PIA_CRA_KEYPAD      = %00110111          ; $37 — CA2 out low, CA1 +edge, IRQ ON, PORT
000000r 2               KEY_MASK            = %00011111          ; PA0-PA4 carry the keycode (0-23)
000000r 2               KEY_COUNT           = 24                 ; valid keycodes are $00-$17
000000r 2               
000000r 2               ; Named keycodes.  The 24 keys are a 4x6 matrix; the sixteen hex keys are not
000000r 2               ; contiguous, so use the layout below rather than arithmetic on the keycode.
000000r 2               ;
000000r 2               ;   $00 LEFT   $01 1   $02 2   $03 3   $04 4   $05 5
000000r 2               ;   $06 6      $07 7   $08 8   $09 9   $0A 0   $0B RIGHT
000000r 2               ;   $0C F      $0D E   $0E D   $0F C   $10 ESC $11 INS
000000r 2               ;   $12 PGUP   $13 A   $14 UP  $15 DEL $16 PGDN $17 B
000000r 2               
000000r 2               KEY_LEFT            = $00
000000r 2               KEY_RIGHT           = $0B
000000r 2               KEY_ESC             = $10
000000r 2               KEY_INS             = $11
000000r 2               KEY_PGUP            = $12
000000r 2               KEY_A               = $13
000000r 2               KEY_UP              = $14
000000r 2               KEY_DEL             = $15
000000r 2               KEY_PGDN            = $16
000000r 2               KEY_B               = $17
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Versions ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               KC_VERSION_MAJOR    = 1                  ; KC Monitor cartridge version
000000r 2               KC_VERSION_MINOR    = 0
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell
000000r 2               CHAR_BS             = $08                ; Backspace
000000r 2               CHAR_LF             = $0A                ; Line Feed
000000r 2               CHAR_CR             = $0D                ; Carriage Return
000000r 2               CHAR_ESC            = $1B                ; Escape — break-to-monitor abort on a KIM,
000000r 2                                                        ;   from the keypad ESC key or the serial port
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               CHAR_DEL            = $7F                ; Delete
000000r 2               
000000r 2               ; --- XModem protocol constants (used with XModemLoad / XModemSave) ---
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   KC Monitor — KIM-1-style keypad/LCD memory monitor
000000r 1               ; =============================================================================
000000r 1               ;   Cartridge ROM for the Keypad Card (KC).  Drives a 16x2 HD44780 LCD and a
000000r 1               ;   24-key keypad through a 65C21 PIA.  The cart overlays $C000-$FFFF; ROM
000000r 1               ;   (AT28C64, 8 KB) lives at $E000-$FFFF and the PIA registers are mirrored
000000r 1               ;   across the I/O window $C000-$DFFF.
000000r 1               ;
000000r 1               ;   The machine itself — PIA, LCD wiring, keypad codes, the surviving Kernal —
000000r 1               ;   is described in kim.inc.  This file implements:
000000r 1               ;     - Monitor state & build scaffolding
000000r 1               ;     - LCD driver
000000r 1               ;     - PIA init & keypad input
000000r 1               ;     - Monitor state machine
000000r 1               ;     - Entry point, interrupt handlers & CPU vectors
000000r 1               ;     - ESC = break-to-monitor abort (handled in KeyIrq)
000000r 1               ;     - Wozmon-compatible serial monitor (concurrent with the keypad)
000000r 1               ; =============================================================================
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Machine definitions
000000r 1               ; =============================================================================
000000r 1               ;   kim.inc describes the KIM as it actually is with this cartridge fitted:
000000r 1               ;   the Keypad Card PIA ($C000-$C003) and its LCD/keypad wiring, the Serial
000000r 1               ;   Card ACIA ($9000-$9003), the part of the BIOS Kernal that survives the
000000r 1               ;   $C000-$FFFF overlay, and the RAM this monitor reserves.  Everything the
000000r 1               ;   overlay removes — BASIC, the BIOS Monitor, Wozmon, the BIOS vectors — is
000000r 1               ;   listed there as gone rather than silently omitted.
000000r 1               ;
000000r 1               ;   PORTA/CRA/PORTB/CRB, CR_DDR/CR_PORT, LCD_*, PIA_*, KEY_* and the ASCII
000000r 1               ;   constants below all come from it.
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Monitor zero-page state
000000r 1               ; =============================================================================
000000r 1               ;   Lives in the free user zero page; kim.inc reserves $40-$51 (KC_ZP_START..
000000r 1               ;   KC_ZP_END) for the monitor so a program written for the KIM knows to keep
000000r 1               ;   off it.  CUR_ADDR is the address the monitor is inspecting/editing; it
000000r 1               ;   doubles as the (zp),y pointer for byte access and as the execute
000000r 1               ;   trampoline target.  MODE holds the INS edit flag; MON_TMP is scratch for
000000r 1               ;   the nibble-shift edits.
000000r 1               CUR_ADDR            := $40               ; 2 bytes — current address pointer
000000r 1               MODE                := $42               ; 1 byte  — INS edit-mode flag (0=off)
000000r 1               MON_TMP             := $43               ; 1 byte  — scratch for nibble edits
000000r 1               KEY_CODE            := $44               ; 1 byte  — last keycode latched by KeyIrq
000000r 1               KEY_READY           := $45               ; 1 byte  — nonzero when a key is pending
000000r 1               
000000r 1               MODE_INS            = $01                ; MODE value: insert/edit mode active
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Serial Wozmon zero-page state
000000r 1               ; =============================================================================
000000r 1               ;   A Wozmon-compatible serial monitor runs concurrently with the keypad
000000r 1               ;   monitor, sharing the same memory.  Incoming bytes are pushed into a
000000r 1               ;   256-byte RX ring by the IRQ handler and drained by the cooperative main
000000r 1               ;   loop into a Wozmon line parser.  The parser variables mirror the original
000000r 1               ;   Apple-1 Wozmon (XAML/XAMH, STL/STH, L/H, YSAV, MODE) but live in the free
000000r 1               ;   user zero page since $24-$2B are reserved by the Kernal here.  WMODE is
000000r 1               ;   kept distinct from the keypad MODE byte.
000000r 1               SER_RXHEAD          := $46               ; 1 byte  — RX ring write index (IRQ)
000000r 1               SER_RXTAIL          := $47               ; 1 byte  — RX ring read index (main loop)
000000r 1               XAML                := $48               ; 2 bytes — last "examined" address (lo/hi)
000000r 1               XAMH                := $49
000000r 1               STL                 := $4A               ; 2 bytes — current deposit address (lo/hi)
000000r 1               STH                 := $4B
000000r 1               L                   := $4C               ; 2 bytes — hex accumulator (lo/hi)
000000r 1               H                   := $4D
000000r 1               YSAV                := $4E               ; 1 byte  — saved index (hex-present test)
000000r 1               WMODE               := $4F               ; 1 byte  — Wozmon mode ($00=XAM, $74=STOR, $AE=BLOCK)
000000r 1               SER_IDX             := $50               ; 1 byte  — current line-buffer index
000000r 1               SER_DIRTY           := $51               ; 1 byte  — nonzero when a serial deposit changed memory
000000r 1               
000000r 1               ; The RX ring buffer (256 bytes, byte indices wrap naturally) and the Wozmon
000000r 1               ; line buffer share the low-RAM input region; neither is used by the keypad
000000r 1               ; monitor.  The line buffer is aliased onto the Kernal's input ring page,
000000r 1               ; which is inert here (nothing feeds it once the cart owns IRQ_PTR) — kim.inc
000000r 1               ; documents both pages as live so they are not mistaken for spare RAM.
000000r 1               SER_RXBUF           := KC_RXBUF          ; $0400 — 256-byte serial RX ring buffer
000000r 1               SER_LINEBUF         := KC_LINEBUF        ; $0200 — Wozmon line accumulation buffer
000000r 1               
000000r 1               ; RTS water marks.  The same pair the BIOS Kernal uses (BIOS.inc), and for the
000000r 1               ; same reason: see the RTS FLOW CONTROL section below.  RTS goes up at
000000r 1               ; SC_RTS_HIGH_WATER unread bytes with $40 still spare in the ring, and comes
000000r 1               ; down again below SC_RTS_LOW_WATER.  The $40 between them is hysteresis, so a
000000r 1               ; line being drained does not flap the pin.
000000r 1               SC_RTS_HIGH_WATER   = $C0                ; Unread bytes at which RTS goes up
000000r 1               SC_RTS_LOW_WATER    = $80                ; Unread bytes below which RTS comes down
000000r 1               
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   ROM
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .segment "ROM"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   CartReset — power-on entry point
000000r 1               ; =============================================================================
000000r 1               ;   RESET vectors here.  Resets the stack, runs KernalInit to bring up the
000000r 1               ;   Kernal RAM vectors and probe the base system, overrides the BRK vector so
000000r 1               ;   a BRK from executed user code returns cleanly instead of diving into the
000000r 1               ;   now-overlaid BIOS monitor, brings up the LCD and keypad PIA, seeds the
000000r 1               ;   monitor state, shows the splash on both consoles, then holds on the splash
000000r 1               ;   gate until an ESC arrives.
000000r 1               ;
000000r 1               ;   Key entry is interrupt driven, so after init it repoints IRQ_PTR at the
000000r 1               ;   local KeyIrq handler and enables interrupts (CLI) before showing the
000000r 1               ;   splash.  BRK is unaffected by the I flag; the BRK_PTR override below keeps
000000r 1               ;   a BRK in executed user code from entering the overlaid BIOS monitor.
000000r 1               ;
000000r 1               ;   THE SPLASH GATE.  Both consoles say "--ESC TO START--" and both mean the
000000r 1               ;   same thing: ESC, and only ESC, starts the monitor.  ESC from either source
000000r 1               ;   starts BOTH — it is caught in KeyIrq (the KEY_ESC keycode from the keypad,
000000r 1               ;   a $1B byte from the serial card) and jumps to WarmStart, which discards
000000r 1               ;   everything typed at the splash, paints the LCD, and only then emits the
000000r 1               ;   first serial prompt.  Nothing is echoed or acted on before that, so the
000000r 1               ;   terminal never shows a "> " with no parser behind it.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               CartReset:
000000r 1  78             sei
000001r 1  A2 FF          ldx #$ff
000003r 1  9A             txs                           ; Reset the stack pointer (required by KernalInit)
000004r 1               
000004r 1  20 78 A0       jsr KernalInit                ; Init Kernal RAM vectors + probe base system
000007r 1                                               ; (clears decimal mode, leaves interrupts off)
000007r 1               
000007r 1                 ; Override the BRK vector: KernalInit points it at the BIOS monitor, which
000007r 1                 ; the cartridge has overlaid.  Route BRK to a local RTI handler instead.
000007r 1  A9 rr          lda #<BrkHandler
000009r 1  8D 02 03       sta BRK_PTR
00000Cr 1  A9 rr          lda #>BrkHandler
00000Er 1  8D 03 03       sta BRK_PTR + 1
000011r 1               
000011r 1                 ; Route the IRQ through our keypad handler.  KernalInit set IRQ_PTR to the
000011r 1                 ; Kernal's own IRQ service; the cart drives only the keypad, so take it over.
000011r 1  A9 rr          lda #<KeyIrq
000013r 1  8D 00 03       sta IRQ_PTR
000016r 1  A9 rr          lda #>KeyIrq
000018r 1  8D 01 03       sta IRQ_PTR + 1
00001Br 1               
00001Br 1  20 rr rr       jsr LcdInit                   ; Bring up the LCD (must precede PiaInit)
00001Er 1  20 rr rr       jsr PiaInit                   ; Configure keypad + enable CA1 IRQ, clear flag
000021r 1               
000021r 1  20 rr rr       jsr SerInit                   ; Bring up the serial card + Wozmon parser state
000024r 1               
000024r 1  64 45          stz KEY_READY                 ; no key pending yet
000026r 1               
000026r 1                 ; Seed monitor state: start at user RAM ($0800), edit mode off
000026r 1  A9 00          lda #<PROGRAM_START
000028r 1  85 40          sta CUR_ADDR
00002Ar 1  A9 08          lda #>PROGRAM_START
00002Cr 1  85 41          sta CUR_ADDR + 1
00002Er 1  64 42          stz MODE
000030r 1               
000030r 1  58             cli                           ; enable IRQs — keypad CA1 + serial RX drive input
000031r 1               
000031r 1                 ; LCD splash first — it must never depend on the serial terminal being
000031r 1                 ; connected.  (SerialChrout/our serial TX blocks on TDRE, which the R65C51
000031r 1                 ; gates on /CTS; with no terminal connected the serial banner would stall.)
000031r 1  20 rr rr       jsr ShowSplash                ; "KIM MONITOR v1.0" / "--ESC TO START--"
000034r 1               
000034r 1                 ; The same two lines over the wire, so the terminal is told exactly what the
000034r 1                 ; panel says.  Emitted through the non-blocking SerPutc path, so a missing or
000034r 1                 ; disconnected terminal just drops these bytes instead of hanging the keypad
000034r 1                 ; monitor.  No prompt yet — see the gate below.
000034r 1  A9 0D          lda #CHAR_CR
000036r 1  20 rr rr       jsr SerEcho                   ; CR -> CR/LF: start on a clean line
000039r 1  A9 rr          lda #<SplashL1
00003Br 1  85 02          sta STR_PTR
00003Dr 1  A9 rr          lda #>SplashL1
00003Fr 1  85 03          sta STR_PTR + 1
000041r 1  20 rr rr       jsr SerPrintStr               ; "KIM MONITOR v1.0"
000044r 1  A9 0D          lda #CHAR_CR
000046r 1  20 rr rr       jsr SerEcho
000049r 1  A9 rr          lda #<SplashL2
00004Br 1  85 02          sta STR_PTR
00004Dr 1  A9 rr          lda #>SplashL2
00004Fr 1  85 03          sta STR_PTR + 1
000051r 1  20 rr rr       jsr SerPrintStr               ; "--ESC TO START--"
000054r 1               
000054r 1                 ; Splash gate.  ESC — and nothing else — starts the monitor, identically
000054r 1                 ; from either console: KeyIrq catches KEY_ESC from the keypad and $1B from
000054r 1                 ; the serial card and JMPs to WarmStart, which flushes both inputs, paints
000054r 1                 ; the address/byte display on the LCD, and only then emits the first serial
000054r 1                 ; prompt.  So there is nothing to poll for here; anything typed or pressed
000054r 1                 ; at the splash is discarded by WarmStart rather than echoed, acted on, or
000054r 1                 ; left in the ring to execute later.
000054r 1               @WaitStart:
000054r 1  80 FE          bra @WaitStart                ; ESC (either console) -> KeyIrq -> WarmStart
000056r 1               
000056r 1               
000056r 1               ; =============================================================================
000056r 1               ;   MONITOR STATE MACHINE
000056r 1               ; =============================================================================
000056r 1               ;   A KIM-1-style memory monitor.  The display shows the current address and
000056r 1               ;   the byte stored there; the keypad navigates, edits, and executes.
000056r 1               ;
000056r 1               ;     LEFT / RIGHT   address -1 / +1
000056r 1               ;     PGUP / PGDN    address +$0100 / -$0100
000056r 1               ;     0-F            INS off: shift a hex nibble into the address (KIM-1 style)
000056r 1               ;                    INS on : shift a hex nibble into the byte at the address
000056r 1               ;     INS            toggle edit mode
000056r 1               ;     DEL            zero the byte at the address, cancel edit mode
000056r 1               ;     UP             execute via JSR (jmp (CUR_ADDR)); RTS returns to monitor
000056r 1               ;     ESC            break-to-monitor abort (handled in KeyIrq -> WarmStart)
000056r 1               ; =============================================================================
000056r 1               
000056r 1               ; -----------------------------------------------------------------------------
000056r 1               ;   WarmStart — break-to-monitor abort target
000056r 1               ; -----------------------------------------------------------------------------
000056r 1               ;   Entered by JMP from KeyIrq when an ESC arrives from EITHER source — the
000056r 1               ;   keypad ESC key or an ESC byte over serial — from anywhere, including a
000056r 1               ;   program launched with keypad UP or with the serial "R" command.  The
000056r 1               ;   interrupted stack frame is abandoned: ESC is a panic "return to the
000056r 1               ;   monitor" and does not restore the aborted caller.
000056r 1               ;
000056r 1               ;   Resets the stack pointer (the IRQ and whatever it interrupted are
000056r 1               ;   discarded), cancels any in-progress INS edit, discards pending input from
000056r 1               ;   BOTH sources, re-enables interrupts (KeyIrq was entered with I set),
000056r 1               ;   repaints the keypad monitor (LCD) and re-arms the serial monitor with a
000056r 1               ;   fresh prompt, then re-enters the monitor loop.
000056r 1               ;
000056r 1               ;   Discarding both inputs is what makes the two consoles agree.  This is also
000056r 1               ;   the boot path (CartReset's splash gate falls in here on the first ESC), so
000056r 1               ;   a key pressed or a line typed at the splash must not be dispatched or
000056r 1               ;   parsed afterwards — an aborted program's leftover keystrokes have no more
000056r 1               ;   business running than a splash-screen one does.
000056r 1               ; -----------------------------------------------------------------------------
000056r 1               WarmStart:
000056r 1  A2 FF          ldx #$ff
000058r 1  9A             txs                           ; discard the interrupted stack frame
000059r 1  64 42          stz MODE                      ; cancel any in-progress INS edit
00005Br 1  64 45          stz KEY_READY                 ; drop any keypad press latched but not yet
00005Dr 1                                               ;   dispatched (still inside the IRQ-masked
00005Dr 1  A5 46          lda SER_RXHEAD                ;   window, so KeyIrq cannot race either flush)
00005Fr 1  85 47          sta SER_RXTAIL                ; flush any buffered serial input
000061r 1  64 51          stz SER_DIRTY                 ; (SerPrompt below resets the line buffer)
000063r 1  20 rr rr       jsr ScRts                     ; the ring is empty now — let the far end talk
000066r 1  58             cli                           ; KeyIrq left I set — re-enable IRQs
000067r 1  20 rr rr       jsr RefreshDisplay            ; repaint the keypad monitor (LCD)
00006Ar 1  20 rr rr       jsr SerPrompt                 ; and re-arm the serial monitor (fresh prompt)
00006Dr 1  4C rr rr       jmp MonitorLoop
000070r 1               
000070r 1               ; -----------------------------------------------------------------------------
000070r 1               ;   MonitorLoop — cooperative poll of both inputs
000070r 1               ; -----------------------------------------------------------------------------
000070r 1               ;   The keypad and the Wozmon serial monitor run concurrently from this one
000070r 1               ;   loop; neither input blocks.  A keypad press is dispatched and repaints the
000070r 1               ;   LCD.  Serial bytes are drained into the Wozmon line parser; when a serial
000070r 1               ;   line deposits into memory the SER_DIRTY flag triggers a refresh so the
000070r 1               ;   change shows on the LCD at the current address.
000070r 1               ;
000070r 1               ;   THE RING IS DRAINED DRY, AND THE PANEL REPAINTED ONCE.  This loop used to
000070r 1               ;   take a single byte per pass and repaint after every line that deposited.  A
000070r 1               ;   RefreshDisplay is about 34 LCD writes at ~640 us apiece — some 22 ms — and
000070r 1               ;   at 19,200 baud 42 more bytes land during it.  Twenty deposit lines cost
000070r 1               ;   more panel time than the paste takes to arrive, the loop fell steadily
000070r 1               ;   further behind, and the ring lapped its own reader: nine of twenty lines
000070r 1               ;   went missing.  So SerDrain now runs the ring down to empty, lines and all,
000070r 1               ;   and the panel is repainted once at the end of the batch.  What a paste
000070r 1               ;   costs in LCD time is now one repaint, not one per line.
000070r 1               ;
000070r 1               ;   A keypad press during a long paste waits in the KeyIrq mailbox until the
000070r 1               ;   drain finishes; it is not lost.  ESC does not wait — it is caught in the
000070r 1               ;   ISR itself and goes straight to WarmStart.
000070r 1               ; -----------------------------------------------------------------------------
000070r 1               MonitorLoop:
000070r 1  20 rr rr       jsr KeyPoll                   ; C=1 -> A = keycode (0-23)
000073r 1  90 06          bcc @Serial
000075r 1  20 rr rr       jsr Dispatch
000078r 1  20 rr rr       jsr RefreshDisplay
00007Br 1               @Serial:
00007Br 1  20 rr rr       jsr SerDrain                  ; every byte the ring holds, lines and all
00007Er 1  A5 51          lda SER_DIRTY                 ; did a serial deposit change memory?
000080r 1  F0 EE          beq MonitorLoop
000082r 1  64 51          stz SER_DIRTY
000084r 1  20 rr rr       jsr RefreshDisplay            ; one repaint for the whole batch, ring now dry
000087r 1  80 E7          bra MonitorLoop
000089r 1               
000089r 1               ; -----------------------------------------------------------------------------
000089r 1               ;   Dispatch — act on a keycode
000089r 1               ;   In: A = keycode (0-23)
000089r 1               ;   Modifies: A, X, Y
000089r 1               ; -----------------------------------------------------------------------------
000089r 1               Dispatch:
000089r 1  C9 00          cmp #KEY_LEFT
00008Br 1  F0 28          beq DoLeft
00008Dr 1  C9 0B          cmp #KEY_RIGHT
00008Fr 1  F0 2D          beq DoRight
000091r 1  C9 12          cmp #KEY_PGUP
000093r 1  F0 30          beq DoPgUp
000095r 1  C9 16          cmp #KEY_PGDN
000097r 1  F0 2F          beq DoPgDn
000099r 1  C9 11          cmp #KEY_INS
00009Br 1  F0 2E          beq DoIns
00009Dr 1  C9 15          cmp #KEY_DEL
00009Fr 1  F0 31          beq DoDel
0000A1r 1  C9 14          cmp #KEY_UP
0000A3r 1  F0 36          beq DoUp
0000A5r 1  20 rr rr       jsr KeyToHex                  ; hex digit?  C=1 -> A = nibble (0-15)
0000A8r 1  90 0A          bcc @Done                     ; non-hex key: ignore
0000AAr 1  A6 42          ldx MODE
0000ACr 1  D0 03          bne @EditData                 ; INS on: edit the byte at the address
0000AEr 1  4C rr rr       jmp ShiftAddrNibble           ; INS off: shift the nibble into the address
0000B1r 1               @EditData:
0000B1r 1  4C rr rr       jmp ShiftDataNibble
0000B4r 1               @Done:
0000B4r 1  60             rts
0000B5r 1               
0000B5r 1               ; --- Navigation -------------------------------------------------------------
0000B5r 1               DoLeft:
0000B5r 1  A5 40          lda CUR_ADDR
0000B7r 1  D0 02          bne @NoBorrow
0000B9r 1  C6 41          dec CUR_ADDR + 1
0000BBr 1               @NoBorrow:
0000BBr 1  C6 40          dec CUR_ADDR
0000BDr 1  60             rts
0000BEr 1               
0000BEr 1               DoRight:
0000BEr 1  E6 40          inc CUR_ADDR
0000C0r 1  D0 02          bne @Done
0000C2r 1  E6 41          inc CUR_ADDR + 1
0000C4r 1               @Done:
0000C4r 1  60             rts
0000C5r 1               
0000C5r 1               DoPgUp:
0000C5r 1  E6 41          inc CUR_ADDR + 1              ; +$0100
0000C7r 1  60             rts
0000C8r 1               
0000C8r 1               DoPgDn:
0000C8r 1  C6 41          dec CUR_ADDR + 1              ; -$0100
0000CAr 1  60             rts
0000CBr 1               
0000CBr 1               ; --- Mode / edit ------------------------------------------------------------
0000CBr 1               DoIns:
0000CBr 1  A5 42          lda MODE
0000CDr 1  49 01          eor #MODE_INS                 ; toggle the edit-mode flag
0000CFr 1  85 42          sta MODE
0000D1r 1  60             rts
0000D2r 1               
0000D2r 1               DoDel:
0000D2r 1  A9 00          lda #$00
0000D4r 1  A0 00          ldy #$00
0000D6r 1  91 40          sta (CUR_ADDR),y              ; zero the byte at the address
0000D8r 1  64 42          stz MODE                      ; cancel edit mode
0000DAr 1  60             rts
0000DBr 1               
0000DBr 1               ; --- Execute ----------------------------------------------------------------
0000DBr 1               DoUp:
0000DBr 1  20 rr rr       jsr CallUser                  ; jmp (CUR_ADDR); user RTS returns here
0000DEr 1  60             rts
0000DFr 1               
0000DFr 1               CallUser:
0000DFr 1  6C 40 00       jmp (CUR_ADDR)
0000E2r 1               
0000E2r 1               ; -----------------------------------------------------------------------------
0000E2r 1               ;   ShiftAddrNibble — shift one hex nibble into CUR_ADDR (KIM-1 style)
0000E2r 1               ;   In: A = nibble (low 4 bits)
0000E2r 1               ;   Modifies: A, X
0000E2r 1               ; -----------------------------------------------------------------------------
0000E2r 1               ShiftAddrNibble:
0000E2r 1  48             pha
0000E3r 1  A2 04          ldx #$04                      ; CUR_ADDR <<= 4 (16-bit)
0000E5r 1               @Shift:
0000E5r 1  06 40          asl CUR_ADDR
0000E7r 1  26 41          rol CUR_ADDR + 1
0000E9r 1  CA             dex
0000EAr 1  D0 F9          bne @Shift
0000ECr 1  68             pla
0000EDr 1  05 40          ora CUR_ADDR                  ; OR the new nibble into the low byte
0000EFr 1  85 40          sta CUR_ADDR
0000F1r 1  60             rts
0000F2r 1               
0000F2r 1               ; -----------------------------------------------------------------------------
0000F2r 1               ;   ShiftDataNibble — shift one hex nibble into the byte at CUR_ADDR
0000F2r 1               ;   In: A = nibble (low 4 bits)
0000F2r 1               ;   Modifies: A, Y
0000F2r 1               ; -----------------------------------------------------------------------------
0000F2r 1               ShiftDataNibble:
0000F2r 1  85 43          sta MON_TMP
0000F4r 1  A0 00          ldy #$00
0000F6r 1  B1 40          lda (CUR_ADDR),y
0000F8r 1  0A             asl a                         ; old byte <<= 4
0000F9r 1  0A             asl a
0000FAr 1  0A             asl a
0000FBr 1  0A             asl a
0000FCr 1  05 43          ora MON_TMP                   ; OR in the new nibble
0000FEr 1  91 40          sta (CUR_ADDR),y
000100r 1  60             rts
000101r 1               
000101r 1               ; -----------------------------------------------------------------------------
000101r 1               ;   RefreshDisplay — render the monitor screen
000101r 1               ;   Line 1: ---$XXXX: $XX---   (address and the byte stored there)
000101r 1               ;   Line 2: 16 dashes, or a centered "INS" indicator when editing
000101r 1               ;   Modifies: A, X, Y
000101r 1               ; -----------------------------------------------------------------------------
000101r 1               RefreshDisplay:
000101r 1  A2 00          ldx #$00
000103r 1  A0 00          ldy #$00
000105r 1  20 rr rr       jsr LcdSetPos                 ; line 1, column 0
000108r 1               
000108r 1  A2 03          ldx #$03                      ; "---"
00010Ar 1  20 rr rr       jsr PrintDashN
00010Dr 1  A9 24          lda #'$'
00010Fr 1  20 rr rr       jsr LcdData
000112r 1  A5 41          lda CUR_ADDR + 1              ; address (high byte first)
000114r 1  20 rr rr       jsr PrintHexByte
000117r 1  A5 40          lda CUR_ADDR
000119r 1  20 rr rr       jsr PrintHexByte
00011Cr 1  A9 3A          lda #':'
00011Er 1  20 rr rr       jsr LcdData
000121r 1  A9 20          lda #CHAR_SPACE
000123r 1  20 rr rr       jsr LcdData
000126r 1  A9 24          lda #'$'
000128r 1  20 rr rr       jsr LcdData
00012Br 1  A0 00          ldy #$00                      ; byte at the current address
00012Dr 1  B1 40          lda (CUR_ADDR),y
00012Fr 1  20 rr rr       jsr PrintHexByte
000132r 1  A2 03          ldx #$03                      ; "---"
000134r 1  20 rr rr       jsr PrintDashN
000137r 1               
000137r 1  A2 00          ldx #$00
000139r 1  A0 01          ldy #$01
00013Br 1  20 rr rr       jsr LcdSetPos                 ; line 2, column 0
00013Er 1  A5 42          lda MODE
000140r 1  D0 06          bne @Ins
000142r 1  A2 10          ldx #$10                      ; 16 dashes
000144r 1  20 rr rr       jsr PrintDashN
000147r 1  60             rts
000148r 1               @Ins:
000148r 1  A2 06          ldx #$06                      ; 6 dashes + "INS" + 7 dashes = 16
00014Ar 1  20 rr rr       jsr PrintDashN
00014Dr 1  A9 49          lda #'I'
00014Fr 1  20 rr rr       jsr LcdData
000152r 1  A9 4E          lda #'N'
000154r 1  20 rr rr       jsr LcdData
000157r 1  A9 53          lda #'S'
000159r 1  20 rr rr       jsr LcdData
00015Cr 1  A2 07          ldx #$07
00015Er 1  20 rr rr       jsr PrintDashN
000161r 1  60             rts
000162r 1               
000162r 1               ; -----------------------------------------------------------------------------
000162r 1               ;   PrintDashN — print X dash characters
000162r 1               ;   In: X = count
000162r 1               ;   Modifies: A, X, Y
000162r 1               ; -----------------------------------------------------------------------------
000162r 1               PrintDashN:
000162r 1               @Loop:
000162r 1  E0 00          cpx #$00
000164r 1  F0 0A          beq @Done
000166r 1  DA             phx                           ; LcdData (via LcdDelay) clobbers X/Y
000167r 1  A9 2D          lda #'-'
000169r 1  20 rr rr       jsr LcdData
00016Cr 1  FA             plx
00016Dr 1  CA             dex
00016Er 1  80 F2          bra @Loop
000170r 1               @Done:
000170r 1  60             rts
000171r 1               
000171r 1               ; -----------------------------------------------------------------------------
000171r 1               ;   ShowSplash — clear the display and render the splash screen
000171r 1               ;   Modifies: A, X, Y
000171r 1               ; -----------------------------------------------------------------------------
000171r 1               ShowSplash:
000171r 1  20 rr rr       jsr LcdClear
000174r 1  A2 00          ldx #$00
000176r 1  A0 00          ldy #$00
000178r 1  20 rr rr       jsr LcdSetPos
00017Br 1  A9 rr          lda #<SplashL1
00017Dr 1  85 02          sta STR_PTR
00017Fr 1  A9 rr          lda #>SplashL1
000181r 1  85 03          sta STR_PTR + 1
000183r 1  20 rr rr       jsr LcdPrintStr
000186r 1  A2 00          ldx #$00
000188r 1  A0 01          ldy #$01
00018Ar 1  20 rr rr       jsr LcdSetPos
00018Dr 1  A9 rr          lda #<SplashL2
00018Fr 1  85 02          sta STR_PTR
000191r 1  A9 rr          lda #>SplashL2
000193r 1  85 03          sta STR_PTR + 1
000195r 1  20 rr rr       jsr LcdPrintStr
000198r 1  60             rts
000199r 1               
000199r 1               
000199r 1               ; =============================================================================
000199r 1               ;   LCD DRIVER
000199r 1               ; =============================================================================
000199r 1               ;   HD44780-compatible 16x2 display in 8-bit mode.  Port B carries the data
000199r 1               ;   bus; Port A carries RS/R-W/E on PA5/PA6/PA7.  Command/data writes use
000199r 1               ;   timed software delays instead of busy-flag polling (the R/W read-back
000199r 1               ;   path is not relied upon).
000199r 1               ; =============================================================================
000199r 1               
000199r 1               ; -----------------------------------------------------------------------------
000199r 1               ;   LcdDelay — short software busy delay (~640 us @ 1 MHz)
000199r 1               ; -----------------------------------------------------------------------------
000199r 1               ;   Used in place of busy-flag polling so the driver does not depend on the
000199r 1               ;   LCD R/W read-back path (PA6) working.  An HD44780 finishes a normal
000199r 1               ;   command/data write in ~37 us, so this single ~640 us loop carries a wide
000199r 1               ;   margin while staying short enough that a full RefreshDisplay (~34 writes)
000199r 1               ;   completes in ~22 ms — fast enough to keep the keypad responsive.  Callers
000199r 1               ;   add LcdLongDelay for the slow clear/home commands (~1.5 ms).
000199r 1               ;   Modifies: A, X
000199r 1               ; -----------------------------------------------------------------------------
000199r 1               LcdDelay:
000199r 1  A2 80          ldx #$80                      ; 128 * 5 cycles ≈ 640 us @ 1 MHz
00019Br 1               @Loop:
00019Br 1  CA             dex
00019Cr 1  D0 FD          bne @Loop
00019Er 1  60             rts
00019Fr 1               
00019Fr 1               ; -----------------------------------------------------------------------------
00019Fr 1               ;   LcdLongDelay — generous software delay for the power-on init ritual
00019Fr 1               ; -----------------------------------------------------------------------------
00019Fr 1               ;   Covers the HD44780 power-on timing (>15 ms first delay, >4.1 ms / >100 us
00019Fr 1               ;   between the function-set writes) and the slow clear/home commands (~1.5 ms).
00019Fr 1               ;   Self-contained — does not depend on KernalInit / SysDelay (and therefore
00019Fr 1               ;   not on HW_PRESENT / the VIA timer).  ~41 ms @ 1 MHz: comfortably above the
00019Fr 1               ;   >15 ms power-on minimum, yet short enough that boot (run with IRQs masked)
00019Fr 1               ;   no longer swallows early ESC presses.
00019Fr 1               ;   Modifies: A, X, Y
00019Fr 1               ; -----------------------------------------------------------------------------
00019Fr 1               LcdLongDelay:
00019Fr 1  A2 20          ldx #$20                      ; 32 * 256 * 5 cycles ≈ 41 ms @ 1 MHz
0001A1r 1               @Outer:
0001A1r 1  A0 00          ldy #$00
0001A3r 1               @Inner:
0001A3r 1  88             dey
0001A4r 1  D0 FD          bne @Inner
0001A6r 1  CA             dex
0001A7r 1  D0 F8          bne @Outer
0001A9r 1  60             rts
0001AAr 1               
0001AAr 1               ; -----------------------------------------------------------------------------
0001AAr 1               ;   LcdStrobe — pulse E high then low (data already on Port B, RS/R-W in A)
0001AAr 1               ; -----------------------------------------------------------------------------
0001AAr 1               ;   In: A = Port A control value with E low (RS/R-W set, LCD_E clear)
0001AAr 1               ;   Modifies: A
0001AAr 1               ; -----------------------------------------------------------------------------
0001AAr 1               LcdStrobe:
0001AAr 1  8D 00 C0       sta PORTA                     ; control lines, E low
0001ADr 1  09 80          ora #LCD_E
0001AFr 1  8D 00 C0       sta PORTA                     ; E high
0001B2r 1  29 7F          and #<~LCD_E
0001B4r 1  8D 00 C0       sta PORTA                     ; E low — LCD latches on falling edge
0001B7r 1  60             rts
0001B8r 1               
0001B8r 1               ; -----------------------------------------------------------------------------
0001B8r 1               ;   LcdCmd — write a command byte (RS=0)
0001B8r 1               ;   In: A = command
0001B8r 1               ;   Modifies: A, X, Y
0001B8r 1               ; -----------------------------------------------------------------------------
0001B8r 1               LcdCmd:
0001B8r 1  8D 02 C0       sta PORTB                     ; command byte on the data bus
0001BBr 1  A9 00          lda #$00                      ; RS=0, R/W=0, E=0
0001BDr 1  20 rr rr       jsr LcdStrobe
0001C0r 1  20 rr rr       jsr LcdDelay
0001C3r 1  60             rts
0001C4r 1               
0001C4r 1               ; -----------------------------------------------------------------------------
0001C4r 1               ;   LcdData — write a data byte (RS=1)
0001C4r 1               ;   In: A = data
0001C4r 1               ;   Modifies: A, X, Y
0001C4r 1               ; -----------------------------------------------------------------------------
0001C4r 1               LcdData:
0001C4r 1  8D 02 C0       sta PORTB                     ; data byte on the data bus
0001C7r 1  A9 20          lda #LCD_RS                   ; RS=1, R/W=0, E=0
0001C9r 1  20 rr rr       jsr LcdStrobe
0001CCr 1  20 rr rr       jsr LcdDelay
0001CFr 1  60             rts
0001D0r 1               
0001D0r 1               ; -----------------------------------------------------------------------------
0001D0r 1               ;   LcdCmdRaw — write a command byte (alias of LcdCmd)
0001D0r 1               ;   Retained for the power-on function-set sequence which adds its own
0001D0r 1               ;   longer inter-command delays via LcdLongDelay.
0001D0r 1               ;   In: A = command
0001D0r 1               ;   Modifies: A, X, Y
0001D0r 1               ; -----------------------------------------------------------------------------
0001D0r 1               LcdCmdRaw = LcdCmd
0001D0r 1               
0001D0r 1               ; -----------------------------------------------------------------------------
0001D0r 1               ;   LcdInit — power-on initialization sequence
0001D0r 1               ;   Configures the PIA ports the LCD needs, then runs the HD44780 8-bit
0001D0r 1               ;   init: function set (2-line, 5x8), display on, clear, entry-mode increment.
0001D0r 1               ;   Uses software delays only — no KernalInit / SysDelay dependency.
0001D0r 1               ;   Modifies: A, X, Y
0001D0r 1               ; -----------------------------------------------------------------------------
0001D0r 1               LcdInit:
0001D0r 1                 ; Port A: PA5-7 outputs (LCD control), PA0-4 inputs (keypad code)
0001D0r 1  A9 00          lda #CR_DDR
0001D2r 1  8D 01 C0       sta CRA
0001D5r 1  A9 E0          lda #LCD_DDRA
0001D7r 1  8D 00 C0       sta PORTA                     ; (DDRA) = $E0
0001DAr 1  A9 04          lda #CR_PORT
0001DCr 1  8D 01 C0       sta CRA
0001DFr 1  A9 00          lda #$00
0001E1r 1  8D 00 C0       sta PORTA                     ; control lines low (RS=0, R/W=0, E=0)
0001E4r 1               
0001E4r 1                 ; Port B: all outputs (LCD data bus)
0001E4r 1  A9 00          lda #CR_DDR
0001E6r 1  8D 03 C0       sta CRB
0001E9r 1  A9 FF          lda #$FF
0001EBr 1  8D 02 C0       sta PORTB                     ; (DDRB) all outputs
0001EEr 1  A9 04          lda #CR_PORT
0001F0r 1  8D 03 C0       sta CRB
0001F3r 1               
0001F3r 1                 ; Power-on settle: > 15 ms
0001F3r 1  20 rr rr       jsr LcdLongDelay
0001F6r 1               
0001F6r 1                 ; Function set x3 with long inter-command delays (HD44780 reset ritual)
0001F6r 1  A9 30          lda #$30
0001F8r 1  20 rr rr       jsr LcdCmdRaw
0001FBr 1  20 rr rr       jsr LcdLongDelay              ; > 4.1 ms
0001FEr 1  A9 30          lda #$30
000200r 1  20 rr rr       jsr LcdCmdRaw
000203r 1  20 rr rr       jsr LcdLongDelay              ; > 100 us
000206r 1  A9 30          lda #$30
000208r 1  20 rr rr       jsr LcdCmdRaw
00020Br 1  20 rr rr       jsr LcdLongDelay
00020Er 1               
00020Er 1                 ; Remaining configuration commands (each followed by LcdDelay)
00020Er 1  A9 38          lda #$38                      ; function set: 8-bit, 2-line, 5x8 font
000210r 1  20 rr rr       jsr LcdCmd
000213r 1  A9 08          lda #$08                      ; display off
000215r 1  20 rr rr       jsr LcdCmd
000218r 1  A9 01          lda #$01                      ; clear display
00021Ar 1  20 rr rr       jsr LcdCmd
00021Dr 1  20 rr rr       jsr LcdLongDelay              ; clear is slow (~1.5 ms) — extra settle
000220r 1  A9 06          lda #$06                      ; entry mode: increment, no display shift
000222r 1  20 rr rr       jsr LcdCmd
000225r 1  A9 0C          lda #$0C                      ; display on, cursor off, blink off
000227r 1  20 rr rr       jsr LcdCmd
00022Ar 1  60             rts
00022Br 1               
00022Br 1               ; -----------------------------------------------------------------------------
00022Br 1               ;   LcdClear — clear the display and home the cursor
00022Br 1               ;   Modifies: A, X
00022Br 1               ; -----------------------------------------------------------------------------
00022Br 1               LcdClear:
00022Br 1  A9 01          lda #$01
00022Dr 1  20 rr rr       jsr LcdCmd
000230r 1  20 rr rr       jsr LcdLongDelay              ; clear/home is slow (~1.5 ms) — LcdDelay alone
000233r 1  60             rts                           ;   is now too short to cover it
000234r 1               
000234r 1               ; -----------------------------------------------------------------------------
000234r 1               ;   LcdSetPos — move the cursor to (column, row)
000234r 1               ;   In: X = column (0-15), Y = row (0-1)
000234r 1               ;   Modifies: A, X
000234r 1               ; -----------------------------------------------------------------------------
000234r 1               LcdSetPos:
000234r 1  8A             txa
000235r 1  C0 00          cpy #$00
000237r 1  F0 03          beq @Row1
000239r 1  18             clc
00023Ar 1  69 40          adc #$40                      ; row 2 DDRAM base offset
00023Cr 1               @Row1:
00023Cr 1  09 80          ora #$80                      ; "Set DDRAM address" command
00023Er 1  20 rr rr       jsr LcdCmd
000241r 1  60             rts
000242r 1               
000242r 1               ; -----------------------------------------------------------------------------
000242r 1               ;   LcdPrintStr — print a null-terminated string
000242r 1               ;   In: STR_PTR ($02-$03) = pointer to string
000242r 1               ;   Modifies: A, X, Y
000242r 1               ; -----------------------------------------------------------------------------
000242r 1               LcdPrintStr:
000242r 1  A0 00          ldy #$00
000244r 1               @Loop:
000244r 1  B1 02          lda (STR_PTR),y
000246r 1  F0 08          beq @Done                     ; null terminator
000248r 1  5A             phy                           ; LcdData (via delays) clobbers Y
000249r 1  20 rr rr       jsr LcdData
00024Cr 1  7A             ply
00024Dr 1  C8             iny
00024Er 1  D0 F4          bne @Loop                     ; max 256 chars per call
000250r 1               @Done:
000250r 1  60             rts
000251r 1               
000251r 1               ; -----------------------------------------------------------------------------
000251r 1               ;   PrintHexNib — print the low nibble of A as a hex digit
000251r 1               ;   In: A = value (low nibble used)
000251r 1               ;   Modifies: A, X
000251r 1               ; -----------------------------------------------------------------------------
000251r 1               PrintHexNib:
000251r 1  29 0F          and #$0F
000253r 1  C9 0A          cmp #$0A
000255r 1  90 04          bcc @Digit
000257r 1  69 36          adc #$36                      ; C=1: 10..15 + $37 -> 'A'..'F'
000259r 1  D0 02          bne @Send                     ; result always nonzero
00025Br 1               @Digit:
00025Br 1  69 30          adc #$30                      ; C=0: 0..9 + $30 -> '0'..'9'
00025Dr 1               @Send:
00025Dr 1  20 rr rr       jsr LcdData
000260r 1  60             rts
000261r 1               
000261r 1               ; -----------------------------------------------------------------------------
000261r 1               ;   PrintHexByte — print A as two hex digits
000261r 1               ;   In: A = byte
000261r 1               ;   Modifies: A, X
000261r 1               ; -----------------------------------------------------------------------------
000261r 1               PrintHexByte:
000261r 1  48             pha
000262r 1  4A             lsr a
000263r 1  4A             lsr a
000264r 1  4A             lsr a
000265r 1  4A             lsr a
000266r 1  20 rr rr       jsr PrintHexNib               ; high nibble
000269r 1  68             pla
00026Ar 1  20 rr rr       jsr PrintHexNib               ; low nibble
00026Dr 1  60             rts
00026Er 1               
00026Er 1               ; -----------------------------------------------------------------------------
00026Er 1               ;   PrintHexWord — print a 16-bit value as four hex digits (high byte first)
00026Er 1               ;   In: X = high byte, A = low byte
00026Er 1               ;   Modifies: A, X
00026Er 1               ; -----------------------------------------------------------------------------
00026Er 1               PrintHexWord:
00026Er 1  48             pha
00026Fr 1  8A             txa
000270r 1  20 rr rr       jsr PrintHexByte              ; high byte
000273r 1  68             pla
000274r 1  20 rr rr       jsr PrintHexByte              ; low byte
000277r 1  60             rts
000278r 1               
000278r 1               
000278r 1               ; =============================================================================
000278r 1               ;   KEYPAD DRIVER
000278r 1               ; =============================================================================
000278r 1               ;   The 74C922 keypad encoder drives PA0-PA4 with a 5-bit keycode and pulses
000278r 1               ;   CA1 (positive edge) when a key becomes available.  CA2 is held low to
000278r 1               ;   enable the encoder's active-low output enable.  Key entry is interrupt
000278r 1               ;   driven: the CA1 edge fires KeyIrq, which latches the keycode into a small
000278r 1               ;   mailbox (KEY_CODE/KEY_READY) that the monitor loop drains via KeyWait.
000278r 1               ; =============================================================================
000278r 1               
000278r 1               ; -----------------------------------------------------------------------------
000278r 1               ;   PiaInit — configure the PIA for keypad input (and Port B for LCD data)
000278r 1               ; -----------------------------------------------------------------------------
000278r 1               ;   Sets DDRA so PA5-7 are outputs (LCD control) and PA0-4 inputs (keycode),
000278r 1               ;   DDRB all outputs (LCD data bus), then writes the keypad CRA value which
000278r 1               ;   enables the 74C922 (CA2 low) and arms CA1 on the positive edge with its
000278r 1               ;   interrupt ENABLED.  The CPU IRQ must stay masked until the caller is
000278r 1               ;   ready — CartReset CLIs only after this returns.  Reads PORTA once to clear
000278r 1               ;   any stale CA1 flag.  Must be called AFTER LcdInit (leaves CRA on PORT).
000278r 1               ;   Modifies: A
000278r 1               ; -----------------------------------------------------------------------------
000278r 1               PiaInit:
000278r 1                 ; Port A direction: PA5-7 outputs, PA0-4 inputs
000278r 1  A9 00          lda #CR_DDR
00027Ar 1  8D 01 C0       sta CRA
00027Dr 1  A9 E0          lda #LCD_DDRA                 ; $E0
00027Fr 1  8D 00 C0       sta PORTA                     ; (DDRA)
000282r 1               
000282r 1                 ; Port B direction: all outputs (LCD data bus)
000282r 1  A9 00          lda #CR_DDR
000284r 1  8D 03 C0       sta CRB
000287r 1  A9 FF          lda #$FF
000289r 1  8D 02 C0       sta PORTB                     ; (DDRB)
00028Cr 1  A9 04          lda #CR_PORT
00028Er 1  8D 03 C0       sta CRB                       ; select PORTB data register
000291r 1               
000291r 1                 ; Port A control: CA2 manual output low (74C922 OE), CA1 positive edge,
000291r 1                 ; CA1 IRQ enabled, PORTA data register selected
000291r 1  A9 37          lda #PIA_CRA_KEYPAD           ; $37
000293r 1  8D 01 C0       sta CRA
000296r 1               
000296r 1  AD 00 C0       lda PORTA                     ; clear any pending CA1 flag
000299r 1  60             rts
00029Ar 1               
00029Ar 1               ; -----------------------------------------------------------------------------
00029Ar 1               ;   KeyIrq — CA1 (keypad data-available) interrupt handler
00029Ar 1               ; -----------------------------------------------------------------------------
00029Ar 1               ;   Installed in IRQ_PTR by CartReset and reached through the IRQ vector
00029Ar 1               ;   trampoline (jmp (IRQ_PTR)).  Because the cartridge owns the IRQ, this
00029Ar 1               ;   handler also dispatches BRK (which shares the vector) to BRK_PTR so
00029Ar 1               ;   executed user code keeps its clean-return behaviour.
00029Ar 1               ;
00029Ar 1               ;   The IRQ has two sources sharing the line: the R65C51 serial RX
00029Ar 1               ;   and the keypad CA1 edge.  Serial is serviced first so a fast host stream
00029Ar 1               ;   is never dropped while a key is also pending: if SC_STATUS shows RDRF, the
00029Ar 1               ;   byte is read; an ESC byte triggers a break-to-monitor abort (WarmStart),
00029Ar 1               ;   any other byte is handed to ScRxStore, which pushes it into the SER_RXBUF
00029Ar 1               ;   ring — dropping it rather than lapping the reader if the ring is full — and
00029Ar 1               ;   raises RTS once the ring passes its high-water mark.  The serial half is
00029Ar 1               ;   skipped entirely when no Serial Card was probed (HW_SC clear), so a
00029Ar 1               ;   keypad-only machine never reads a floating bus here.  Then, on a keypad CA1
00029Ar 1               ;   edge it reads PORTA *once*, right at the data-available edge where the
00029Ar 1               ;   74C922 outputs are valid, masks the 5-bit keycode, rejects out-of-range
00029Ar 1               ;   phantom codes, and either aborts on the ESC key or stores the keycode in
00029Ar 1               ;   the KEY_CODE/KEY_READY mailbox.  Reading PORTA clears the CA1 flag.
00029Ar 1               ;   Modifies: nothing visible (saves/restores A and X)
00029Ar 1               ; -----------------------------------------------------------------------------
00029Ar 1               KeyIrq:
00029Ar 1  48             pha
00029Br 1  DA             phx
00029Cr 1  BA             tsx
00029Dr 1  BD 03 01       lda $0103,x                   ; stacked processor status (P)
0002A0r 1  29 10          and #$10                      ; B flag set -> this was a BRK, not an IRQ
0002A2r 1  D0 37          bne @Brk
0002A4r 1               
0002A4r 1                 ; Two sources share the CPU /IRQ line: the keypad PIA (CA1 edge) and the
0002A4r 1                 ; R65C51 ACIA (serial RX).  Both are serviced every entry, and the loop
0002A4r 1                 ; below keeps draining until neither has work pending — this is what keeps a
0002A4r 1                 ; break-to-monitor ESC reliable from *either* source while a launched program
0002A4r 1                 ; is running (the cooperative main loop, and thus the SerFeed parser, is
0002A4r 1                 ; suspended then, so ESC must be caught here in the ISR).  The keypad is
0002A4r 1                 ; checked first because that path is the proven one; the serial
0002A4r 1                 ; drain loop guarantees a serial ESC can never be stranded behind an ACIA
0002A4r 1                 ; receive overrun.
0002A4r 1               @Scan:
0002A4r 1                 ; --- Keypad CA1 source ----------------------------------------------------
0002A4r 1  AD 01 C0       lda CRA
0002A7r 1  29 80          and #PIA_CA1_FLAG             ; keypad data-available?
0002A9r 1  F0 13          beq @Serial                   ; no keypad edge — go drain the serial card
0002ABr 1  AD 00 C0       lda PORTA                     ; latch keycode (also clears the CA1 flag)
0002AEr 1  29 1F          and #KEY_MASK                 ; keep PA0-4 (0-31)
0002B0r 1  C9 10          cmp #KEY_ESC                  ; ESC is a break-to-monitor abort
0002B2r 1  F0 2C          beq @Esc                      ; -> WarmStart, never reaches the mailbox
0002B4r 1  C9 18          cmp #KEY_COUNT
0002B6r 1  B0 06          bcs @Serial                   ; phantom code >= 24 — discard, still drain SC
0002B8r 1  85 44          sta KEY_CODE                  ; mailbox: keycode
0002BAr 1  A9 01          lda #$01
0002BCr 1  85 45          sta KEY_READY                 ; signal the monitor loop
0002BEr 1               
0002BEr 1                 ; --- Serial RX source (R65C51 ACIA) ---------------------------------------
0002BEr 1               @Serial:
0002BEr 1  AD 0D 03       lda HW_PRESENT
0002C1r 1  29 10          and #HW_SC                    ; no Serial Card -> $9001 is open bus, and a
0002C3r 1  F0 13          beq @Exit                     ;   floating RDRF would inject phantom bytes
0002C5r 1  AD 01 90       lda SC_STATUS                 ; reading status also clears the ACIA IRQ flag
0002C8r 1  29 08          and #SC_STATUS_RDRF           ; RX data register full?
0002CAr 1  F0 0C          beq @Exit                     ; nothing buffered in the ACIA — done
0002CCr 1  AD 00 90       lda SC_DATA                   ; read it (clears RDRF / the overrun flag)
0002CFr 1  C9 1B          cmp #CHAR_ESC                 ; serial ESC is a break-to-monitor abort, just
0002D1r 1  F0 0D          beq @Esc                      ;   like the keypad ESC key -> WarmStart
0002D3r 1  20 rr rr       jsr ScRxStore                 ; otherwise push it into the ring (never lapping
0002D6r 1                                               ;   the reader) and set RTS for what is now in it
0002D6r 1  80 CC          bra @Scan                     ; got a byte — re-scan both sources (drains the
0002D8r 1                                               ;   ACIA fully so a queued ESC is never missed)
0002D8r 1               @Exit:
0002D8r 1  FA             plx
0002D9r 1  68             pla
0002DAr 1  40             rti
0002DBr 1               @Brk:
0002DBr 1  FA             plx                           ; restore regs; leave P/PCL/PCH on the stack
0002DCr 1  68             pla
0002DDr 1  6C 02 03       jmp (BRK_PTR)                 ; BrkHandler RTIs back to the user code
0002E0r 1               @Esc:
0002E0r 1  4C rr rr       jmp WarmStart                 ; abandon the interrupted frame, re-enter monitor
0002E3r 1               
0002E3r 1               ; -----------------------------------------------------------------------------
0002E3r 1               ;   KeyPoll — non-blocking keypad read (drains the KeyIrq mailbox)
0002E3r 1               ;   Out: C=1 -> A = keycode (0-23);  C=0 -> no key pending (A undefined)
0002E3r 1               ;   Modifies: A
0002E3r 1               ; -----------------------------------------------------------------------------
0002E3r 1               KeyPoll:
0002E3r 1  A5 45          lda KEY_READY
0002E5r 1  F0 08          beq @None                     ; nothing latched
0002E7r 1  78             sei                           ; grab the mailbox atomically vs KeyIrq
0002E8r 1  A5 44          lda KEY_CODE
0002EAr 1  64 45          stz KEY_READY
0002ECr 1  58             cli
0002EDr 1  38             sec                           ; C=1: key available
0002EEr 1  60             rts
0002EFr 1               @None:
0002EFr 1  18             clc                           ; C=0: no key
0002F0r 1  60             rts
0002F1r 1               
0002F1r 1               ; -----------------------------------------------------------------------------
0002F1r 1               ;   KeyWait — block until a key is available
0002F1r 1               ;   Out: A = keycode (0-23)
0002F1r 1               ;   Modifies: A
0002F1r 1               ; -----------------------------------------------------------------------------
0002F1r 1               KeyWait:
0002F1r 1  20 rr rr       jsr KeyPoll
0002F4r 1  90 FB          bcc KeyWait
0002F6r 1  60             rts
0002F7r 1               
0002F7r 1               ; -----------------------------------------------------------------------------
0002F7r 1               ;   KeyToSym — translate a keycode to a printable LCD symbol
0002F7r 1               ;   In:  A = keycode (0-23)
0002F7r 1               ;   Out: A = display character
0002F7r 1               ;   Modifies: A, X
0002F7r 1               ; -----------------------------------------------------------------------------
0002F7r 1               KeyToSym:
0002F7r 1  AA             tax
0002F8r 1  BD rr rr       lda KeySymTable,x
0002FBr 1  60             rts
0002FCr 1               
0002FCr 1               
0002FCr 1               ; -----------------------------------------------------------------------------
0002FCr 1               ;   KeyToHex — translate a keycode to its hex nibble value
0002FCr 1               ; -----------------------------------------------------------------------------
0002FCr 1               ;   In:  A = keycode (0-23)
0002FCr 1               ;   Out: C=1 -> A = nibble (0-15) for a hex-digit key (0-9, A-F)
0002FCr 1               ;        C=0 -> the key is not a hex digit (A preserved as $FF)
0002FCr 1               ;   Modifies: A, X
0002FCr 1               ; -----------------------------------------------------------------------------
0002FCr 1               KeyToHex:
0002FCr 1  AA             tax
0002FDr 1  BD rr rr       lda HexValTable,x
000300r 1  C9 FF          cmp #$FF                      ; sentinel: not a hex digit
000302r 1  F0 02          beq @NotHex
000304r 1  38             sec                           ; C=1: A holds the nibble
000305r 1  60             rts
000306r 1               @NotHex:
000306r 1  18             clc                           ; C=0: not a hex key
000307r 1  60             rts
000308r 1               
000308r 1               
000308r 1               ; =============================================================================
000308r 1               ;   SERIAL WOZMON MONITOR
000308r 1               ; =============================================================================
000308r 1               ;   A Wozmon-compatible serial monitor that shares memory with the keypad
000308r 1               ;   monitor and runs concurrently with it.  The command language follows
000308r 1               ;   Apple-1 Wozmon, so bin2woz output (deposit lines of the form
000308r 1               ;   "ADDR: BB BB ...") is accepted byte-for-byte:
000308r 1               ;
000308r 1               ;     XXXX            examine the byte at XXXX
000308r 1               ;     XXXX.YYYY       examine the block XXXX..YYYY
000308r 1               ;     XXXX: BB BB ..  deposit bytes starting at XXXX (auto-incrementing)
000308r 1               ;     XXXX R          call XXXX as a subroutine; RTS returns to the prompt
000308r 1               ;
000308r 1               ;   Two deliberate departures from the original, in syntax neither:
000308r 1               ;
000308r 1               ;     - the prompt is "> " rather than "\".
000308r 1               ;     - "R" is a JSR, not Wozmon's JMP (XAML).  On this machine the keypad's
000308r 1               ;       UP key already runs the program under the cursor as a subroutine
000308r 1               ;       (DoUp -> CallUser), and an RTS comes back to a live monitor.  Serial
000308r 1               ;       "R" behaving differently made the two consoles disagree about what
000308r 1               ;       running a program means: original-Wozmon "R" left the parser for good,
000308r 1               ;       so a program that ended in RTS came back to a monitor with no prompt
000308r 1               ;       and a line buffer still holding the "XXXX R" that launched it — the
000308r 1               ;       next line typed appended to it and re-ran the program.  One rule for
000308r 1               ;       both consoles instead: run it, RTS comes home.  A program that never
000308r 1               ;       returns is unaffected; ESC still breaks out of one.
000308r 1               ;
000308r 1               ;   The IRQ handler (KeyIrq) pushes received bytes into the SER_RXBUF ring;
000308r 1               ;   the cooperative main loop runs the ring dry through SerDrain each pass and
000308r 1               ;   repaints the LCD once afterwards, so a pasted program is not overtaken by
000308r 1               ;   the panel it is updating.  RTS holds the far end off while the ring is
000308r 1               ;   full; see the RTS FLOW CONTROL section.
000308r 1               ;
000308r 1               ;   Faithfulness note: incoming bytes have bit 7 set before parsing, exactly as
000308r 1               ;   the Apple-1 keyboard delivered them, so Wozmon's original byte comparisons
000308r 1               ;   and hex-decode arithmetic work unmodified.  Output clears bit 7 (and maps
000308r 1               ;   CR -> CR/LF) on the way to the serial port.
000308r 1               ; =============================================================================
000308r 1               
000308r 1               ; -----------------------------------------------------------------------------
000308r 1               ;   SerInit — bring up the serial card and reset the Wozmon parser state
000308r 1               ;   Called from CartReset before interrupts are enabled.
000308r 1               ;
000308r 1               ;   The Serial Card is optional hardware, so the ACIA is only touched when the
000308r 1               ;   boot probe actually found one (HW_PRESENT bit HW_SC), matching the guarding
000308r 1               ;   convention the Kernal uses for every other card.  The parser state is reset
000308r 1               ;   either way, so the Ser* routines stay safe to call on a keypad-only build.
000308r 1               ;   Modifies: A
000308r 1               ; -----------------------------------------------------------------------------
000308r 1               SerInit:
000308r 1  AD 0D 03       lda HW_PRESENT
00030Br 1  29 10          and #HW_SC                    ; Serial Card fitted?  (it is optional hardware)
00030Dr 1  F0 03          beq @NoCard                   ; no — leave $9000 alone, run keypad-only
00030Fr 1  20 4E A0       jsr InitSC                    ; BIOS: 8-N-1, 19200 baud, RX IRQ enabled
000312r 1               @NoCard:
000312r 1  64 46          stz SER_RXHEAD                ; empty RX ring
000314r 1  64 47          stz SER_RXTAIL
000316r 1  64 50          stz SER_IDX                   ; empty line buffer
000318r 1  64 4F          stz WMODE                     ; XAM mode
00031Ar 1  64 51          stz SER_DIRTY
00031Cr 1  60             rts
00031Dr 1               
00031Dr 1               ; =============================================================================
00031Dr 1               ;   RTS FLOW CONTROL
00031Dr 1               ; =============================================================================
00031Dr 1               ;   ScRts, ScRtsLow and ScRxStore are the only places that write the ACIA
00031Dr 1               ;   command register after InitSC, so the whole scheme lives here.  It is the
00031Dr 1               ;   BIOS Kernal's scheme (6502-BIOS v2.0.1 and the reissued v1.6, Kernal.asm),
00031Dr 1               ;   not the naive one, and for the reasons the bench found on a real R6551 on
00031Dr 1               ;   2026-09-17:
00031Dr 1               ;
00031Dr 1               ;   RTS is the machine saying "stop sending".  The catch is that TIC 00 raises
00031Dr 1               ;   RTS *and turns the transmitter off*, so while RTS is up the machine cannot
00031Dr 1               ;   send a character either.  The BIOS deadlocked on that, because its Chrout
00031Dr 1               ;   blocks on a TDRE that can never come.  This monitor's SerPutc does not
00031Dr 1               ;   block — it waits a bounded time and drops the byte — so with RTS standing
00031Dr 1               ;   it was not hung but mute, and everything it said went in the bin.  Neither
00031Dr 1               ;   is acceptable.
00031Dr 1               ;
00031Dr 1               ;   So: RTS goes up only between transmits, and SerPutc puts it down around
00031Dr 1               ;   every byte it sends.  Each of those releases lets a byte or two in at
00031Dr 1               ;   19,200 baud, which is why the marks sit well below the 256-byte ring — up
00031Dr 1               ;   at SC_RTS_HIGH_WATER ($C0) with $40 still spare, down again below
00031Dr 1               ;   SC_RTS_LOW_WATER ($80).
00031Dr 1               ;
00031Dr 1               ;   And, because every send reopens the gate, opening it for an *echo* is how a
00031Dr 1               ;   flooded ring never recovers: a paste arrives at least as fast as the parser
00031Dr 1               ;   swallows it, so each echo's window lets another byte in.  Above the high
00031Dr 1               ;   mark this console therefore goes quiet instead (ScFlooded) and leaves RTS
00031Dr 1               ;   up, so the far end really stops and the ring drains.  The cost is echo
00031Dr 1               ;   nobody reads; the alternative is input the machine never gets.
00031Dr 1               ;
00031Dr 1               ;   ScRxStore calls ScRts after it stores a byte, SerGetChar after it takes
00031Dr 1               ;   one, and SerPutc at the end of each character.  There is no XModem here, so
00031Dr 1               ;   unlike the Kernal's there is nothing that owns the register in passing.
00031Dr 1               ; =============================================================================
00031Dr 1               
00031Dr 1               ; -----------------------------------------------------------------------------
00031Dr 1               ;   ScRts — put RTS where the amount of unread input says it belongs
00031Dr 1               ;   Raises it at SC_RTS_HIGH_WATER unread bytes, lowers it below
00031Dr 1               ;   SC_RTS_LOW_WATER, and between the two leaves the pin alone.
00031Dr 1               ;   Modifies: A, X
00031Dr 1               ; -----------------------------------------------------------------------------
00031Dr 1               ScRts:
00031Dr 1  A5 46          lda SER_RXHEAD                ; unread bytes
00031Fr 1  38             sec
000320r 1  E5 47          sbc SER_RXTAIL
000322r 1  A2 01          ldx #SC_CMD_RTS_HIGH
000324r 1  C9 C0          cmp #SC_RTS_HIGH_WATER
000326r 1  B0 09          bcs ScRtsWrite                ; full enough — stop the far end
000328r 1  A2 09          ldx #SC_CMD_RTS_LOW
00032Ar 1  C9 80          cmp #SC_RTS_LOW_WATER
00032Cr 1  90 03          bcc ScRtsWrite                ; drained — let it talk again
00032Er 1  60             rts                           ; between the marks — leave the pin as it is
00032Fr 1               
00032Fr 1               ; -----------------------------------------------------------------------------
00032Fr 1               ;   ScRtsLow — lower RTS, which is also what turns the transmitter back on
00032Fr 1               ;   Preserves: A.  Modifies: X
00032Fr 1               ; -----------------------------------------------------------------------------
00032Fr 1               ScRtsLow:
00032Fr 1  A2 09          ldx #SC_CMD_RTS_LOW
000331r 1                 ; Fall through
000331r 1               
000331r 1               ; -----------------------------------------------------------------------------
000331r 1               ;   ScRtsWrite — write X to the command register, if there is a card to write to
000331r 1               ;   Preserves: A
000331r 1               ; -----------------------------------------------------------------------------
000331r 1               ScRtsWrite:
000331r 1  48             pha
000332r 1  AD 0D 03       lda HW_PRESENT
000335r 1  29 10          and #HW_SC
000337r 1  F0 03          beq @Done                     ; no Serial Card — nothing to signal
000339r 1  8E 02 90       stx SC_CMD
00033Cr 1               @Done:
00033Cr 1  68             pla
00033Dr 1  60             rts
00033Er 1               
00033Er 1               ; -----------------------------------------------------------------------------
00033Er 1               ;   ScFlooded — is the ring too full to open the gate for a byte going out?
00033Er 1               ;   Out: C=1 -> drop the byte and leave RTS where it is
00033Er 1               ;   Preserves: A
00033Er 1               ; -----------------------------------------------------------------------------
00033Er 1               ScFlooded:
00033Er 1  48             pha
00033Fr 1  AD 0D 03       lda HW_PRESENT
000342r 1  29 10          and #HW_SC
000344r 1  F0 09          beq @Clear                    ; no Serial Card — nothing to hold back
000346r 1  A5 46          lda SER_RXHEAD
000348r 1  38             sec
000349r 1  E5 47          sbc SER_RXTAIL                ; unread bytes
00034Br 1  C9 C0          cmp #SC_RTS_HIGH_WATER
00034Dr 1  B0 01          bcs @Done                     ; at or above the mark — carry set, drop it
00034Fr 1               @Clear:
00034Fr 1  18             clc
000350r 1               @Done:
000350r 1  68             pla                           ; PLA touches N and Z only; the carry survives
000351r 1  60             rts
000352r 1               
000352r 1               ; -----------------------------------------------------------------------------
000352r 1               ;   ScRxStore — push A into the RX ring, then set RTS for what is in it
000352r 1               ;   Drops the byte rather than lapping the reader: one character lost instead
000352r 1               ;   of the 256 a wrapped write pointer would silently wipe.
000352r 1               ;   Modifies: A, X
000352r 1               ; -----------------------------------------------------------------------------
000352r 1               ScRxStore:
000352r 1  A6 46          ldx SER_RXHEAD
000354r 1  E8             inx
000355r 1  E4 47          cpx SER_RXTAIL                ; would this byte make the ring look empty?
000357r 1  F0 09          beq @Full                     ; full — drop it, never lap the reader
000359r 1  CA             dex
00035Ar 1  9D 00 04       sta SER_RXBUF,x
00035Dr 1  E6 46          inc SER_RXHEAD                ; byte index wraps naturally at 256
00035Fr 1  4C rr rr       jmp ScRts                     ; one more unread byte — RTS may go up
000362r 1               @Full:
000362r 1  60             rts
000363r 1               
000363r 1               ; -----------------------------------------------------------------------------
000363r 1               ;   ScRxPoll — read the status register, keeping any byte that came with it
000363r 1               ; -----------------------------------------------------------------------------
000363r 1               ;   Reading SC_STATUS clears a pending receive interrupt.  A byte that arrives
000363r 1               ;   while SerPutc is polling for TDRE would therefore lose its interrupt before
000363r 1               ;   KeyIrq could see it, and because the receive register stays full the ACIA
000363r 1               ;   would not hand over the next one either — the console would stop accepting
000363r 1               ;   input for good.  So the byte is collected here instead, exactly as the
000363r 1               ;   Kernal's ScRxPoll does.  Callers hold interrupts off, so the ring pointers
000363r 1               ;   are safe to touch.  A serial ESC still aborts to the monitor.
000363r 1               ;   Out: A = the status register
000363r 1               ;   Modifies: A, X
000363r 1               ; -----------------------------------------------------------------------------
000363r 1               ScRxPoll:
000363r 1  AD 01 90       lda SC_STATUS
000366r 1  89 08          bit #SC_STATUS_RDRF           ; did a byte arrive during the poll?
000368r 1  F0 0C          beq @Done
00036Ar 1  48             pha                           ; keep the status just read
00036Br 1  AD 00 90       lda SC_DATA                   ; frees the receive register
00036Er 1  C9 1B          cmp #CHAR_ESC
000370r 1  F0 05          beq @Esc                      ; break-to-monitor, from here as from KeyIrq
000372r 1  20 rr rr       jsr ScRxStore
000375r 1  68             pla                           ; back to the status
000376r 1               @Done:
000376r 1  60             rts
000377r 1               @Esc:
000377r 1  4C rr rr       jmp WarmStart                 ; abandons this frame, stack and all
00037Ar 1               
00037Ar 1               ; -----------------------------------------------------------------------------
00037Ar 1               ;   SerDrain — run the RX ring dry through the Wozmon parser
00037Ar 1               ;   Feeds every buffered byte, whole lines included, and returns when the ring
00037Ar 1               ;   is empty.  MonitorLoop repaints the LCD once afterwards; see the note there
00037Ar 1               ;   for why that is the point of this routine.
00037Ar 1               ;   Modifies: A, X, Y
00037Ar 1               ; -----------------------------------------------------------------------------
00037Ar 1               SerDrain:
00037Ar 1  20 rr rr       jsr SerGetChar
00037Dr 1  90 05          bcc @Done
00037Fr 1  20 rr rr       jsr SerFeed                   ; may run a whole line on CR
000382r 1  80 F6          bra SerDrain
000384r 1               @Done:
000384r 1  60             rts
000385r 1               
000385r 1               ; -----------------------------------------------------------------------------
000385r 1               ;   SerGetChar — pull one byte from the RX ring (filled by KeyIrq)
000385r 1               ;   Out: C=1 -> A = byte with bit 7 set (Apple-1 style); C=0 -> ring empty
000385r 1               ;   Modifies: A, X
000385r 1               ; -----------------------------------------------------------------------------
000385r 1               SerGetChar:
000385r 1  A5 47          lda SER_RXTAIL
000387r 1  C5 46          cmp SER_RXHEAD
000389r 1  F0 0F          beq @Empty                    ; tail == head -> nothing buffered
00038Br 1  AA             tax
00038Cr 1  BD 00 04       lda SER_RXBUF,x               ; fetch the oldest byte
00038Fr 1  E6 47          inc SER_RXTAIL                ; advance (wraps at 256)
000391r 1  09 80          ora #$80                      ; set bit 7 for the Wozmon parser
000393r 1  48             pha
000394r 1  20 rr rr       jsr ScRts                     ; one fewer unread byte — RTS may come down
000397r 1  68             pla
000398r 1  38             sec
000399r 1  60             rts
00039Ar 1               @Empty:
00039Ar 1  18             clc
00039Br 1  60             rts
00039Cr 1               
00039Cr 1               ; -----------------------------------------------------------------------------
00039Cr 1               ;   SerFeed — accumulate one received byte into the line buffer
00039Cr 1               ;   In: A = byte (bit 7 set).  Handles backspace / CR like Wozmon's character
00039Cr 1               ;   loop; a CR runs the line through SerProcess.  ESC is NOT handled here — it
00039Cr 1               ;   is consumed in the ISR (KeyIrq) as a break-to-monitor abort, so it never
00039Cr 1               ;   reaches the RX ring or this parser.
00039Cr 1               ;   Modifies: A, X, Y
00039Cr 1               ; -----------------------------------------------------------------------------
00039Cr 1               SerFeed:
00039Cr 1  C9 DF          cmp #$DF                      ; "_" backspace (Apple-1)?
00039Er 1  F0 25          beq @Bs
0003A0r 1  C9 88          cmp #$88                      ; BS ($08|$80)?
0003A2r 1  F0 21          beq @Bs
0003A4r 1  C9 FF          cmp #$FF                      ; DEL ($7F|$80)?
0003A6r 1  F0 1D          beq @Bs
0003A8r 1  A4 50          ldy SER_IDX
0003AAr 1  99 00 02       sta SER_LINEBUF,y             ; store into the line buffer
0003ADr 1  C9 8D          cmp #$8D                      ; CR ($0D|$80)?  (test before echo clobbers A)
0003AFr 1  F0 0B          beq @Cr
0003B1r 1  20 rr rr       jsr SerEcho                   ; echo the typed character
0003B4r 1  C8             iny
0003B5r 1  10 02          bpl @Store                    ; line < 128 chars — keep going
0003B7r 1  80 09          bra @Cancel                   ; over-long line: discard it, fresh prompt
0003B9r 1               @Store:
0003B9r 1  84 50          sty SER_IDX
0003BBr 1  60             rts
0003BCr 1               @Cr:
0003BCr 1  20 rr rr       jsr SerEcho                   ; echo CR -> CR/LF
0003BFr 1  4C rr rr       jmp SerProcess                ; parse and act on the completed line
0003C2r 1               @Cancel:
0003C2r 1  4C rr rr       jmp SerPrompt                 ; discard the line, fresh prompt
0003C5r 1               @Bs:
0003C5r 1  A4 50          ldy SER_IDX
0003C7r 1  F0 12          beq @BsDone                   ; already at the start — nothing to erase
0003C9r 1  88             dey
0003CAr 1  84 50          sty SER_IDX
0003CCr 1  A9 88          lda #$88                      ; visually erase on the terminal: BS, space, BS
0003CEr 1  20 rr rr       jsr SerEcho
0003D1r 1  A9 A0          lda #$A0                      ; space
0003D3r 1  20 rr rr       jsr SerEcho
0003D6r 1  A9 88          lda #$88
0003D8r 1  20 rr rr       jsr SerEcho
0003DBr 1               @BsDone:
0003DBr 1  60             rts
0003DCr 1               
0003DCr 1               ; -----------------------------------------------------------------------------
0003DCr 1               ;   SerProcess — parse and execute a completed Wozmon line
0003DCr 1               ; -----------------------------------------------------------------------------
0003DCr 1               ;   Port of the Apple-1 Wozmon line interpreter.  The line lives in
0003DCr 1               ;   SER_LINEBUF, terminated by the CR ($8D) at SER_IDX.  Examine / block
0003DCr 1               ;   examine / deposit follow the original semantics exactly; run is a
0003DCr 1               ;   subroutine call rather than Wozmon's jump (see the section header).
0003DCr 1               ;   Modifies: A, X, Y
0003DCr 1               ; -----------------------------------------------------------------------------
0003DCr 1               SerProcess:
0003DCr 1  A0 FF          ldy #$ff                      ; reset the text index (INY -> 0 below)
0003DEr 1  A9 00          lda #$00                      ; default XAM mode
0003E0r 1  AA             tax                           ; 0 -> X
0003E1r 1               @SetStor:
0003E1r 1  0A             asl a                         ; ":" arrives as $BA -> $74 (STOR); XAM stays 0
0003E2r 1               @SetMode:
0003E2r 1  85 4F          sta WMODE                     ; $00=XAM, $74=STOR, $AE=BLOCK XAM
0003E4r 1               @BlSkip:
0003E4r 1  C8             iny                           ; advance the text index
0003E5r 1               @NextItem:
0003E5r 1  B9 00 02       lda SER_LINEBUF,y             ; next character
0003E8r 1  C9 8D          cmp #$8D                      ; CR -> end of line
0003EAr 1  D0 03          bne @ChkDot
0003ECr 1  4C rr rr       jmp SerPrompt                 ; line consumed — emit the next prompt
0003EFr 1               @ChkDot:
0003EFr 1  C9 AE          cmp #$AE                      ; "."?
0003F1r 1  90 F1          bcc @BlSkip                   ; below "." -> delimiter, skip it
0003F3r 1  F0 ED          beq @SetMode                  ; "." -> BLOCK XAM mode (A=$AE)
0003F5r 1  C9 BA          cmp #$BA                      ; ":"?
0003F7r 1  F0 E8          beq @SetStor                  ; ":" -> STOR mode (A=$BA)
0003F9r 1  C9 D2          cmp #$D2                      ; "R"?
0003FBr 1  F0 3F          beq @Run                      ; run user program
0003FDr 1  86 4C          stx L                         ; clear the hex accumulator
0003FFr 1  86 4D          stx H
000401r 1  84 4E          sty YSAV                      ; remember where the number started
000403r 1               @NextHex:
000403r 1  B9 00 02       lda SER_LINEBUF,y             ; get a character for the hex test
000406r 1  49 B0          eor #$B0                      ; map "0".."9" to $0-$9
000408r 1  C9 0A          cmp #$0A                      ; decimal digit?
00040Ar 1  90 06          bcc @Dig
00040Cr 1  69 88          adc #$88                      ; map "A".."F" to $FA-$FF
00040Er 1  C9 FA          cmp #$FA                      ; valid hex letter?
000410r 1  90 11          bcc @NotHex                   ; no — not a hex character
000412r 1               @Dig:
000412r 1  0A             asl a
000413r 1  0A             asl a                         ; hex digit to the MSD of A
000414r 1  0A             asl a
000415r 1  0A             asl a
000416r 1  A2 04          ldx #$04                      ; shift count
000418r 1               @HexShift:
000418r 1  0A             asl a                         ; hex digit left, MSB into carry
000419r 1  26 4C          rol L                         ; rotate into the accumulator
00041Br 1  26 4D          rol H
00041Dr 1  CA             dex
00041Er 1  D0 F8          bne @HexShift
000420r 1  C8             iny                           ; advance the text index
000421r 1  D0 E0          bne @NextHex                  ; always taken (Y < 256)
000423r 1               @NotHex:
000423r 1  C4 4E          cpy YSAV                      ; were any hex digits given?
000425r 1  F0 1B          beq @Escape                   ; none -> treat as ESC
000427r 1  24 4F          bit WMODE                     ; B6=1 STOR, B6=0 XAM/BLOCK
000429r 1  50 1A          bvc @NotStor
00042Br 1  A5 4C          lda L                         ; deposit: store the low byte
00042Dr 1  81 4A          sta (STL,x)                   ; X=0 -> via STH:STL
00042Fr 1  E6 4A          inc STL                       ; auto-increment the deposit address
000431r 1  D0 02          bne @Deposited
000433r 1  E6 4B          inc STH
000435r 1               @Deposited:
000435r 1  A9 01          lda #$01
000437r 1  85 51          sta SER_DIRTY                 ; memory changed — flag an LCD refresh
000439r 1  4C rr rr       jmp @NextItem
00043Cr 1               @Run:
00043Cr 1  20 rr rr       jsr SerCallUser               ; run at the last examined address
00043Fr 1  4C rr rr       jmp SerPrompt                 ; a user RTS lands here — fresh prompt
000442r 1               @Escape:
000442r 1  4C rr rr       jmp SerPrompt                 ; nothing parsed — fresh prompt
000445r 1               @NotStor:
000445r 1  30 2B          bmi @XamNext                  ; B7=1 -> BLOCK XAM continuation
000447r 1  A2 02          ldx #$02                      ; copy the hex value to the store + examine
000449r 1               @SetAdr:
000449r 1  B5 4B          lda L-1,x                     ;   indices (two bytes)
00044Br 1  95 49          sta STL-1,x
00044Dr 1  95 47          sta XAML-1,x
00044Fr 1  CA             dex
000450r 1  D0 F7          bne @SetAdr                   ; X reaches 0 with Z=1 (prints the address)
000452r 1               @NxtPrnt:
000452r 1  D0 14          bne @PrData                   ; NE -> mid-row, no new address label
000454r 1  A9 8D          lda #$8D                      ; CR
000456r 1  20 rr rr       jsr SerEcho
000459r 1  A5 49          lda XAMH                      ; print the examine address
00045Br 1  20 rr rr       jsr PrByte
00045Er 1  A5 48          lda XAML
000460r 1  20 rr rr       jsr PrByte
000463r 1  A9 BA          lda #$BA                      ; ":"
000465r 1  20 rr rr       jsr SerEcho
000468r 1               @PrData:
000468r 1  A9 A0          lda #$A0                      ; space
00046Ar 1  20 rr rr       jsr SerEcho
00046Dr 1  A1 48          lda (XAML,x)                  ; print the data byte (X=0)
00046Fr 1  20 rr rr       jsr PrByte
000472r 1               @XamNext:
000472r 1  86 4F          stx WMODE                     ; X=0 -> back to XAM mode
000474r 1  A5 48          lda XAML                      ; more bytes to print in the range?
000476r 1  C5 4C          cmp L
000478r 1  A5 49          lda XAMH
00047Ar 1  E5 4D          sbc H
00047Cr 1  B0 0C          bcs @ToNextItem               ; not less -> done with this range
00047Er 1  E6 48          inc XAML                      ; advance the examine index
000480r 1  D0 02          bne @Mod8
000482r 1  E6 49          inc XAMH
000484r 1               @Mod8:
000484r 1  A5 48          lda XAML                      ; start a new row every 8 bytes
000486r 1  29 07          and #$07
000488r 1  10 C8          bpl @NxtPrnt                  ; always taken (result is 0-7); Z drives the
00048Ar 1               @ToNextItem:                    ;   address-label decision in @NxtPrnt
00048Ar 1  4C rr rr       jmp @NextItem
00048Dr 1               
00048Dr 1               ; -----------------------------------------------------------------------------
00048Dr 1               ;   SerCallUser — call the user program at XAML
00048Dr 1               ;   The 6502 has no "jsr (addr)", so the call is a jsr to this jmp — the same
00048Dr 1               ;   trampoline the keypad's UP key uses (DoUp -> CallUser), one address apiece.
00048Dr 1               ;   Modifies: everything the user program modifies
00048Dr 1               ; -----------------------------------------------------------------------------
00048Dr 1               SerCallUser:
00048Dr 1  6C 48 00       jmp (XAML)
000490r 1               
000490r 1               ; -----------------------------------------------------------------------------
000490r 1               ;   SerPrompt — emit a CR/LF and the "> " prompt, reset the line buffer
000490r 1               ;   Modifies: A
000490r 1               ; -----------------------------------------------------------------------------
000490r 1               SerPrompt:
000490r 1  A9 0D          lda #CHAR_CR
000492r 1  20 rr rr       jsr SerEcho                   ; CR -> CR/LF
000495r 1  A9 3E          lda #'>'
000497r 1  20 rr rr       jsr SerPutc
00049Ar 1  A9 20          lda #CHAR_SPACE
00049Cr 1  20 rr rr       jsr SerPutc
00049Fr 1  64 50          stz SER_IDX                   ; start a fresh line
0004A1r 1  60             rts
0004A2r 1               
0004A2r 1               ; -----------------------------------------------------------------------------
0004A2r 1               ;   PrByte / PrHex — print A as two hex digits over serial (Wozmon PRBYTE)
0004A2r 1               ;   In: A = byte.  PrHex falls through into SerEcho.
0004A2r 1               ;   Modifies: A
0004A2r 1               ; -----------------------------------------------------------------------------
0004A2r 1               PrByte:
0004A2r 1  48             pha
0004A3r 1  4A             lsr a
0004A4r 1  4A             lsr a
0004A5r 1  4A             lsr a                         ; high nibble to the low nibble position
0004A6r 1  4A             lsr a
0004A7r 1  20 rr rr       jsr PrHex
0004AAr 1  68             pla
0004ABr 1               PrHex:
0004ABr 1  29 0F          and #$0F                      ; mask the low nibble
0004ADr 1  09 B0          ora #$B0                      ; "0".."9"
0004AFr 1  C9 BA          cmp #$BA
0004B1r 1  90 02          bcc SerEcho                   ; a digit — send it
0004B3r 1  69 06          adc #$06                      ; letter offset: "A".."F"
0004B5r 1                 ; fall through to SerEcho
0004B5r 1               
0004B5r 1               ; -----------------------------------------------------------------------------
0004B5r 1               ;   SerEcho — send one character to the serial port
0004B5r 1               ;   In: A = character (bit 7 may be set).  Clears bit 7 and maps CR -> CR/LF.
0004B5r 1               ;   Preserves X and Y (the line parser holds state in them across echoes).
0004B5r 1               ;   Modifies: A
0004B5r 1               ; -----------------------------------------------------------------------------
0004B5r 1               SerEcho:
0004B5r 1  DA             phx
0004B6r 1  5A             phy
0004B7r 1  29 7F          and #$7F                      ; back to plain ASCII
0004B9r 1  C9 0D          cmp #CHAR_CR                  ; CR?
0004BBr 1  D0 0C          bne @One
0004BDr 1  A9 0D          lda #CHAR_CR
0004BFr 1  20 rr rr       jsr SerPutc
0004C2r 1  A9 0A          lda #CHAR_LF                  ; CR -> CR + LF
0004C4r 1  20 rr rr       jsr SerPutc
0004C7r 1  80 03          bra @Done
0004C9r 1               @One:
0004C9r 1  20 rr rr       jsr SerPutc
0004CCr 1               @Done:
0004CCr 1  7A             ply
0004CDr 1  FA             plx
0004CEr 1  60             rts
0004CFr 1               
0004CFr 1               ; -----------------------------------------------------------------------------
0004CFr 1               ;   SerPutc — send one byte to the serial port, NON-BLOCKING
0004CFr 1               ; -----------------------------------------------------------------------------
0004CFr 1               ;   In: A = byte (sent as-is).  Preserves X and Y.
0004CFr 1               ;   Unlike the BIOS SerialChrout (which blocks until TDRE — and therefore
0004CFr 1               ;   hangs forever when the R65C51's /CTS is not asserted by a connected
0004CFr 1               ;   terminal), this waits for TX-ready only for a bounded time and then drops
0004CFr 1               ;   the byte.  That keeps the keypad monitor fully alive whether or not a host
0004CFr 1               ;   terminal is attached.  When a terminal IS connected it exits as soon as
0004CFr 1               ;   TDRE sets, so back-to-back bytes are not dropped.
0004CFr 1               ;
0004CFr 1               ;   TIC 00 turns the transmitter off as well as raising RTS, so a byte written
0004CFr 1               ;   while this monitor is holding RTS up would never leave and the bounded wait
0004CFr 1               ;   would simply run out: with RTS standing the console is not hung, it is
0004CFr 1               ;   mute.  So RTS comes down for the byte and goes back where the ring says
0004CFr 1               ;   afterwards, with interrupts held off meanwhile so KeyIrq cannot raise it
0004CFr 1               ;   mid-character.  Above the high-water mark the byte is dropped INSTEAD of
0004CFr 1               ;   opening the gate, because a paste arrives faster than the parser drains it
0004CFr 1               ;   and every echo's window would keep the ring flooded for good.
0004CFr 1               ;
0004CFr 1               ;   It also means this is the routine that puts the command register right if
0004CFr 1               ;   something else has left it wrong — a user program, or a deposit to $9002.
0004CFr 1               ;   The next character out undoes it.
0004CFr 1               ;   Modifies: A
0004CFr 1               ; -----------------------------------------------------------------------------
0004CFr 1               SerPutc:
0004CFr 1  DA             phx                           ; X and Y are the line parser's, not ours
0004D0r 1  5A             phy
0004D1r 1  08             php                           ; the caller's I flag, put back on every exit
0004D2r 1  48             pha                           ; the byte — @Send wants it back
0004D3r 1  AD 0D 03       lda HW_PRESENT
0004D6r 1  29 10          and #HW_SC                    ; Serial Card fitted?
0004D8r 1  F0 26          beq @Drop                     ; no — drop the byte without touching $9000
0004DAr 1                                               ;   (and without paying the TDRE timeout)
0004DAr 1  78             sei                           ; KeyIrq must not move RTS mid-character
0004DBr 1  20 rr rr       jsr ScFlooded                 ; ring too full to open the gate for this byte?
0004DEr 1  B0 20          bcs @Drop                     ; yes — stay quiet, and leave RTS up
0004E0r 1  20 rr rr       jsr ScRtsLow                  ; the transmitter only runs with RTS down
0004E3r 1  A2 03          ldx #$03                      ; bounded TDRE wait, ~27 ms @ 1 MHz — about the
0004E5r 1                                               ;   wall time the old $08 x 256 loop took, now
0004E5r 1                                               ;   that each pass carries an ScRxPoll
0004E5r 1               @WaitHi:
0004E5r 1  A0 00          ldy #$00
0004E7r 1               @WaitLo:
0004E7r 1  DA             phx                           ; ScRxPoll uses X; the countdown lives in it
0004E8r 1  20 rr rr       jsr ScRxPoll                  ; status — and any byte that arrived with it
0004EBr 1  FA             plx
0004ECr 1  29 10          and #SC_STATUS_TDRE           ; TX data register empty?
0004EEr 1  D0 08          bne @Send
0004F0r 1  88             dey
0004F1r 1  D0 F4          bne @WaitLo
0004F3r 1  CA             dex
0004F4r 1  D0 EF          bne @WaitHi
0004F6r 1  80 05          bra @Rts                      ; timeout — no terminal; drop the byte
0004F8r 1               @Send:
0004F8r 1  68             pla                           ; recover the byte
0004F9r 1  8D 00 90       sta SC_DATA                   ; transmit it
0004FCr 1  48             pha
0004FDr 1               @Rts:
0004FDr 1  20 rr rr       jsr ScRts                     ; byte gone — RTS back where the ring says
000500r 1               @Drop:
000500r 1  68             pla                           ; the byte, as the caller passed it
000501r 1  28             plp                           ; interrupts as the caller had them
000502r 1  7A             ply
000503r 1  FA             plx
000504r 1  60             rts
000505r 1               
000505r 1               ; -----------------------------------------------------------------------------
000505r 1               ;   SerPrintStr — send a null-terminated string over serial
000505r 1               ;   In: STR_PTR ($02-$03) = pointer to the string
000505r 1               ;   Modifies: A, Y
000505r 1               ; -----------------------------------------------------------------------------
000505r 1               SerPrintStr:
000505r 1  A0 00          ldy #$00
000507r 1               @Loop:
000507r 1  B1 02          lda (STR_PTR),y
000509r 1  F0 06          beq @Done                     ; null terminator
00050Br 1  20 rr rr       jsr SerEcho                   ; SerEcho preserves Y
00050Er 1  C8             iny
00050Fr 1  D0 F6          bne @Loop
000511r 1               @Done:
000511r 1  60             rts
000512r 1               
000512r 1               
000512r 1               ; =============================================================================
000512r 1               ;   INTERRUPT HANDLERS & VECTOR TRAMPOLINES
000512r 1               ; =============================================================================
000512r 1               ;   The cartridge owns the hardware vectors at $FFFA-$FFFF.  Following the
000512r 1               ;   BIOS convention, the NMI and IRQ vectors trampoline through the writable
000512r 1               ;   RAM vectors (NMI_PTR / IRQ_PTR) that KernalInit installs.  CartReset then
000512r 1               ;   repoints IRQ_PTR at the local KeyIrq handler so the keypad CA1 edge drives
000512r 1               ;   key input (see the keypad driver section); NMI_PTR keeps the Kernal
000512r 1               ;   default (RTI).
000512r 1               ;
000512r 1               ;   BRK shares the IRQ vector.  KeyIrq detects the B flag and dispatches via
000512r 1               ;   BRK_PTR (-> BrkHandler) with P/PCL/PCH still on the stack, so BrkHandler
000512r 1               ;   only needs to RTI to resume the interrupted code.
000512r 1               ; -----------------------------------------------------------------------------
000512r 1               
000512r 1               ; -----------------------------------------------------------------------------
000512r 1               ;   NmiVector / IrqVector — hardware-vector trampolines through the RAM vectors
000512r 1               ; -----------------------------------------------------------------------------
000512r 1               NmiVector:
000512r 1  6C 04 03       jmp (NMI_PTR)                  ; default: Kernal Nmi (RTI)
000515r 1               
000515r 1               IrqVector:
000515r 1  6C 00 03       jmp (IRQ_PTR)                  ; CartReset points IRQ_PTR at KeyIrq
000518r 1               
000518r 1               ; -----------------------------------------------------------------------------
000518r 1               ;   BrkHandler — local BRK handler
000518r 1               ; -----------------------------------------------------------------------------
000518r 1               ;   Reached via JMP (BRK_PTR) from KeyIrq after a BRK.  A/X are already
000518r 1               ;   restored and the P/PCL/PCH frame is intact, so resuming is a plain RTI.
000518r 1               ;   This keeps a stray BRK in executed user code from entering the overlaid
000518r 1               ;   BIOS monitor.
000518r 1               ; -----------------------------------------------------------------------------
000518r 1               BrkHandler:
000518r 1  40             rti
000519r 1               
000519r 1               
000519r 1               ; =============================================================================
000519r 1               ;   Data
000519r 1               ; =============================================================================
000519r 1               
000519r 1               SplashL1:
000519r 1  4B 49 4D 20    .byte "KIM MONITOR v1.0", $00
00051Dr 1  4D 4F 4E 49  
000521r 1  54 4F 52 20  
00052Ar 1               SplashL2:
00052Ar 1  2D 2D 45 53    .byte "--ESC TO START--", $00
00052Er 1  43 20 54 4F  
000532r 1  20 53 54 41  
00053Br 1               
00053Br 1               ; -----------------------------------------------------------------------------
00053Br 1               ;   KeySymTable — keycode (0-23) -> printable LCD symbol
00053Br 1               ; -----------------------------------------------------------------------------
00053Br 1               ;   Hex digit keys map to their hex character; navigation/command keys map to
00053Br 1               ;   a distinct printable glyph for the keypad echo test.
00053Br 1               ;     $00 LEFT  $0B RIGHT  $10 ESC  $11 INS  $12 PGUP  $14 UP  $15 DEL  $16 PGDN
00053Br 1               ; -----------------------------------------------------------------------------
00053Br 1               KeySymTable:
00053Br 1  3C             .byte '<'                     ; $00 LEFT
00053Cr 1  31             .byte '1'                     ; $01
00053Dr 1  32             .byte '2'                     ; $02
00053Er 1  33             .byte '3'                     ; $03
00053Fr 1  34             .byte '4'                     ; $04
000540r 1  35             .byte '5'                     ; $05
000541r 1  36             .byte '6'                     ; $06
000542r 1  37             .byte '7'                     ; $07
000543r 1  38             .byte '8'                     ; $08
000544r 1  39             .byte '9'                     ; $09
000545r 1  30             .byte '0'                     ; $0A
000546r 1  3E             .byte '>'                     ; $0B RIGHT
000547r 1  46             .byte 'F'                     ; $0C
000548r 1  45             .byte 'E'                     ; $0D
000549r 1  44             .byte 'D'                     ; $0E
00054Ar 1  43             .byte 'C'                     ; $0F
00054Br 1  2A             .byte '*'                     ; $10 ESC
00054Cr 1  49             .byte 'I'                     ; $11 INS
00054Dr 1  55             .byte 'U'                     ; $12 PGUP
00054Er 1  41             .byte 'A'                     ; $13
00054Fr 1  5E             .byte '^'                     ; $14 UP
000550r 1  58             .byte 'X'                     ; $15 DEL
000551r 1  4E             .byte 'N'                     ; $16 PGDN
000552r 1  42             .byte 'B'                     ; $17
000553r 1               
000553r 1               
000553r 1               ; -----------------------------------------------------------------------------
000553r 1               ;   HexValTable — keycode (0-23) -> hex nibble value, $FF = not a hex digit
000553r 1               ; -----------------------------------------------------------------------------
000553r 1               ;   Used by KeyToHex.  Maps the ten digit keys (0-9) and the six letter keys
000553r 1               ;   (A-F) to their 0-15 nibble value; every navigation/command key maps to the
000553r 1               ;   $FF sentinel so the dispatch loop ignores it during address/data entry.
000553r 1               ; -----------------------------------------------------------------------------
000553r 1               HexValTable:
000553r 1  FF             .byte $FF                     ; $00 LEFT
000554r 1  01             .byte $01                     ; $01 1
000555r 1  02             .byte $02                     ; $02 2
000556r 1  03             .byte $03                     ; $03 3
000557r 1  04             .byte $04                     ; $04 4
000558r 1  05             .byte $05                     ; $05 5
000559r 1  06             .byte $06                     ; $06 6
00055Ar 1  07             .byte $07                     ; $07 7
00055Br 1  08             .byte $08                     ; $08 8
00055Cr 1  09             .byte $09                     ; $09 9
00055Dr 1  00             .byte $00                     ; $0A 0
00055Er 1  FF             .byte $FF                     ; $0B RIGHT
00055Fr 1  0F             .byte $0F                     ; $0C F
000560r 1  0E             .byte $0E                     ; $0D E
000561r 1  0D             .byte $0D                     ; $0E D
000562r 1  0C             .byte $0C                     ; $0F C
000563r 1  FF             .byte $FF                     ; $10 ESC
000564r 1  FF             .byte $FF                     ; $11 INS
000565r 1  FF             .byte $FF                     ; $12 PGUP
000566r 1  0A             .byte $0A                     ; $13 A
000567r 1  FF             .byte $FF                     ; $14 UP
000568r 1  FF             .byte $FF                     ; $15 DEL
000569r 1  FF             .byte $FF                     ; $16 PGDN
00056Ar 1  0B             .byte $0B                     ; $17 B
00056Br 1               
00056Br 1               
00056Br 1               ; =============================================================================
00056Br 1               ;   CPU Vectors — cart owns $FFFA-$FFFF
00056Br 1               ; =============================================================================
00056Br 1               ;   NMI and IRQ trampoline through the Kernal RAM vectors (see above);
00056Br 1               ;   RESET enters the cartridge.
00056Br 1               
00056Br 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiVector                ; NMI vector   -> jmp (NMI_PTR)
000002r 1  rr rr        .word   CartReset                ; RESET vector — cartridge entry point
000004r 1  rr rr        .word   IrqVector                ; IRQ vector   -> jmp (IRQ_PTR)
000004r 1               
